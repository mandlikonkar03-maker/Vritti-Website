# Where "Request a Free Demo" submissions are emailed (comma-separate several).
DEMO_REQUEST_TO=sales@example.com

# SMTP account used to send the email (Gmail app password, Zoho, Outlook, SES, etc.)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=you@example.com
SMTP_PASS=app-password-here
# Optional: the "From" shown on the email. Defaults to SMTP_USER.
SMTP_FROM="Vritti Website <you@example.com>"

# Optional: also save every request as a line in this file (works on a normal
# Node server, not on serverless hosts). Leave empty to disable.
DEMO_REQUEST_LOG=./data/demo-requests.jsonl
