---
interface Props { items: { label: string; href?: string }[] }
const { items } = Astro.props;
---
<nav aria-label="Breadcrumb" class="breadcrumbs">
  <ol>
    {items.map((item, i) => (
      <li>
        {item.href && i < items.length - 1
          ? <a href={item.href}>{item.label}</a>
          : <span aria-current="page">{item.label}</span>}
      </li>
    ))}
  </ol>
</nav>

<style>
  .breadcrumbs ol {
    display: flex; flex-wrap: wrap; list-style: none; margin: 0; padding: 0;
    font-size: 12px; font-weight: 500; text-transform: uppercase; letter-spacing: 0.04em;
  }
  .breadcrumbs li + li::before { content: '/'; margin: 0 8px; color: var(--muted); }
  .breadcrumbs a { color: var(--blue); }
  .breadcrumbs span { color: var(--navy); }
</style>
