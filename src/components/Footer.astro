---
import { mainNav, site } from '../data/site';

interface Props {
  extraLinks?: { label: string; href: string }[];
  tagline?: string;
}
const { extraLinks = [], tagline } = Astro.props;
const links = [...extraLinks, ...mainNav];
---
<footer class="site-footer">
  <div class="container">
    <a href="/" class="footer-logo" aria-label={`${site.name} home`}>
      <img src="/images/vritti-logo.png" alt={site.name} width="113" height="47" />
    </a>
    {tagline && <p class="footer-tagline">{tagline}</p>}
    <nav aria-label="Footer">
      <ul class="footer-nav">
        {links.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
      </ul>
    </nav>
    <p class="copyright">© {site.company} All rights reserved.</p>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--footer);
    color: #c9d4de;
    padding: 30px 0 34px;
  }
  .footer-logo {
    display: inline-flex;
    background: #fff;
    border-radius: 8px;
    padding: 8px 14px;
  }
  .footer-logo img { width: 86px; height: auto; display: block; }
  .footer-tagline { margin: 16px 0 0; font-size: 13px; }
  .footer-nav {
    display: flex;
    flex-wrap: wrap;
    gap: 10px 20px;
    list-style: none;
    padding: 0;
    margin: 20px 0 0;
    padding-bottom: 22px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.14);
  }
  .footer-nav a {
    color: #fff;
    text-decoration: none;
    text-transform: uppercase;
    font-size: 12.5px;
    font-weight: 500;
    letter-spacing: 0.02em;
  }
  .footer-nav a:hover { color: var(--orange); }
  .copyright { margin: 20px 0 0; font-size: 12px; color: #9fb0bf; }
</style>
