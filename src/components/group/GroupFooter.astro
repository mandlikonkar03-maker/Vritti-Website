---
import { brandVideo, groupFooter as f } from '../../data/home';
import { site } from '../../data/site';
const year = new Date().getFullYear();

interface Props {
  // Set to false to leave out the black team-photo strip above the footer.
  showStrip?: boolean;
}
const { showStrip = true } = Astro.props;
---
{showStrip && <section class="g-video" aria-label={brandVideo.title}>
  {brandVideo.src ? (
    <video
      class="g-video-media"
      src={brandVideo.src}
      poster={brandVideo.poster || undefined}
      autoplay
      muted
      loop
      playsinline
      preload="metadata"
      aria-label={brandVideo.title}
    ></video>
  ) : (
    <div class="g-video-empty">Video coming soon</div>
  )}
</section>}

<footer class={showStrip ? 'g-footer' : 'g-footer g-footer--no-strip'}>
  <svg class="g-curve" viewBox="0 0 1680 184" preserveAspectRatio="none" aria-hidden="true">
    <path d="M0 0H1680C1250 0 1000 45 840 184C680 45 430 0 0 0Z" fill="#000" />
  </svg>
  <img class="g-swirl" src="/images/home/swirl.png" alt="" width="88" height="80" />

  <div class="g-container">
    <div class="g-footer-cols">
      <div class="g-fgroup g-fgroup--left">
        <div class="g-fstack">
          {f.left.map((col) => (
            <div class="g-fcol">
              <a class="g-fhead" href={col.href}>{col.title}</a>
              <ul>{col.links.map((l) => <li><a href={l.href}>{l.label}</a></li>)}</ul>
            </div>
          ))}
        </div>
        <ul class="g-fmain">{f.leftMain.map((l) => <li><a href={l.href}>{l.label}</a></li>)}</ul>
      </div>

      <div class="g-fgroup g-fgroup--right">
        <ul class="g-fmain">{f.rightMain.map((l) => <li><a href={l.href}>{l.label}</a></li>)}</ul>
        <div class="g-fcol">
          <p class="g-fhead g-fhead--quick">Quick Links</p>
          {f.quickLinks.map((group) => (
            <ul>{group.map((l) => <li><a href={l.href}>{l.label}</a></li>)}</ul>
          ))}
        </div>
      </div>
    </div>

    <div class="g-fbottom">
      <p>© {year} {site.company}</p>
      <ul>{f.legal.map((l) => <li><a href={l.href}>{l.label}</a></li>)}</ul>
    </div>
  </div>
</footer>

<script>
  // Respect reduced-motion: keep the strip video still.
  const v = document.querySelector<HTMLVideoElement>('.g-video-media');
  if (v && window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    v.removeAttribute('autoplay');
    v.pause();
  }
</script>

<style>
  .g-video {
    background: #000;
    margin-top: 24px;
    padding-top: clamp(12px, 2vw, 36px);
    overflow: hidden;
  }
  .g-video-media,
  .g-video-empty {
    display: block;
    width: 100%;
    height: max(150px, 21.875vw); /* the video is 1920 x 420 */
    max-height: 420px;
    object-fit: cover;
    background: #000;
  }
  .g-video-empty {
    display: grid;
    place-items: center;
    color: rgba(255, 255, 255, 0.5);
    font-size: 14px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .g-footer {
    position: relative;
    background: #fff;
    color: var(--g-ink);
    padding-top: clamp(40px, 5vw, 84px);
  }
  .g-footer--no-strip { margin-top: clamp(24px, 4vw, 64px); }
  .g-curve {
    position: absolute;
    top: -1px;
    left: 0;
    width: 100%;
    height: calc(10.95vw + 1px);
    display: block;
  }
  .g-swirl {
    position: absolute;
    top: 0.6vw;
    left: 50%;
    transform: translateX(-50%);
    width: clamp(36px, 5.3vw, 88px);
    height: auto;
  }
  .g-footer-cols {
    position: relative;
    display: flex;
    justify-content: space-between;
    gap: 40px;
  }
  .g-fgroup { display: flex; gap: clamp(28px, 4vw, 70px); }
  .g-fstack { display: flex; flex-direction: column; gap: 30px; }
  .g-footer ul { list-style: none; margin: 0; padding: 0; }
  .g-footer a { color: inherit; text-decoration: none; }
  .g-footer a:hover { color: var(--g-blue); }
  .g-fhead {
    display: block;
    margin: 0 0 8px;
    font-size: 22px;
    font-weight: 700;
    text-transform: uppercase;
  }
  .g-fhead--quick { text-transform: none; }
  .g-fcol li { font-size: 17px; line-height: 1.6; }
  .g-fcol ul + ul { margin-top: 14px; }
  .g-fmain {
    display: flex;
    flex-direction: column;
    gap: 14px;
    margin-top: 128px !important;
  }
  .g-fgroup--right .g-fmain { margin-top: 116px !important; }
  .g-fmain a { font-size: 22px; font-weight: 700; text-transform: uppercase; }

  .g-fbottom {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px 40px;
    flex-wrap: wrap;
    margin-top: 80px;
    padding: 56px 0 48px;
    border-top: 1px solid #333;
    font-size: 17px;
  }
  .g-fbottom p { margin: 0; }
  .g-fbottom ul { display: flex; flex-wrap: wrap; gap: 8px 44px; }

  @media (max-width: 1200px) {
    .g-fhead, .g-fmain a { font-size: 18px; }
    .g-fcol li, .g-fbottom { font-size: 15px; }
  }
  @media (max-width: 900px) {
    .g-footer { padding-top: max(56px, 12vw); }
    .g-footer-cols { flex-direction: column; gap: 32px; }
    .g-fgroup { flex-wrap: wrap; }
    .g-fmain, .g-fgroup--right .g-fmain { margin-top: 0 !important; }
    .g-fgroup--right { flex-direction: column-reverse; }
    .g-fbottom { margin-top: 40px; padding: 28px 0 32px; flex-direction: column; align-items: flex-start; }
    .g-fbottom ul { gap: 8px 24px; }
  }
</style>
