---
import { brandVideo, groupFooter as f } from '../../data/home';
import { site } from '../../data/site';
const year = new Date().getFullYear();

interface Props {
  // Set to false to leave out the black team-photo strip above the footer.
  showStrip?: boolean;
}
const { showStrip = true } = Astro.props;
---
{showStrip && <section class="g-video" aria-label={brandVideo.title}>
  {brandVideo.src ? (
    <video
      class="g-video-media"
      src={brandVideo.src}
      poster={brandVideo.poster || undefined}
      autoplay
      muted
      loop
      playsinline
      preload="metadata"
      aria-label={brandVideo.title}
    ></video>
  ) : (
    <div class="g-video-empty">Video coming soon</div>
  )}
</section>}

<footer class={showStrip ? 'g-footer' : 'g-footer g-footer--no-strip'}>
  <svg class="g-curve" viewBox="0 0 1680 184" preserveAspectRatio="none" aria-hidden="true">
    <path d="M0 0H1680C1250 0 1000 45 840 184C680 45 430 0 0 0Z" fill="#000" />
  </svg>
  <img class="g-swirl" src="/images/home/swirl.png" alt="" width="88" height="80" />

  <div class="g-container">
    <div class="g-footer-cols">
      <div class="g-fgroup g-fgroup--left">
        <div class="g-fstack">
          {f.left.map((col) => (
            <div class="g-fcol">
              <a class="g-fhead" href={col.href}>{col.title}</a>
              <ul>{col.links.map((l) => <li><a href={l.href}>{l.label}</a></li>)}</ul>
            </div>
          ))}
        </div>
        <ul class="g-fmain">{f.leftMain.map((l) => <li><a href={l.href}>{l.label}</a></li>)}</ul>
      </div>

      <div class="g-fgroup g-fgroup--right">
        <ul class="g-fmain">{f.rightMain.map((l) => <li><a href={l.href}>{l.label}</a></li>)}</ul>
        <div class="g-fcol g-fcol--quick">
          <p class="g-fhead g-fhead--quick">Quick Links</p>
          <div class="g-fquick">
            {f.quickLinks.map((group) => (
              <ul>{group.map((l) => <li><a href={l.href}>{l.label}</a></li>)}</ul>
            ))}
          </div>
        </div>
      </div>
    </div>

    <div class="g-fbottom">
      <p>{`© ${year} ${site.company}`}</p>
      <ul>{f.legal.map((l) => <li><a href={l.href}>{l.label}</a></li>)}</ul>
    </div>
  </div>
</footer>

<script>
  // Respect reduced-motion: keep the strip video still.
  const v = document.querySelector<HTMLVideoElement>('.g-video-media');
  if (v && window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    v.removeAttribute('autoplay');
    v.pause();
  }
</script>

<style>
  /* Compact strip + footer: together they fit in well under one screen. */
  .g-video {
    background: #000;
    margin-top: 24px;
    overflow: hidden;
  }
  .g-video-media,
  .g-video-empty {
    display: block;
    width: 100%;
    /* The video is 1920 x 420 with ~12% empty black above and below the
       faces. Fill the full width and trim only that black, so the photos
       still scroll end to end but the band is shorter. */
    height: max(96px, 17vw);
    max-height: 330px;
    object-fit: cover;
    background: #000;
  }
  .g-video-empty {
    display: grid;
    place-items: center;
    color: rgba(255, 255, 255, 0.5);
    font-size: 14px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .g-footer {
    position: relative;
    background: #fff;
    color: var(--g-ink);
    padding-top: clamp(52px, 5.2vw, 76px);
  }
  .g-footer--no-strip { margin-top: clamp(24px, 4vw, 64px); }
  .g-curve {
    position: absolute;
    top: -1px;
    left: 0;
    width: 100%;
    height: calc(clamp(24px, 3.6vw, 52px) + 1px);
    display: block;
  }
  .g-swirl {
    position: absolute;
    top: 2px;
    left: 50%;
    transform: translateX(-50%);
    width: clamp(22px, 2.4vw, 36px);
    height: auto;
  }
  .g-footer-cols {
    position: relative;
    display: flex;
    justify-content: space-between;
    gap: 32px;
  }
  .g-fgroup { display: flex; gap: clamp(28px, 4vw, 64px); }
  .g-fstack { display: flex; gap: clamp(28px, 4vw, 64px); }
  .g-footer ul { list-style: none; margin: 0; padding: 0; }
  .g-footer a { color: inherit; text-decoration: none; }
  .g-footer a:hover { color: var(--g-blue); }
  .g-fhead {
    display: block;
    margin: 0 0 6px;
    font-size: 14px;
    font-weight: 600;
    text-transform: uppercase;
  }
  .g-fhead--quick { text-transform: none; }
  .g-fcol li { font-size: 13.5px; line-height: 1.75; }
  .g-fquick { display: flex; gap: 28px; }
  .g-fmain {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .g-fmain a { font-size: 14px; font-weight: 600; text-transform: uppercase; }

  .g-fbottom {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 8px 40px;
    flex-wrap: wrap;
    margin-top: 28px;
    padding: 16px 0 20px;
    border-top: 1px solid #ddd;
    font-size: 13px;
  }
  .g-fbottom p { margin: 0; }
  .g-fbottom ul { display: flex; flex-wrap: wrap; gap: 6px 32px; }

  @media (max-width: 1100px) {
    .g-footer-cols { flex-wrap: wrap; row-gap: 24px; }
  }
  @media (max-width: 700px) {
    .g-footer { padding-top: 40px; }
    .g-footer-cols {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 20px 16px;
    }
    .g-fgroup, .g-fstack { display: contents; }
    .g-fcol--quick { grid-column: 1 / -1; }
    .g-fquick { gap: 16px; }
    .g-fquick ul { flex: 1; }
    .g-fhead, .g-fmain a { font-size: 13px; }
    .g-fcol li { font-size: 13px; line-height: 1.7; }
    .g-fmain { gap: 8px; }
    .g-fbottom { margin-top: 20px; padding: 12px 0 16px; font-size: 12px; }
    .g-fbottom ul { gap: 4px 18px; }
  }
</style>
