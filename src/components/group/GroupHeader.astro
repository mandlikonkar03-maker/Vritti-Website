---
import { groupNav } from '../../data/home';
import { site } from '../../data/site';
const current = Astro.url.pathname;
---
<header class="g-header">
  <div class="g-container g-header-inner">
    <a href="/" class="g-logo" aria-label={`${site.name} Group home`}>
      <img src="/images/vritti-logo.png" alt={`${site.name} – ${site.tagline}`} width="170" height="70" />
    </a>
    <button class="g-nav-toggle" aria-expanded="false" aria-controls="group-nav" aria-label="Open menu">
      <span></span><span></span><span></span>
    </button>
    <nav id="group-nav" class="g-nav" aria-label="Main">
      <ul>
        {groupNav.map((item) => (
          <li>
            <a href={item.href} aria-current={item.href !== '/' && current === item.href ? 'page' : undefined}>
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
</header>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('.g-nav-toggle');
  const nav = document.getElementById('group-nav');
  const setOpen = (open: boolean) => {
    toggle?.setAttribute('aria-expanded', String(open));
    toggle?.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
    nav?.classList.toggle('is-open', open);
  };
  toggle?.addEventListener('click', () => setOpen(toggle.getAttribute('aria-expanded') !== 'true'));
  nav?.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => setOpen(false)));
</script>

<style>
  .g-header {
    background: #fff;
    position: sticky;
    top: 0;
    z-index: 50;
    box-shadow: 0 1px 0 rgba(0, 0, 0, 0.06);
  }
  .g-header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 110px;
  }
  .g-logo img { display: block; width: 170px; height: auto; }
  .g-nav ul {
    display: flex;
    gap: clamp(28px, 3.6vw, 62px);
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .g-nav a {
    color: var(--g-blue);
    font-weight: 600;
    font-size: 16px;
    text-transform: uppercase;
    text-decoration: none;
  }
  .g-nav a:hover, .g-nav a[aria-current='page'] { color: var(--g-orange); }
  .g-nav-toggle {
    display: none;
    background: none;
    border: 0;
    padding: 10px;
    cursor: pointer;
  }
  .g-nav-toggle span {
    display: block;
    width: 24px;
    height: 2px;
    margin: 5px 0;
    background: var(--g-blue);
    transition: transform 0.2s, opacity 0.2s;
  }
  .g-nav-toggle[aria-expanded='true'] span:nth-child(1) { transform: translateY(7px) rotate(45deg); }
  .g-nav-toggle[aria-expanded='true'] span:nth-child(2) { opacity: 0; }
  .g-nav-toggle[aria-expanded='true'] span:nth-child(3) { transform: translateY(-7px) rotate(-45deg); }

  @media (max-width: 1100px) {
    .g-header-inner { min-height: 88px; }
    .g-logo img { width: 140px; }
    .g-nav a { font-size: 14px; }
  }
  @media (max-width: 900px) {
    .g-header-inner { min-height: 68px; }
    .g-logo img { width: 120px; }
    .g-nav-toggle { display: block; }
    .g-nav {
      display: none;
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      background: #fff;
      box-shadow: 0 12px 24px rgba(0, 0, 0, 0.1);
    }
    .g-nav.is-open { display: block; }
    .g-nav ul { flex-direction: column; gap: 0; padding: 8px 16px 16px; }
    .g-nav a { display: block; padding: 14px 4px; border-bottom: 1px solid #eee; }
  }
</style>
