---
// "Our Journey": a scroll-driven timeline. While the visitor scrolls through the
// section, the panel stays pinned, the year rolls forward like a counter and the
// matching milestone slides in. Without JavaScript (or for print) every milestone
// is shown as a plain list instead. Content lives in src/data/about.ts.
import { journey, journeyIntro } from '../../data/about';

const icons: Record<string, string> = {
  rocket: '<path d="M12 15.5 8.5 12C10 7 13.5 4 19.5 4.5 20 10.5 17 14 12 15.5z"/><circle cx="15" cy="9" r="1.6"/><path d="M8.5 12 5 11.5l2.5-3h4M12 15.5l.5 3.5 3-2.5v-4M6.5 17.5c-1 1-1.5 2.5-1.5 2.5s1.5-.5 2.5-1.5"/>',
  team: '<circle cx="9" cy="8" r="3"/><path d="M3.5 19c.6-3 2.8-4.8 5.5-4.8s4.9 1.8 5.5 4.8M16 5.2a3 3 0 0 1 0 5.6M17.5 14.5c1.6.6 2.7 2.2 3 4.5"/>',
  office: '<path d="M4 20.5V5.5l8-2v17M12 8.5h8v12M3 20.5h18M7 8h2M7 11.5h2M7 15h2M15 12h2M15 15.5h2"/>',
  speaker: '<path d="M4 9.5h3.5L13 5v14l-5.5-4.5H4z"/><path d="M16.5 9a4 4 0 0 1 0 6M19 6.5a7.5 7.5 0 0 1 0 11"/>',
  award: '<circle cx="12" cy="9" r="5.5"/><path d="m12 6.2 1 2 2.2.3-1.6 1.5.4 2.2-2-1-2 1 .4-2.2-1.6-1.5 2.2-.3zM8.5 13.5 7 20.5l5-2.5 5 2.5-1.5-7"/>',
  erp: '<rect x="3.5" y="4.5" width="13" height="10" rx="1.5"/><rect x="15" y="9" width="5.5" height="10.5" rx="1.2"/><path d="M7 18.5h6M10 14.5v4"/>',
  handshake: '<path d="m3 11 4-4 3 1 2-1.5 3 .5 6 4.5"/><path d="M3 11l5.5 6c.8.8 2 .8 2.7 0M10 16l1.5 1.5c.8.8 2 .8 2.7 0M12.5 14.5l1.5 1.5c.8.8 2 .8 2.7 0l2.3-2.5"/><path d="M12 7.5 9 10.5c-.6.6-.6 1.5 0 2s1.5.6 2 0l2-2"/>',
  globe: '<circle cx="12" cy="12" r="8.5"/><path d="M3.5 12h17M12 3.5c2.5 2.6 3.5 5.4 3.5 8.5s-1 5.9-3.5 8.5c-2.5-2.6-3.5-5.4-3.5-8.5s1-5.9 3.5-8.5z"/>',
};
const first = journey[0].year;
---
<section class="journey" id="journey" aria-labelledby="journey-title" style={`--n:${journey.length}`} data-journey>
  <div class="j-track">
    <div class="j-pin">
      <div class="g-container j-inner">
        <header class="j-head">
          <div>
            <h2 class="g-title j-title" id="journey-title">{journeyIntro.title}</h2>
            <p class="g-sub j-sub">{journeyIntro.sub}</p>
          </div>
          <p class="j-count" aria-hidden="true"><span data-j-count>01</span> / {String(journey.length).padStart(2, '0')}</p>
        </header>

        <nav class="j-rail" aria-label="Journey years">
          <span class="j-rail-line" aria-hidden="true"><span class="j-rail-fill" data-j-fill></span></span>
          <ol>
            {journey.map((m, i) => (
              <li>
                <button type="button" data-j-go={i} aria-current={i === 0 ? 'step' : undefined}>
                  <span class="j-dot" aria-hidden="true"></span>
                  <span class="j-rail-year">{m.year}</span>
                </button>
              </li>
            ))}
          </ol>
        </nav>

        <div class="j-stage">
          <div class="j-year" aria-hidden="true" data-j-year>
            {first.split('').map((d) => (
              <span class="j-digit" style={`--d:${d}`}>
                <span class="j-digit-strip">{'0123456789'.split('').map((x) => <span>{x}</span>)}</span>
              </span>
            ))}
          </div>

          <ol class="j-steps" aria-live="polite">
            {journey.map((m, i) => (
              <li class:list={['j-step', { 'is-active': i === 0 }]} data-j-step={i} data-year={m.year}>
                <div class="j-copy">
                  <p class="j-step-year">{m.year}</p>
                  <h3>
                    {m.icon && icons[m.icon] && (
                      <span class={`j-icon j-icon--${m.icon}`} aria-hidden="true">
                        <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" set:html={icons[m.icon]} />
                      </span>
                    )}
                    <span>{m.title}</span>
                  </h3>
                  {m.points && (
                    <ul class="j-points">
                      {m.points.map((p) => <li>{p}</li>)}
                    </ul>
                  )}
                </div>
                <div class="j-media">
                  {m.image && (
                    <figure class:list={['j-photo', { 'j-photo--contain': m.image.fit === 'contain' }]}>
                      <img src={m.image.src} alt={m.image.alt} loading="lazy" decoding="async" />
                    </figure>
                  )}
                  {m.people && (
                    <ul class="j-people">
                      {m.people.map((p) => (
                        <li>
                          <img src={p.photo} alt="" width="64" height="64" loading="lazy" decoding="async" />
                          <span><strong>{p.name}</strong>{p.role}</span>
                        </li>
                      ))}
                    </ul>
                  )}
                </div>
              </li>
            ))}
          </ol>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .journey {
    --j-bg: #4b4748;
    --j-line: rgba(255, 255, 255, 0.28);
    --j-top: 110px; /* height of the sticky group header */
    background: var(--j-bg);
    color: #fff;
  }
  @media (max-width: 1100px) { .journey { --j-top: 88px; } }
  @media (max-width: 900px) { .journey { --j-top: 68px; } }

  .j-inner { padding-top: var(--section-y); padding-bottom: var(--section-y); }
  .j-head { display: flex; align-items: flex-end; justify-content: space-between; gap: 16px; margin-bottom: clamp(18px, 2vw, 28px); }
  .j-title { margin: 0; color: #fff; }
  .j-sub { color: rgba(255, 255, 255, 0.72); }
  .j-count { margin: 0; font-weight: 600; font-size: 14px; letter-spacing: 0.08em; color: rgba(255, 255, 255, 0.6); font-variant-numeric: tabular-nums; }
  .j-count span { color: var(--g-orange); font-size: 22px; }

  /* ---------- Year rail ---------- */
  .j-rail { position: relative; margin-bottom: clamp(20px, 3vw, 44px); }
  .j-rail-line { position: absolute; left: 0; right: 0; top: 9px; height: 2px; background: var(--j-line); }
  .j-rail-fill {
    display: block; height: 100%; width: 100%;
    background: var(--g-orange);
    transform-origin: left; transform: scaleX(var(--p, 0));
    transition: transform 0.6s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .j-rail ol { list-style: none; margin: 0; padding: 0; display: flex; justify-content: space-between; position: relative; }
  .j-rail button {
    background: none; border: 0; padding: 0; margin: 0; cursor: pointer; color: rgba(255, 255, 255, 0.55);
    font: inherit; display: flex; flex-direction: column; align-items: center; gap: 8px;
  }
  .j-rail li:first-child button { align-items: flex-start; }
  .j-rail li:last-child button { align-items: flex-end; }
  .j-dot {
    width: 20px; height: 20px; border-radius: 50%; display: grid; place-items: center;
    background: var(--j-bg); border: 2px solid var(--j-line);
    transition: border-color 0.3s, background 0.3s, transform 0.3s;
  }
  .j-dot::after { content: ''; width: 8px; height: 8px; border-radius: 50%; background: transparent; transition: background 0.3s; }
  .j-rail-year { font-weight: 700; font-size: 14px; transition: color 0.3s; }
  .j-rail button.is-past .j-dot { border-color: var(--g-orange); }
  .j-rail button[aria-current] { color: #fff; }
  .j-rail button[aria-current] .j-dot { border-color: var(--g-orange); background: var(--g-orange); transform: scale(1.15); }
  .j-rail button[aria-current] .j-dot::after { background: #fff; }
  .j-rail button:hover { color: #fff; }
  .j-rail button:focus-visible { outline: 2px solid var(--g-orange); outline-offset: 4px; border-radius: 4px; }

  /* ---------- Stage ---------- */
  .j-stage { display: grid; grid-template-columns: minmax(0, 1fr); }
  .j-year {
    display: flex; font-weight: 800; line-height: 1; letter-spacing: -0.02em;
    font-size: clamp(64px, 9vw, 150px); color: #fff; margin-bottom: clamp(8px, 1.4vw, 20px);
    font-variant-numeric: tabular-nums;
  }
  .j-digit { display: inline-block; height: 1em; overflow: hidden; }
  .j-digit-strip {
    display: flex; flex-direction: column;
    transform: translateY(calc(var(--d) * -1em));
    transition: transform 0.85s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .j-digit-strip span { height: 1em; display: block; text-align: center; }
  .j-digit:last-child { color: var(--g-orange); }

  .j-steps { list-style: none; margin: 0; padding: 0; display: grid; }
  .j-step {
    grid-area: 1 / 1;
    display: grid; grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr); gap: clamp(20px, 4vw, 64px); align-items: start; align-content: start;
  }
  .j-step-year { display: none; }
  .j-step h3 {
    margin: 0; display: flex; gap: 14px; align-items: flex-start;
    font-size: clamp(20px, 2vw, 32px); font-weight: 700; line-height: 1.2;
  }
  .j-icon {
    flex: none; width: 44px; height: 44px; border-radius: 50%; display: grid; place-items: center;
    background: var(--g-orange); color: #fff; margin-top: -4px;
  }
  .j-icon--rocket { background: #f6b800; }
  .j-icon--team, .j-icon--office { background: #69b52e; }
  .j-icon--speaker { background: #e3141b; }
  .j-icon--erp, .j-icon--globe { background: #1288d0; }
  .j-icon--handshake { background: #6a3fb0; }
  .j-points { margin: clamp(14px, 1.6vw, 22px) 0 0; padding: 0 0 0 58px; list-style: none; display: grid; gap: 8px; }
  .j-points li { position: relative; font-size: clamp(14px, 1.1vw, 17px); line-height: 1.45; color: rgba(255, 255, 255, 0.86); }
  .j-points li::before { content: ''; position: absolute; left: -20px; top: 0.6em; width: 8px; height: 2px; background: var(--g-orange); }

  .j-media { display: grid; gap: 18px; justify-items: start; }
  .j-photo { margin: 0; width: 100%; max-width: 420px; aspect-ratio: 16 / 10; border-radius: 14px; overflow: hidden; background: rgba(255, 255, 255, 0.08); box-shadow: 0 18px 40px rgba(0, 0, 0, 0.28); }
  .j-photo img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .j-photo--contain img { object-fit: contain; }
  .j-people { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 14px 26px; }
  .j-people li { display: flex; align-items: center; gap: 12px; }
  .j-people img { width: 64px; height: 64px; border-radius: 50%; object-fit: cover; object-position: top; border: 3px solid rgba(255, 255, 255, 0.9); }
  .j-people span { display: flex; flex-direction: column; font-size: 13px; color: rgba(255, 255, 255, 0.72); line-height: 1.35; }
  .j-people strong { color: #fff; font-size: 15px; font-weight: 600; }

  /* ---------- Without JS: a plain list of milestones ---------- */
  .journey:not(.is-live) .j-rail,
  .journey:not(.is-live) .j-year,
  .journey:not(.is-live) .j-count { display: none; }
  .journey:not(.is-live) .j-steps { gap: 48px; }
  .journey:not(.is-live) .j-step { grid-area: auto; }
  .journey:not(.is-live) .j-step-year { display: block; margin: 0 0 10px; font-size: 44px; font-weight: 800; color: var(--g-orange); line-height: 1; }

  /* ---------- Scroll-pinned mode ---------- */
  .journey.is-live .j-track { height: calc(var(--n) * var(--j-step-h, 70vh) + 100vh - var(--j-top)); }
  .journey.is-live .j-pin {
    position: sticky; top: var(--j-top);
    height: calc(100vh - var(--j-top)); height: calc(100svh - var(--j-top));
    overflow: hidden; display: flex; flex-direction: column; justify-content: safe center;
  }
  .journey.is-live .j-step {
    opacity: 0; visibility: hidden; pointer-events: none;
    transform: translateY(var(--j-from, 36px));
    transition: opacity 0.45s ease, transform 0.6s cubic-bezier(0.22, 1, 0.36, 1), visibility 0s linear 0.6s;
  }
  .journey.is-live .j-step .j-photo { transform: scale(0.94); transition: transform 0.7s cubic-bezier(0.22, 1, 0.36, 1); }
  .journey.is-live .j-step.is-active {
    opacity: 1; visibility: visible; pointer-events: auto; transform: none;
    transition: opacity 0.5s ease 0.1s, transform 0.7s cubic-bezier(0.22, 1, 0.36, 1) 0.1s, visibility 0s;
  }
  .journey.is-live .j-step.is-active .j-photo { transform: none; }
  .journey.is-live.is-back .j-step { --j-from: -36px; }
  .journey.is-live .j-step.is-active .j-points li,
  .journey.is-live .j-step.is-active .j-people li { animation: j-rise 0.6s cubic-bezier(0.22, 1, 0.36, 1) both; }
  .journey.is-live .j-step.is-active .j-points li:nth-child(2),
  .journey.is-live .j-step.is-active .j-people li:nth-child(2) { animation-delay: 0.12s; }
  .journey.is-live .j-step.is-active .j-points li:nth-child(3) { animation-delay: 0.24s; }
  @keyframes j-rise { from { opacity: 0; transform: translateY(14px); } to { opacity: 1; transform: none; } }

  @media (max-width: 768px) {
    .journey { --j-step-h: 60vh; }
    .j-inner { padding-top: 22px; padding-bottom: 22px; }
    .j-head { margin-bottom: 16px; align-items: center; }
    .j-sub { display: none; }
    .j-count span { font-size: 18px; }
    .j-rail { margin-bottom: 18px; }
    .j-rail-year { font-size: 11px; }
    .j-dot { width: 16px; height: 16px; }
    .j-dot::after { width: 6px; height: 6px; }
    .j-rail-line { top: 7px; }
    .j-rail button { gap: 6px; }
    .j-year { font-size: clamp(52px, 15vw, 76px); margin-bottom: 10px; }
    .j-step { grid-template-columns: minmax(0, 1fr); gap: 14px; }
    .j-step h3 { font-size: 18px; gap: 12px; align-items: center; }
    .j-icon { width: 34px; height: 34px; margin-top: 0; }
    .j-icon svg { width: 18px; height: 18px; }
    .j-points { padding-left: 46px; margin-top: 8px; gap: 3px; }
    .j-points li { font-size: 13.5px; line-height: 1.4; }
    .j-points li::before { left: -18px; }
    .j-media { gap: 12px; justify-items: stretch; }
    .j-photo { max-width: none; aspect-ratio: auto; height: clamp(96px, 22svh, 210px); border-radius: 12px; }
    .j-people { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 10px; }
    .j-people li { gap: 8px; }
    .j-people img { width: 42px; height: 42px; border-width: 2px; flex: none; }
    .j-people span { font-size: 11.5px; }
    .j-people strong { font-size: 13px; }
    .journey:not(.is-live) .j-steps { gap: 36px; }
  }
  /* Short landscape phones: not enough height to pin, so show the list. */
  @media (max-height: 520px) {
    .journey.is-live .j-track { height: auto; }
    .journey.is-live .j-pin { position: static; height: auto; }
  }

  @media (prefers-reduced-motion: reduce) {
    .j-digit-strip, .j-rail-fill, .journey.is-live .j-step, .journey.is-live .j-step .j-photo { transition: none !important; }
    .journey.is-live .j-step.is-active .j-points li,
    .journey.is-live .j-step.is-active .j-people li { animation: none; }
  }
</style>

<script>
  function initJourney(root: HTMLElement) {
    const track = root.querySelector<HTMLElement>('.j-track')!;
    const pin = root.querySelector<HTMLElement>('.j-pin')!;
    const steps = Array.from(root.querySelectorAll<HTMLElement>('[data-j-step]'));
    const dots = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-j-go]'));
    const digits = Array.from(root.querySelectorAll<HTMLElement>('.j-digit'));
    const fill = root.querySelector<HTMLElement>('[data-j-fill]')!;
    const count = root.querySelector<HTMLElement>('[data-j-count]')!;
    const n = steps.length;
    let current = -1;

    root.classList.add('is-live');
    const pinned = () => getComputedStyle(pin).position === 'sticky';

    function show(i: number) {
      if (i === current) return;
      root.classList.toggle('is-back', i < current);
      current = i;
      steps.forEach((s, k) => s.classList.toggle('is-active', k === i));
      dots.forEach((d, k) => {
        if (k === i) d.setAttribute('aria-current', 'step');
        else d.removeAttribute('aria-current');
        d.classList.toggle('is-past', k < i);
      });
      const year = steps[i].dataset.year || '';
      year.split('').forEach((ch, k) => digits[k]?.style.setProperty('--d', ch));
      fill.style.setProperty('--p', String(n > 1 ? i / (n - 1) : 1));
      count.textContent = String(i + 1).padStart(2, '0');
    }

    // Scroll distance (px) that belongs to each year.
    const span = () => (track.offsetHeight - pin.offsetHeight) / n;
    const pinTop = () => parseFloat(getComputedStyle(pin).top) || 0;

    function update() {
      if (!pinned()) {
        steps.forEach((s) => s.classList.add('is-active'));
        current = -1;
        return;
      }
      const scrolled = pinTop() - track.getBoundingClientRect().top;
      const i = Math.min(n - 1, Math.max(0, Math.floor(scrolled / span())));
      show(i);
    }

    dots.forEach((d) => {
      d.addEventListener('click', () => {
        const i = Number(d.dataset.jGo);
        if (!pinned()) { steps[i].scrollIntoView({ behavior: 'smooth', block: 'start' }); return; }
        const trackTop = track.getBoundingClientRect().top + window.scrollY;
        window.scrollTo({ top: trackTop - pinTop() + span() * (i + 0.5), behavior: 'smooth' });
      });
    });

    let raf = 0;
    const onScroll = () => {
      if (raf) return;
      raf = requestAnimationFrame(() => { raf = 0; update(); });
    };
    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', onScroll);
    update();
  }

  document.querySelectorAll<HTMLElement>('[data-journey]').forEach(initJourney);
</script>
