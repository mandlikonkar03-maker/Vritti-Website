---
// "Our Journey": a year-by-year timeline. Click a year on the rail, use the arrows
// or swipe (phones) and the year rolls forward like a counter while the matching
// milestone slides in. It also advances on its own while in view, until the visitor
// takes over. The page scrolls normally past it. Without JavaScript (or for print) every milestone
// is shown as a plain list instead. Content lives in src/data/about.ts.
import { journey, journeyIntro } from '../../data/about';
import AudiowalaMap from './AudiowalaMap.astro';

const icons: Record<string, string> = {
  rocket: '<path d="M12 15.5 8.5 12C10 7 13.5 4 19.5 4.5 20 10.5 17 14 12 15.5z"/><circle cx="15" cy="9" r="1.6"/><path d="M8.5 12 5 11.5l2.5-3h4M12 15.5l.5 3.5 3-2.5v-4M6.5 17.5c-1 1-1.5 2.5-1.5 2.5s1.5-.5 2.5-1.5"/>',
  team: '<circle cx="9" cy="8" r="3"/><path d="M3.5 19c.6-3 2.8-4.8 5.5-4.8s4.9 1.8 5.5 4.8M16 5.2a3 3 0 0 1 0 5.6M17.5 14.5c1.6.6 2.7 2.2 3 4.5"/>',
  office: '<path d="M4 20.5V5.5l8-2v17M12 8.5h8v12M3 20.5h18M7 8h2M7 11.5h2M7 15h2M15 12h2M15 15.5h2"/>',
  speaker: '<path d="M4 9.5h3.5L13 5v14l-5.5-4.5H4z"/><path d="M16.5 9a4 4 0 0 1 0 6M19 6.5a7.5 7.5 0 0 1 0 11"/>',
  award: '<circle cx="12" cy="9" r="5.5"/><path d="m12 6.2 1 2 2.2.3-1.6 1.5.4 2.2-2-1-2 1 .4-2.2-1.6-1.5 2.2-.3zM8.5 13.5 7 20.5l5-2.5 5 2.5-1.5-7"/>',
  erp: '<rect x="3.5" y="4.5" width="13" height="10" rx="1.5"/><rect x="15" y="9" width="5.5" height="10.5" rx="1.2"/><path d="M7 18.5h6M10 14.5v4"/>',
  mobile: '<rect x="7" y="3" width="10" height="18" rx="2"/><path d="M10.5 6h3M11 18h2"/>',
  handshake: '<path d="m3 11 4-4 3 1 2-1.5 3 .5 6 4.5"/><path d="M3 11l5.5 6c.8.8 2 .8 2.7 0M10 16l1.5 1.5c.8.8 2 .8 2.7 0M12.5 14.5l1.5 1.5c.8.8 2 .8 2.7 0l2.3-2.5"/><path d="M12 7.5 9 10.5c-.6.6-.6 1.5 0 2s1.5.6 2 0l2-2"/>',
  globe: '<circle cx="12" cy="12" r="8.5"/><path d="M3.5 12h17M12 3.5c2.5 2.6 3.5 5.4 3.5 8.5s-1 5.9-3.5 8.5c-2.5-2.6-3.5-5.4-3.5-8.5s1-5.9 3.5-8.5z"/>',
};
const first = journey[0].year;
// "2000–2002" for an event over several years, else just the year.
const span = (m: { year: string; until?: string }) => (m.until ? `${m.year}–${m.until}` : m.year);

// **bold** and [[typed bold]] markup from about.ts, with everything else escaped.
const esc = (t: string) => t.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
const rich = (t: string) =>
  esc(t)
    .replace(/\[\[(.+?)\]\]/g, (_, w) => `<strong class="j-type" data-type="${w}" aria-label="${w}"><span class="j-typed" aria-hidden="true"></span><span class="j-rest" aria-hidden="true">${w}</span></strong>`)
    .replace(/\*\*(.+?)\*\*/g, '<strong>$1</strong>');
---
<section class="journey g-section" id="journey" aria-labelledby="journey-title" style={`--n:${journey.length}`} data-journey>
  <div class="g-container">
    <div class="g-head j-head">
      <h2 class="g-title" id="journey-title">{journeyIntro.title}</h2>
      <p class="g-sub">{journeyIntro.sub}</p>
    </div>
  </div>

  <div class="j-track">
    <div class="j-pin">
      <div class="g-container j-inner">
        <nav class="j-rail" aria-label="Journey years">
          <div class="j-rail-in">
          <span class="j-rail-line" aria-hidden="true"><span class="j-rail-fill" data-j-fill></span></span>
          <ol>
            {journey.map((m, i) => (
              <li>
                <button type="button" data-j-go={i} aria-current={i === 0 ? 'step' : undefined} aria-label={span(m)}>
                  <span class="j-dot" aria-hidden="true"></span>
                  <span class="j-rail-year" aria-hidden="true">{m.year}{m.until && <span class="j-rail-until">–{m.until.slice(2)}</span>}</span>
                </button>
              </li>
            ))}
          </ol>
          </div>
        </nav>

        <div class="j-stage">
          <div class="j-year" data-j-year>
            {first.split('').map((d) => (
              <span class="j-digit" aria-hidden="true" style={`--d:${d}`}>
                <span class="j-digit-strip">{'0123456789'.split('').map((x) => <span>{x}</span>)}</span>
              </span>
            ))}
            <span class="j-until" data-j-until aria-hidden="true">{journey[0].until ? `–${journey[0].until}` : ''}</span>
            <span class="j-count" aria-hidden="true"><span data-j-count>01</span> / {String(journey.length).padStart(2, '0')}</span>
            <div class="j-nav">
              <button type="button" class="j-arrow" data-j-prev aria-label="Previous year">
                <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 5l-7 7 7 7"/></svg>
              </button>
              <button type="button" class="j-arrow" data-j-next aria-label="Next year">
                <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 5l7 7-7 7"/></svg>
              </button>
            </div>
          </div>

          <ol class="j-steps" aria-live="polite">
            {journey.map((m, i) => (
              <li class:list={['j-step', { 'is-active': i === 0, 'no-photo': !m.image && !m.slides && !m.map && !m.parts, 'has-parts': !!m.parts }]} data-j-step={i} data-year={m.year} data-until={m.until}>
                {m.parts && <p class="j-step-year">{span(m)}</p>}
                {(m.parts ?? [m]).map((b) => (
                  <div class="j-part">
                    <div class="j-copy">
                      {!m.parts && <p class="j-step-year">{span(m)}</p>}
                      <h3>
                        {b.icon && icons[b.icon] && (
                          <span class={`j-icon j-icon--${b.icon}`} aria-hidden="true">
                            <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" set:html={icons[b.icon]} />
                          </span>
                        )}
                        <span set:html={rich(b.title)} />
                      </h3>
                      {b.text && <p class="j-text" set:html={rich(b.text)} />}
                      {b.points && (
                        <ul class="j-points">
                          {b.points.map((p) => <li set:html={rich(p)} />)}
                        </ul>
                      )}
                      {b.people && (
                        <ul class="j-people">
                          {b.people.map((p) => (
                            <li>
                              <img src={p.photo} alt="" width="72" height="72" loading="lazy" decoding="async" />
                              <span><strong>{p.name}</strong>{p.role}</span>
                            </li>
                          ))}
                        </ul>
                      )}
                    </div>
                    {b.map === 'audiowala' && (
                      <div class="j-photo j-photo--plain j-map" style="--ar:333/372">
                        <AudiowalaMap states={b.mapStates} branch={b.mapBranch} logos={b.mapLogos} label={b.mapLabel} />
                      </div>
                    )}
                    {b.slides && b.pair && (
                      <figure class="j-pair" style={`--ar:${2 * b.slides[0].width + 24}/${b.slides[0].height}`} data-j-pair>
                        {[0, 1].map((f) => (
                          <span class="j-photo j-slides">
                            {b.slides!.map((sl, si) => (
                              <img class:list={{ 'is-on': si === f }} src={sl.src} alt={f === 0 ? sl.alt : ''} width={sl.width} height={sl.height} loading="lazy" decoding="async" />
                            ))}
                          </span>
                        ))}
                      </figure>
                    )}
                    {b.slides && b.laptop && (
                      <figure class="j-photo j-photo--plain j-laptops" style="--ar:2.05" data-j-laptops>
                        {b.slides.map((sl, si) => (
                          <button type="button" class="j-dev j-laptop" data-pos={si} aria-label={`Show ${sl.label ?? sl.alt}`}>
                            <span class="j-laptop-lid">
                              <span class="j-laptop-screen">
                                <img src={sl.src} alt={sl.alt} width={sl.width} height={sl.height} loading="lazy" decoding="async" />
                                <span class="j-laptop-glare" aria-hidden="true" />
                              </span>
                            </span>
                            <span class="j-laptop-base" aria-hidden="true" />
                          </button>
                        ))}
                        <span class="j-laptops-floor" aria-hidden="true" />
                        <figcaption class="j-laptops-cap">
                          {b.slides.map((sl, si) => <span class:list={{ 'is-on': si === 0 }}>{sl.label ?? sl.alt}</span>)}
                        </figcaption>
                      </figure>
                    )}
                    {b.slides && b.phone && (
                      <figure class="j-photo j-photo--plain j-laptops j-phones" style="--ar:1.3" data-j-laptops>
                        {b.slides.map((sl, si) => (
                          <button type="button" class="j-dev j-phone" data-pos={si} aria-label={`Show ${sl.label ?? sl.alt}`}>
                            <span class="j-phone-screen">
                              <img src={sl.src} alt={sl.alt} width={sl.width} height={sl.height} loading="lazy" decoding="async" />
                              <span class="j-phone-island" aria-hidden="true" />
                              <span class="j-laptop-glare" aria-hidden="true" />
                            </span>
                          </button>
                        ))}
                        <figcaption class="j-laptops-cap">
                          {b.slides.map((sl, si) => <span class:list={{ 'is-on': si === 0 }}>{sl.label ?? sl.alt}</span>)}
                        </figcaption>
                      </figure>
                    )}
                    {b.slides && !b.pair && !b.laptop && !b.phone && (
                      <figure class="j-photo j-slides" style={`--ar:${b.slides[0].width}/${b.slides[0].height}`} data-j-slides>
                        {b.slides.map((sl, si) => (
                          <img class:list={{ 'is-on': si === 0 }} src={sl.src} alt={sl.alt} width={sl.width} height={sl.height} loading="lazy" decoding="async" />
                        ))}
                        <span class="j-slide-dots" aria-hidden="true">{b.slides.map((_, si) => <span class:list={{ 'is-on': si === 0 }} />)}</span>
                      </figure>
                    )}
                    {b.image && (
                      <figure class:list={['j-photo', { 'j-photo--plain': b.image.plain }]} style={`--ar:${b.image.width}/${b.image.height}`}>
                        <img src={b.image.src} alt={b.image.alt} width={b.image.width} height={b.image.height} loading="lazy" decoding="async" />
                      </figure>
                    )}
                  </div>
                ))}
              </li>
            ))}
          </ol>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .journey {
    --j-line: #dfe4ea;
    --j-top: 84px; /* height of the sticky group header (used to size photos) */
    --j-yf: clamp(48px, 5vw, 84px); /* big year size */
    background: #fff;
    color: var(--g-ink);
    padding-bottom: 0;
  }
  @media (max-width: 1100px) { .journey { --j-top: 72px; } }
  @media (max-width: 900px) { .journey { --j-top: 60px; } }

  .j-head { margin-bottom: 0; text-align: center; }
  .j-inner { padding-top: clamp(20px, 3vh, 36px); padding-bottom: clamp(20px, 3vh, 36px); }

  /* ---------- Year rail ---------- */
  .j-rail { position: relative; margin-bottom: clamp(20px, 4vh, 44px); }
  .j-rail-line { position: absolute; left: 0; right: 0; top: 9px; height: 2px; background: var(--j-line); }
  .j-rail-fill {
    display: block; height: 100%; width: 100%;
    background: var(--g-orange);
    transform-origin: left; transform: scaleX(var(--p, 0));
    transition: transform 0.6s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .j-rail ol { list-style: none; margin: 0; padding: 0; display: flex; justify-content: space-between; position: relative; }
  .j-rail button {
    background: none; border: 0; padding: 0; margin: 0; cursor: pointer; color: #8a96a3;
    font: inherit; display: flex; flex-direction: column; align-items: center; gap: 8px;
  }
  .j-rail li:first-child button { align-items: flex-start; }
  .j-rail li:last-child button { align-items: flex-end; }
  .j-dot {
    width: 20px; height: 20px; border-radius: 50%; display: grid; place-items: center;
    background: #fff; border: 2px solid #c9d1da;
    transition: border-color 0.3s, background 0.3s, transform 0.3s;
  }
  .j-dot::after { content: ''; width: 8px; height: 8px; border-radius: 50%; background: transparent; transition: background 0.3s; }
  .j-rail-year { font-weight: 600; font-size: 14px; transition: color 0.3s; }
  .j-rail button.is-past .j-dot { border-color: var(--g-orange); }
  .j-rail button[aria-current] { color: var(--g-blue); }
  .j-rail button[aria-current] .j-dot { border-color: var(--g-orange); background: var(--g-orange); transform: scale(1.15); }
  .j-rail button[aria-current] .j-dot::after { background: #fff; }
  .j-rail button:hover { color: var(--g-blue); }
  .j-rail button:focus-visible { outline: 2px solid var(--g-orange); outline-offset: 4px; border-radius: 4px; }

  /* ---------- Stage ---------- */
  .j-stage { position: relative; }
  .j-year {
    position: absolute; top: 0; left: 0; z-index: 1;
    display: flex; align-items: baseline; font-weight: 700; line-height: 1; letter-spacing: -0.02em;
    font-size: var(--j-yf); color: var(--g-blue);
    font-variant-numeric: tabular-nums;
  }
  .j-digit { display: inline-block; height: 1em; overflow: hidden; }
  .j-digit-strip {
    display: flex; flex-direction: column;
    transform: translateY(calc(var(--d) * -1em));
    transition: transform 0.85s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .j-digit-strip span { height: 1em; display: block; text-align: center; }
  .j-digit:nth-child(4) { color: var(--g-orange); }
  /* End year of an event over several years ("– 2002"), smaller beside the big year. */
  .j-until { font-size: 0.5em; margin-left: 0.15em; color: var(--g-blue); white-space: nowrap; transition: opacity 0.4s; }
  .j-until:empty { display: none; }
  .j-rail-until { font-weight: 500; }
  .j-rail-in { position: relative; }
  .j-count { margin-left: 18px; font-size: 14px; font-weight: 600; letter-spacing: 0.08em; color: #8a96a3; }
  .j-count span { color: var(--g-orange); font-size: 18px; }

  .j-steps { list-style: none; margin: 0; padding: 0; display: grid; }
  .j-step {
    grid-area: 1 / 1;
    display: grid; grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
    gap: clamp(24px, 4vw, 64px); align-items: center; align-content: start;
  }
  .j-copy { padding-top: calc(var(--j-yf) + clamp(14px, 2.4vh, 28px)); }
  .j-step-year { display: none; }
  .j-step h3 {
    margin: 0; display: flex; gap: 14px; align-items: flex-start;
    font-size: clamp(18px, 1.5vw, 24px); font-weight: 600; line-height: 1.3; color: var(--g-ink);
  }
  .j-icon {
    flex: none; width: 44px; height: 44px; border-radius: 50%; display: grid; place-items: center;
    background: var(--g-orange); color: #fff; margin-top: -4px;
  }
  .j-icon--rocket { background: #f6b800; }
  .j-icon--team, .j-icon--office { background: #69b52e; }
  .j-icon--speaker { background: #e3141b; }
  .j-icon--erp, .j-icon--mobile, .j-icon--globe { background: #1288d0; }
  .j-icon--handshake { background: #6a3fb0; }
  .j-step h3 :global(strong) { font-weight: 800; }
  /* A heading with a bold or typed word: only that word is bold, the rest normal weight. */
  .j-step h3:has(strong) { font-weight: 400; }
  .j-text { margin: clamp(10px, 1.6vh, 16px) 0 0; padding-left: 58px; font-size: clamp(13.5px, 1vw, 15.5px); line-height: 1.55; color: var(--g-text); }
  .j-text :global(strong), .j-points :global(strong) { color: var(--g-ink); font-weight: 700; }
  /* Typing effect: the word is typed in place and the text after it moves along. */
  :global(.j-type) { position: relative; white-space: nowrap; }
  :global(.j-typed) { display: none; }
  .journey.is-live :global(.j-type.is-typing .j-rest) { display: none; }
  .journey.is-live :global(.j-type.is-typing .j-typed) { display: inline; }
  .journey.is-live :global(.j-type.is-typing .j-typed::after) { content: ''; display: inline-block; width: 2px; height: 1em; margin-left: 2px; vertical-align: -0.12em; background: var(--g-orange); animation: j-caret 0.7s steps(1) infinite; }
  @keyframes j-caret { 50% { opacity: 0; } }
  .j-points { margin: clamp(12px, 2vh, 22px) 0 0; padding: 0 0 0 58px; list-style: none; display: grid; gap: 8px; }
  .j-points li { position: relative; font-size: clamp(13.5px, 1vw, 15.5px); line-height: 1.5; color: var(--g-text); }
  .j-points li::before { content: ''; position: absolute; left: -20px; top: 0.7em; width: 8px; height: 2px; background: var(--g-orange); }

  /* Photo frame takes the picture's own shape, as large as the screen allows. */
  .j-photo {
    --max-h: calc(100svh - var(--j-top) - 170px);
    margin: 0; justify-self: center; align-self: center;
    width: min(100%, calc(var(--max-h) * var(--ar)));
    aspect-ratio: var(--ar);
    border-radius: 16px; overflow: hidden; background: #eef2f6;
    box-shadow: 0 20px 44px rgba(15, 42, 61, 0.16);
  }
  .j-photo img { width: 100%; height: 100%; object-fit: cover; display: block; }
  /* Slideshow: photos sit on top of each other and fade from one to the next. */
  .j-slides { position: relative; --max-h: min(calc(100svh - var(--j-top) - 170px), 460px); }
  .j-slides img { position: absolute; inset: 0; opacity: 0; transition: opacity 0.9s ease; }
  .j-slides img.is-on { opacity: 1; }
  .j-slide-dots { position: absolute; left: 0; right: 0; bottom: 12px; display: flex; justify-content: center; gap: 6px; }
  .j-slide-dots span { width: 7px; height: 7px; border-radius: 50%; background: rgba(255, 255, 255, 0.55); transition: background 0.3s, transform 0.3s; }
  .j-slide-dots span.is-on { background: #fff; transform: scale(1.25); }
  .journey:not(.is-live) .j-slide-dots { display: none; }
  /* Two photos side by side; one of them changes at a time. */
  .j-pair {
    --max-h: min(calc(100svh - var(--j-top) - 170px), 460px);
    margin: 0; justify-self: center; align-self: center;
    width: min(100%, calc(var(--max-h) * var(--ar)));
    aspect-ratio: var(--ar);
    display: grid; grid-template-columns: 1fr 1fr; gap: 12px;
  }
  .j-pair .j-photo { width: 100%; height: 100%; aspect-ratio: auto; }
  .j-photo--plain { background: none; box-shadow: none; border-radius: 0; overflow: visible; }
  .j-photo--plain img { object-fit: contain; }
  /* Laptop carousel: one laptop per app screen (slides + laptop in about.ts). The front one
     comes forward; the others turn away on either side, and they swap round every few seconds. */
  .j-laptops { position: relative; perspective: 1400px; }
  .j-laptop {
    all: unset; box-sizing: border-box; cursor: pointer;
    position: absolute; left: 10%; top: 0; width: 80%; aspect-ratio: 1.85;
    display: flex; flex-direction: column; align-items: center; justify-content: flex-end;
    transform-style: preserve-3d; transform-origin: 50% 60%;
    transition: transform 1s cubic-bezier(0.22, 1, 0.36, 1), opacity 1s ease, filter 1s ease;
  }
  .j-laptop:focus-visible { outline: 2px solid var(--g-orange); outline-offset: 4px; border-radius: 10px; }
  .j-laptop[data-pos='0'] { z-index: 3; transform: none; }
  .j-laptop[data-pos='1'] { z-index: 1; transform: translate(40%, -9%) scale(0.6) rotateY(-34deg); opacity: 0.8; filter: saturate(0.85) brightness(0.96); }
  .j-laptop[data-pos='2'] { z-index: 1; transform: translate(-40%, -9%) scale(0.6) rotateY(34deg); opacity: 0.8; filter: saturate(0.85) brightness(0.96); }
  .j-laptop[data-pos='0'] { cursor: default; }
  /* Phone carousel: the same idea with iPhone-style frames (slides + phone in about.ts). */
  .j-phone {
    all: unset; box-sizing: border-box; cursor: pointer;
    position: absolute; left: 33%; top: 0; width: 34%; aspect-ratio: 0.5;
    padding: 1.8%; border-radius: 13% / 6.5%;
    background: #0f141a;
    /* thin black bezel + a slim titanium edge, like a current iPhone */
    box-shadow: 0 0 0 1.5px #9aa3ad, 0 0 0 2.5px #5d6672, 0 22px 40px rgba(15, 42, 61, 0.24);
    transform-origin: 50% 50%;
    transition: transform 1s cubic-bezier(0.22, 1, 0.36, 1), opacity 1s ease, filter 1s ease;
  }
  .j-phone:focus-visible { outline: 2px solid var(--g-orange); outline-offset: 4px; }
  .j-phone[data-pos='0'] { z-index: 3; transform: none; cursor: default; }
  .j-phone[data-pos='1'] { z-index: 1; transform: translate(92%, 4%) scale(0.8) rotateY(-30deg) rotateZ(4deg); opacity: 0.85; filter: saturate(0.85) brightness(0.96); }
  .j-phone[data-pos='2'] { z-index: 1; transform: translate(-92%, 4%) scale(0.8) rotateY(30deg) rotateZ(-4deg); opacity: 0.85; filter: saturate(0.85) brightness(0.96); }
  .j-phone-screen { position: relative; display: block; width: 100%; height: 100%; overflow: hidden; border-radius: 11.5% / 5.6%; background: #fff; }
  .j-phone-screen img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: center top; }
  .j-phone-island { position: absolute; left: 50%; top: 1.6%; width: 28%; height: 2.9%; transform: translateX(-50%); border-radius: 99px; background: #0d1319; z-index: 2; }
  .j-phones .j-laptops-cap { bottom: -2px; }
  .j-laptop-lid {
    width: 88%; padding: 2.2% 2.2% 2.6%; box-sizing: border-box;
    background: #1d2733; border-radius: 14px 14px 4px 4px;
    box-shadow: 0 18px 40px rgba(15, 42, 61, 0.22), inset 0 0 0 1px rgba(255, 255, 255, 0.06);
  }
  .j-laptop-screen { position: relative; display: block; aspect-ratio: 16 / 9; overflow: hidden; border-radius: 3px; background: #f4f6f9; }
  .j-laptop-screen img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: left top; }
  .j-laptop-glare { position: absolute; inset: 0; background: linear-gradient(115deg, rgba(255, 255, 255, 0.28) 0%, rgba(255, 255, 255, 0) 38%); pointer-events: none; }
  .j-laptop-base {
    display: block; width: 100%; height: 0; padding-bottom: 2.8%; position: relative;
    background: linear-gradient(#d9dee5, #aab3bf); border-radius: 0 0 14px 14px / 0 0 60% 60%;
    box-shadow: 0 10px 18px rgba(15, 42, 61, 0.16);
  }
  .j-laptop-base::before { content: ''; position: absolute; left: 50%; top: 0; width: 14%; height: 40%; transform: translateX(-50%); background: #c3cad3; border-radius: 0 0 8px 8px; }
  .j-laptops-floor { position: absolute; left: 6%; right: 6%; top: calc(80% / 1.85 * 2.05 - 2%); height: 16px; border-radius: 50%; background: radial-gradient(closest-side, rgba(15, 42, 61, 0.18), transparent); z-index: 0; }
  .j-laptops-cap { position: absolute; left: 0; right: 0; bottom: 0; height: 1.4em; text-align: center; font-size: 13px; font-weight: 600; letter-spacing: 0.02em; color: var(--g-ink); }
  .j-laptops-cap span { position: absolute; inset: 0; opacity: 0; transform: translateY(6px); transition: opacity 0.6s ease, transform 0.6s ease; }
  .j-laptops-cap span.is-on { opacity: 1; transform: none; }
  .j-people { list-style: none; margin: clamp(16px, 3vh, 28px) 0 0; padding: 0; display: flex; flex-wrap: wrap; gap: 14px 28px; }
  .j-people li { display: flex; flex-direction: column; align-items: center; gap: 10px; width: 170px; text-align: center; }
  .j-people img { width: 96px; height: 96px; border-radius: 50%; object-fit: cover; object-position: top; border: 3px solid #fff; box-shadow: 0 4px 14px rgba(15, 42, 61, 0.18); flex: none; }
  .j-people span { display: flex; flex-direction: column; gap: 2px; font-size: 13px; color: var(--g-text); line-height: 1.35; }
  .j-people strong { color: var(--g-ink); font-size: 14px; font-weight: 600; }
  /* A year with people but no photo: show the people large on the right. */
  .j-step.no-photo .j-copy { grid-column: 1 / -1; }
  @media (min-width: 769px) {
    .j-step.no-photo .j-people { gap: 28px 56px; margin-top: clamp(24px, 4vh, 44px); }
    .j-step.no-photo .j-people li { width: clamp(170px, 14vw, 210px); gap: 14px; }
    .j-step.no-photo .j-people img { width: clamp(120px, 11vw, 170px); height: auto; aspect-ratio: 1; border-width: 4px; }
    .j-step.no-photo .j-people strong { font-size: 16px; }
    .j-step.no-photo .j-people span { font-size: 14px; }
  }

  /* ---------- A year with two events (parts in about.ts): side by side, split by a line ---------- */
  .j-part { display: contents; }
  .j-step.has-parts { padding-top: calc(var(--j-yf) + clamp(14px, 2.4vh, 28px)); }
  .j-step.has-parts .j-copy { padding-top: 0; }
  .j-step.has-parts .j-people li { flex-direction: row; width: auto; text-align: left; gap: 16px; }
  @media (min-width: 769px) {
    .j-step.has-parts { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 0; align-items: stretch; }
    .j-step.has-parts .j-part { display: flex; flex-direction: column; gap: clamp(14px, 2.4vh, 24px); padding-right: clamp(24px, 3.5vw, 56px); }
    .j-step.has-parts .j-part + .j-part {
      position: relative; padding-right: 0; padding-left: clamp(24px, 3.5vw, 56px);
      border-left: 1px solid var(--j-line);
    }
    .j-step.has-parts .j-part + .j-part::before {
      content: ''; position: absolute; left: -6px; top: 12px; width: 11px; height: 11px; border-radius: 50%; background: var(--g-orange);
    }
    .j-step.has-parts .j-people { margin-top: clamp(14px, 2.6vh, 26px); padding-left: 58px; }
    .j-step.has-parts .j-people img { width: clamp(110px, 9vw, 140px); height: auto; aspect-ratio: 1; border-width: 4px; }
    .j-step.has-parts .j-people span { font-size: 14px; }
    .j-step.has-parts .j-people strong { font-size: 16px; }
    .j-step.has-parts .j-photo { --max-h: clamp(150px, 30svh, 260px); justify-self: start; align-self: flex-start; margin-left: 58px; margin-top: auto; width: min(calc(100% - 58px), calc(var(--max-h) * var(--ar))); }
    .j-step.has-parts .j-phones { --max-h: clamp(260px, 46svh, 400px); }
    .j-step.has-parts .j-laptops { margin-bottom: auto; }
    .j-step.has-parts .j-map { --max-h: clamp(220px, 40svh, 340px); }
  }

  /* ---------- Without JS: a plain list of milestones ---------- */
  .journey:not(.is-live) .j-rail,
  .journey:not(.is-live) .j-year { display: none; }
  .journey:not(.is-live) .j-inner { padding-bottom: var(--section-y); }
  .journey:not(.is-live) .j-steps { gap: 48px; }
  .journey:not(.is-live) .j-step { grid-area: auto; }
  .journey:not(.is-live) .j-copy,
  .journey:not(.is-live) .j-step.has-parts { padding-top: 0; }
  .journey:not(.is-live) .j-step-year { display: block; margin: 0 0 10px; font-size: 38px; font-weight: 700; color: var(--g-blue); line-height: 1; }

  /* ---------- Interactive mode (JS on): one year at a time, page scrolls normally ---------- */
  .j-nav { display: none; }
  .journey.is-live .j-nav { display: flex; gap: 10px; margin-left: clamp(16px, 2vw, 28px); align-self: center; letter-spacing: 0; }
  .j-arrow {
    width: 44px; height: 44px; border-radius: 50%; display: grid; place-items: center; cursor: pointer;
    background: #fff; color: var(--g-blue); border: 1.5px solid #d5e0e9;
    transition: background 0.2s, color 0.2s, border-color 0.2s;
  }
  .j-arrow:hover:not(:disabled) { background: var(--g-blue); border-color: var(--g-blue); color: #fff; }
  .j-arrow:disabled { opacity: 0.4; cursor: default; }
  .j-arrow:focus-visible { outline: 2px solid var(--g-orange); outline-offset: 3px; }
  .journey.is-live .j-stage { touch-action: pan-y; }
  .journey.is-live .j-step {
    opacity: 0; visibility: hidden; pointer-events: none;
    transform: translateY(var(--j-from, 36px));
    transition: opacity 0.45s ease, transform 0.6s cubic-bezier(0.22, 1, 0.36, 1), visibility 0s linear 0.6s;
  }
  .journey.is-live .j-step .j-photo { transform: scale(0.94); transition: transform 0.7s cubic-bezier(0.22, 1, 0.36, 1); }
  .journey.is-live .j-step.is-active {
    opacity: 1; visibility: visible; pointer-events: auto; transform: none;
    transition: opacity 0.5s ease 0.1s, transform 0.7s cubic-bezier(0.22, 1, 0.36, 1) 0.1s, visibility 0s;
  }
  .journey.is-live .j-step.is-active .j-photo { transform: none; }
  .journey.is-live.is-back .j-step { --j-from: -36px; }
  .journey.is-live .j-step.is-active .j-points li,
  .journey.is-live .j-step.is-active .j-people li { animation: j-rise 0.6s cubic-bezier(0.22, 1, 0.36, 1) both; }
  .journey.is-live .j-step.is-active .j-points li:nth-child(2),
  .journey.is-live .j-step.is-active .j-people li:nth-child(2) { animation-delay: 0.12s; }
  .journey.is-live .j-step.is-active .j-points li:nth-child(3) { animation-delay: 0.24s; }
  @keyframes j-rise { from { opacity: 0; transform: translateY(14px); } to { opacity: 1; transform: none; } }

  @media (max-width: 768px) {
    .journey { --j-yf: clamp(44px, 12vw, 60px); }
    .j-inner { padding-top: 18px; padding-bottom: 18px; }
    .j-rail { margin-bottom: 18px; }
    .j-rail-year { font-size: 11px; }
    .j-dot { width: 16px; height: 16px; }
    .j-dot::after { width: 6px; height: 6px; }
    .j-rail-line { top: 7px; }
    /* Many years: the rail scrolls sideways on phones and follows the year shown. */
    .j-rail { overflow-x: auto; scrollbar-width: none; margin-left: -16px; margin-right: -16px; padding: 0 16px 4px; }
    .j-rail::-webkit-scrollbar { display: none; }
    .j-rail-in { width: max-content; min-width: 100%; }
    .j-rail ol { gap: 22px; }
    /* No room for the "03 / 13" counter beside a year range on phones. */
    .j-year:has(.j-until:not(:empty)) .j-count { visibility: hidden; }
    .j-rail button { gap: 6px; }
    .j-count { margin-left: auto; align-self: center; }
    .journey.is-live .j-nav { margin-left: 12px; gap: 8px; }
    .j-arrow { width: 38px; height: 38px; }
    .j-year { right: 0; }
    .j-step { grid-template-columns: minmax(0, 1fr); gap: 14px; align-items: start; }
    .j-copy { padding-top: calc(var(--j-yf) + 12px); }
    .j-step h3 { font-size: 17px; gap: 12px; align-items: center; }
    .j-icon { width: 34px; height: 34px; margin-top: 0; }
    .j-icon svg { width: 18px; height: 18px; }
    .j-points { padding-left: 46px; margin-top: 8px; gap: 3px; }
    .j-text { padding-left: 46px; margin-top: 8px; font-size: 13.5px; line-height: 1.45; }
    .j-points li { font-size: 13.5px; line-height: 1.4; }
    .j-points li::before { left: -18px; }
    .j-photo { --max-h: 26svh; border-radius: 12px; }
    .j-slides, .j-pair { --max-h: 32svh; }
    .j-people { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 10px; margin-top: 14px; }
    .j-people li { width: auto; gap: 8px; }
    .j-people img { width: 64px; height: 64px; border-width: 2px; }
    .j-people span { font-size: 11.5px; }
    .j-people strong { font-size: 13px; }
    .j-step.has-parts { padding-top: calc(var(--j-yf) + 12px); }
    .j-step.has-parts { gap: 0; }
    .j-step.has-parts .j-part { display: grid; grid-template-columns: minmax(0, 1fr); gap: 12px; }
    .j-step.has-parts .j-part + .j-part { position: relative; margin-top: 14px; padding-top: 14px; border-top: 1px solid var(--j-line); }
    .j-step.has-parts .j-part + .j-part::before { content: ''; position: absolute; top: -5px; left: 12px; width: 10px; height: 10px; border-radius: 50%; background: var(--g-orange); }
    .j-step.has-parts .j-people { display: flex; padding-left: 46px; margin-top: 10px; }
    .j-step.has-parts .j-people img { width: 60px; height: 60px; }
    .j-step.has-parts .j-people span { font-size: 12px; }
    .j-step.has-parts .j-people strong { font-size: 13.5px; }
    .j-step.has-parts .j-photo { --max-h: 19svh; justify-self: center; }
    .j-step.has-parts .j-photo--plain { --max-h: 150px; }
    .j-step.has-parts .j-phones { --max-h: 30svh; }
    .j-step.has-parts .j-map { --max-h: 230px; }
    .journey:not(.is-live) .j-steps { gap: 36px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .j-digit-strip, .j-rail-fill, .journey.is-live .j-step, .journey.is-live .j-step .j-photo { transition: none !important; }
    .journey.is-live .j-step.is-active .j-points li,
    .journey.is-live .j-step.is-active .j-people li { animation: none; }
  }
</style>

<script>
  function initJourney(root: HTMLElement) {
    const steps = Array.from(root.querySelectorAll<HTMLElement>('[data-j-step]'));
    const dots = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-j-go]'));
    const digits = Array.from(root.querySelectorAll<HTMLElement>('.j-digit'));
    const fill = root.querySelector<HTMLElement>('[data-j-fill]')!;
    const count = root.querySelector<HTMLElement>('[data-j-count]')!;
    const prev = root.querySelector<HTMLButtonElement>('[data-j-prev]')!;
    const next = root.querySelector<HTMLButtonElement>('[data-j-next]')!;
    const stage = root.querySelector<HTMLElement>('.j-stage')!;
    const rail = root.querySelector<HTMLElement>('.j-rail')!;
    const until = root.querySelector<HTMLElement>('[data-j-until]')!;
    const n = steps.length;
    let current = -1;

    root.classList.add('is-live');

    // Words marked [[like this]] in about.ts type themselves in each time their year is shown.
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    // A year can have more than one (e.g. two events side by side): they all type at once.
    let typeTimers: number[] = [];
    function typeIn(step: HTMLElement) {
      typeTimers.forEach((t) => { window.clearInterval(t); window.clearTimeout(t); });
      typeTimers = [];
      root.querySelectorAll('.j-type.is-typing').forEach((el) => el.classList.remove('is-typing'));
      if (reduceMotion) return;
      step.querySelectorAll<HTMLElement>('.j-type').forEach((el) => {
        const word = el.dataset.type || '';
        const typed = el.querySelector<HTMLElement>('.j-typed')!;
        let k = 0;
        typed.textContent = '';
        el.classList.add('is-typing');
        typeTimers.push(window.setTimeout(() => {
          const t = window.setInterval(() => {
            k += 1;
            typed.textContent = word.slice(0, k);
            if (k >= word.length) {
              window.clearInterval(t);
              typeTimers.push(window.setTimeout(() => el.classList.remove('is-typing'), 900));
            }
          }, 110);
          typeTimers.push(t);
        }, 450));
      });
    }

    // Slideshows rotate every 2.6s while their year is the one shown.
    root.querySelectorAll<HTMLElement>('[data-j-slides]').forEach((fig) => {
      const imgs = Array.from(fig.querySelectorAll('img'));
      const marks = Array.from(fig.querySelectorAll('.j-slide-dots span'));
      const step = fig.closest('.j-step');
      let k = 0;
      if (imgs.length < 2 || reduceMotion) return;
      window.setInterval(() => {
        if (!step?.classList.contains('is-active') || document.hidden) return;
        k = (k + 1) % imgs.length;
        imgs.forEach((im, n) => im.classList.toggle('is-on', n === k));
        marks.forEach((d, n) => d.classList.toggle('is-on', n === k));
      }, 2600);
    });

    // Laptop / phone carousel: every 3.2s the next device comes to the front; a click on a side one brings it forward.
    root.querySelectorAll<HTMLElement>('[data-j-laptops]').forEach((fig) => {
      const tops = Array.from(fig.querySelectorAll<HTMLElement>('.j-dev'));
      const caps = Array.from(fig.querySelectorAll('.j-laptops-cap span'));
      const step = fig.closest('.j-step');
      const n = tops.length;
      let front = 0;
      const place = (k: number) => {
        front = (k + n) % n;
        tops.forEach((t, i) => (t.dataset.pos = String((i - front + n) % n)));
        caps.forEach((c, i) => c.classList.toggle('is-on', i === front));
      };
      tops.forEach((t, i) => t.addEventListener('click', () => place(i)));
      if (n < 2 || reduceMotion) return;
      window.setInterval(() => {
        if (!step?.classList.contains('is-active') || document.hidden || fig.matches(':hover')) return;
        place(front + 1);
      }, 3200);
    });

    // Side-by-side pairs: every 2.6s the photo that has been up longer swaps
    // for the one not shown, so 3 photos cycle through 2 frames.
    root.querySelectorAll<HTMLElement>('[data-j-pair]').forEach((fig) => {
      const frames = Array.from(fig.querySelectorAll<HTMLElement>('.j-slides')).map((f) => Array.from(f.querySelectorAll('img')));
      const step = fig.closest('.j-step');
      const total = frames[0]?.length ?? 0;
      if (frames.length < 2 || total < 3 || reduceMotion) return;
      const on = [0, 1];
      let turn = 0;
      window.setInterval(() => {
        if (!step?.classList.contains('is-active') || document.hidden) return;
        let nx = (Math.max(...on) + 1) % total;
        while (on.includes(nx)) nx = (nx + 1) % total;
        on[turn] = nx;
        frames[turn].forEach((im, n) => im.classList.toggle('is-on', n === nx));
        turn = 1 - turn;
      }, 2600);
    });

    function show(i: number) {
      i = Math.min(n - 1, Math.max(0, i));
      if (i === current) return;
      root.classList.toggle('is-back', i < current);
      current = i;
      steps.forEach((s, k) => s.classList.toggle('is-active', k === i));
      dots.forEach((d, k) => {
        if (k === i) d.setAttribute('aria-current', 'step');
        else d.removeAttribute('aria-current');
        d.classList.toggle('is-past', k < i);
      });
      const year = steps[i].dataset.year || '';
      year.split('').forEach((ch, k) => digits[k]?.style.setProperty('--d', ch));
      const end = steps[i].dataset.until;
      until.textContent = end ? `–${end}` : '';
      // Keep the year shown in view when the rail scrolls (phones).
      if (rail.scrollWidth > rail.clientWidth) {
        const b = dots[i];
        rail.scrollTo({ left: b.offsetLeft + b.offsetWidth / 2 - rail.clientWidth / 2, behavior: reduceMotion ? 'auto' : 'smooth' });
      }
      fill.style.setProperty('--p', String(n > 1 ? i / (n - 1) : 1));
      count.textContent = String(i + 1).padStart(2, '0');
      typeIn(steps[i]);
      steps[i].dispatchEvent(new CustomEvent('j-show'));
      prev.disabled = i === 0;
      next.disabled = i === n - 1;
    }

    // Plays through the years on its own while in view; stops for good once the visitor takes over.
    let timer = 0;
    let userTookOver = false;
    const stopAuto = () => { window.clearInterval(timer); timer = 0; };
    const takeOver = () => { userTookOver = true; stopAuto(); };
    const startAuto = () => {
      if (userTookOver || timer) return;
      timer = window.setInterval(() => {
        if (current >= n - 1) { stopAuto(); return; }
        show(current + 1);
      }, 4500);
    };

    dots.forEach((d) => d.addEventListener('click', () => { takeOver(); show(Number(d.dataset.jGo)); }));
    prev.addEventListener('click', () => { takeOver(); show(current - 1); });
    next.addEventListener('click', () => { takeOver(); show(current + 1); });
    root.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowLeft') { takeOver(); show(current - 1); }
      if (e.key === 'ArrowRight') { takeOver(); show(current + 1); }
    });

    // Swipe left/right on the milestone (phones).
    let sx = 0, sy = 0;
    stage.addEventListener('touchstart', (e) => { sx = e.touches[0].clientX; sy = e.touches[0].clientY; }, { passive: true });
    stage.addEventListener('touchend', (e) => {
      const dx = e.changedTouches[0].clientX - sx;
      const dy = e.changedTouches[0].clientY - sy;
      if (Math.abs(dx) > 50 && Math.abs(dx) > Math.abs(dy) * 1.5) { takeOver(); show(current + (dx < 0 ? 1 : -1)); }
    }, { passive: true });

    show(0);

    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (!reduce && 'IntersectionObserver' in window) {
      new IntersectionObserver((entries) => {
        entries.forEach((e) => (e.isIntersecting ? startAuto() : stopAuto()));
      }, { threshold: 0.5 }).observe(stage);
    }
  }

  document.querySelectorAll<HTMLElement>('[data-journey]').forEach(initJourney);
</script>
