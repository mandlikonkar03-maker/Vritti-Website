---
import type { Story } from '../../data/home';

interface Props {
  story: Story;
  /** The wider card of a pair (790 vs 695 in the design). */
  wide?: boolean;
}
const { story, wide = false } = Astro.props;
const Tag = story.href ? 'a' : 'article';
---
<Tag class:list={['story', { 'story--wide': wide }]} href={story.href}>
  <img src={story.image} alt={story.alt} loading="lazy" />
  <div class="story-body">
    <h3 class:list={{ upper: story.upper }}>{story.title}</h3>
    <span class="story-more">Read more <span aria-hidden="true">→</span></span>
  </div>
</Tag>

<style>
  .story {
    position: relative;
    flex: 695 1 0;
    aspect-ratio: 695 / 526;
    background: #000;
    color: #fff;
    text-decoration: none;
    overflow: hidden;
    display: block;
  }
  .story--wide { flex-grow: 790; aspect-ratio: 790 / 526; }
  .story img {
    position: absolute;
    inset: 0 0 auto 0;
    width: 100%;
    height: 80%;
    object-fit: cover;
    object-position: top center;
    transition: transform 0.4s;
  }
  .story::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(to bottom, rgba(0, 0, 0, 0) 35%, rgba(0, 0, 0, 0.8) 64%, #000 78%);
  }
  a.story:hover img { transform: scale(1.03); }
  .story-body {
    position: absolute;
    z-index: 1;
    left: 7.3%;
    right: 6%;
    bottom: 10%;
  }
  .story h3 {
    font-size: clamp(16px, 1.65vw, 27px);
    font-weight: 500;
    line-height: 1.08;
  }
  .story h3.upper { text-transform: uppercase; }
  .story-more {
    display: inline-block;
    margin-top: 10px;
    font-size: clamp(13px, 1.35vw, 22px);
    font-weight: 500;
    text-transform: uppercase;
  }
  @media (max-width: 900px) {
    .story, .story--wide { flex: none; width: 100%; aspect-ratio: 4 / 3; }
  }
</style>
