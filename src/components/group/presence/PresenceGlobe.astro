---
// Option C: navy band with a slowly turning dotted 3D globe (canvas) beside counters and the city list.
import { presenceNew as p } from '../../../data/presence';
const pins = p.locations.map((l) => ({ lat: l.lat, lon: l.lon, hq: !!l.hq }));
---
<section class="pg" id="presence-c">
  <div class="g-container pg-grid">
    <div class="pg-copy">
      <h2 class="pg-title">{p.title}</h2>
      <p class="pg-sub">{p.subtitle}</p>
      <p class="pg-intro">{p.intro}</p>
      <ul class="pg-stats">
        {p.stats.map((s) => (
          <li><span class="pg-num" data-count={s.value} data-suffix={s.suffix}>{s.value}{s.suffix}</span><span class="pg-lbl">{s.label}</span></li>
        ))}
      </ul>
      <ul class="pg-cities">
        {p.locations.map((l) => <li class:list={[l.hq && 'is-hq']}><span></span>{l.city}<small>{l.hq ? 'HQ' : l.country}</small></li>)}
      </ul>
    </div>
    <div class="pg-globe-wrap">
      <canvas class="pg-globe" data-pins={JSON.stringify(pins)} aria-label="Globe showing Vritti offices in India and the Middle East" role="img"></canvas>
    </div>
  </div>
</section>

<script>
  const rad = Math.PI / 180;
  document.querySelectorAll<HTMLCanvasElement>('.pg-globe').forEach(async (cv) => {
    const root = cv.closest<HTMLElement>('.pg')!;
    const pins: { lat: number; lon: number; hq: boolean }[] = JSON.parse(cv.dataset.pins!);
    const raw: number[] = await fetch('/images/home/presence/globe-points.json').then((r) => r.json());
    const ctx = cv.getContext('2d')!;
    const still = matchMedia('(prefers-reduced-motion: reduce)').matches;
    let size = 0, dpr = 1, visible = false;
    const fit = () => {
      dpr = Math.min(devicePixelRatio || 1, 2);
      size = cv.clientWidth;
      cv.width = cv.height = size * dpr;
    };
    fit();
    addEventListener('resize', fit);
    const tilt = 18 * rad; // look slightly down on the northern hemisphere
    const project = (lon: number, lat: number, lon0: number) => {
      const l = (lon - lon0) * rad, f = lat * rad;
      const cosc = Math.sin(tilt) * Math.sin(f) + Math.cos(tilt) * Math.cos(f) * Math.cos(l);
      return {
        x: Math.cos(f) * Math.sin(l),
        y: Math.cos(tilt) * Math.sin(f) - Math.sin(tilt) * Math.cos(f) * Math.cos(l),
        z: cosc,
      };
    };
    const draw = (t: number) => {
      const lon0 = 66 + (still ? 0 : Math.sin(t / 6000) * 38);
      const r = (size * dpr) / 2 - 6 * dpr, c = (size * dpr) / 2;
      ctx.clearRect(0, 0, cv.width, cv.height);
      // Globe body
      const g = ctx.createRadialGradient(c - r * 0.35, c - r * 0.4, r * 0.1, c, c, r);
      g.addColorStop(0, '#1f5f9e');
      g.addColorStop(1, '#0a2747');
      ctx.fillStyle = g;
      ctx.beginPath(); ctx.arc(c, c, r, 0, Math.PI * 2); ctx.fill();
      ctx.strokeStyle = 'rgba(140,190,240,.35)'; ctx.lineWidth = 1 * dpr; ctx.stroke();
      // Land dots
      for (let i = 0; i < raw.length; i += 2) {
        const p = project(raw[i] / 10, raw[i + 1] / 10, lon0);
        if (p.z <= 0) continue;
        ctx.fillStyle = `rgba(190,220,250,${0.25 + p.z * 0.6})`;
        const s = (1.1 + p.z * 0.9) * dpr;
        ctx.fillRect(c + p.x * r - s / 2, c - p.y * r - s / 2, s, s);
      }
      // Pins with a pulse
      const hq = pins.find((p) => p.hq)!;
      const hp = project(hq.lon, hq.lat, lon0);
      pins.forEach((pin, i) => {
        const p = project(pin.lon, pin.lat, lon0);
        if (p.z <= 0.05) return;
        const x = c + p.x * r, y = c - p.y * r;
        if (!pin.hq && hp.z > 0) {
          // arc from HQ, lifted toward the viewer
          const hx = c + hp.x * r, hy = c - hp.y * r;
          const mx = (hx + x) / 2, my = (hy + y) / 2 - Math.hypot(x - hx, y - hy) * 0.5;
          ctx.strokeStyle = 'rgba(235,158,46,.75)'; ctx.lineWidth = 1.4 * dpr;
          ctx.beginPath(); ctx.moveTo(hx, hy); ctx.quadraticCurveTo(mx, my, x, y); ctx.stroke();
        }
        const k = still ? 0 : ((t / 1800 + i * 0.17) % 1);
        ctx.fillStyle = `rgba(235,158,46,${0.5 * (1 - k)})`;
        ctx.beginPath(); ctx.arc(x, y, (4 + k * 14) * dpr, 0, Math.PI * 2); ctx.fill();
        ctx.fillStyle = pin.hq ? '#fff' : '#eb9e2e';
        ctx.beginPath(); ctx.arc(x, y, (pin.hq ? 5 : 3.6) * dpr, 0, Math.PI * 2); ctx.fill();
      });
    };
    const loop = (t: number) => { if (visible) draw(t); if (!still) requestAnimationFrame(loop); };
    new IntersectionObserver((e) => {
      visible = e[0].isIntersecting;
      if (visible && !root.classList.contains('is-in')) {
        root.classList.add('is-in');
        if (!still) root.querySelectorAll<HTMLElement>('[data-count]').forEach((n) => {
          const end = +n.dataset.count!, sfx = n.dataset.suffix ?? '', t0 = performance.now();
          const tick = (t: number) => {
            const k = Math.min((t - t0) / 1400, 1);
            n.textContent = Math.round(end * (1 - Math.pow(1 - k, 3))) + sfx;
            if (k < 1) requestAnimationFrame(tick);
          };
          requestAnimationFrame(tick);
        });
      }
      if (still && visible) draw(0);
    }).observe(cv);
    requestAnimationFrame(loop);
  });
</script>

<style>
  .pg { background: radial-gradient(ellipse at 75% 50%, #134b82 0%, #0b2a4a 60%, #081d34 100%); color: #fff; padding: clamp(56px, 6vw, 96px) 0; overflow: hidden; }
  .pg-grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: clamp(28px, 4vw, 64px); align-items: center; }
  .pg-title { margin: 0; font-weight: 700; text-transform: uppercase; font-size: clamp(26px, 2.9vw, 48px); line-height: 1.1; }
  .pg-sub { margin: 6px 0 0; text-transform: uppercase; font-weight: 500; color: var(--g-orange); letter-spacing: .02em; }
  .pg-intro { margin: 22px 0 0; color: rgba(255,255,255,.8); line-height: 1.6; max-width: 480px; }
  .pg-stats { list-style: none; margin: 32px 0 0; padding: 0; display: grid; grid-template-columns: repeat(4, auto); justify-content: start; gap: 0 clamp(20px, 3vw, 44px); }
  .pg-num { display: block; font-size: clamp(32px, 3.4vw, 50px); font-weight: 800; line-height: 1.05; }
  .pg-lbl { font-size: 12px; letter-spacing: .1em; text-transform: uppercase; color: rgba(255,255,255,.7); }
  .pg-cities { list-style: none; margin: 32px 0 0; padding: 0; display: grid; grid-template-columns: repeat(2, minmax(0, 220px)); gap: 10px 24px; }
  .pg-cities li { display: flex; align-items: center; gap: 10px; font-weight: 600; padding: 8px 0; border-bottom: 1px solid rgba(255,255,255,.14); }
  .pg-cities li span { width: 8px; height: 8px; border-radius: 50%; background: var(--g-orange); flex: none; }
  .pg-cities li.is-hq span { background: #fff; box-shadow: 0 0 0 3px rgba(255,255,255,.25); }
  .pg-cities small { margin-left: auto; font-weight: 500; font-size: 12px; color: rgba(255,255,255,.6); }
  .pg-globe-wrap { position: relative; max-width: 540px; width: 100%; justify-self: center; }
  .pg-globe-wrap::before { content: ''; position: absolute; inset: -12%; background: radial-gradient(circle, rgba(64,150,230,.35), transparent 62%); pointer-events: none; }
  .pg-globe { position: relative; display: block; width: 100%; aspect-ratio: 1; }
  @media (max-width: 900px) {
    .pg-grid { grid-template-columns: 1fr; }
    .pg-globe-wrap { max-width: 380px; order: -1; }
  }
  @media (max-width: 520px) {
    .pg-stats { grid-template-columns: repeat(2, auto); gap: 16px 40px; }
    .pg-cities { grid-template-columns: 1fr 1fr; }
  }
</style>
