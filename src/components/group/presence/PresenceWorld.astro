---
// Option A: full dotted world map, arcs flying out from the Pune HQ, counters and city chips.
import { presenceNew as p } from '../../../data/presence';
const hq = p.locations.find((l) => l.hq)!;
const W = 1200, H = 460;
const others = p.locations.filter((l) => !l.hq);
// Each arc is a quadratic curve lifted above the straight line between HQ and the city.
const arcs = others.map((l) => {
  const x1 = (hq.world.x / 100) * W, y1 = (hq.world.y / 100) * H;
  const x2 = (l.world.x / 100) * W, y2 = (l.world.y / 100) * H;
  const d = Math.hypot(x2 - x1, y2 - y1);
  const cx = (x1 + x2) / 2, cy = (y1 + y2) / 2 - Math.max(d * 0.6, 14);
  return `M${x1.toFixed(1)} ${y1.toFixed(1)} Q${cx.toFixed(1)} ${cy.toFixed(1)} ${x2.toFixed(1)} ${y2.toFixed(1)}`;
});
---
<section class="g-section pw" id="presence-a">
  <div class="g-container">
    <div class="g-head pw-head">
      <h2 class="g-title">{p.title}</h2>
      <p class="g-sub">{p.subtitle}</p>
    </div>
    <div class="pw-map">
      <img class="pw-dots" src="/images/home/presence/dots-world.svg" alt="" aria-hidden="true" loading="lazy" />
      <svg class="pw-arcs" viewBox={`0 0 ${W} ${H}`} aria-hidden="true">
        {arcs.map((d, i) => <path d={d} pathLength="1" style={`--i:${i}`} />)}
      </svg>
      {p.locations.map((l, i) => (
        <span class:list={['pw-pin', l.hq && 'is-hq']} style={`left:${l.world.x}%;top:${l.world.y}%;--i:${i}`} title={`${l.city}, ${l.country}`}>
          <span class="pw-dot"></span>
        </span>
      ))}
      <div class="pw-callout pw-callout--in" style={`left:${hq.world.x}%;top:${hq.world.y}%`}>
        <strong>India</strong><span>5 cities · HQ Pune</span>
      </div>
      <div class="pw-callout pw-callout--me" style={`left:${others.at(-1)!.world.x}%;top:${others.at(-1)!.world.y}%`}>
        <strong>Middle East</strong><span>Dubai</span>
      </div>
    </div>
    <ul class="pw-stats">
      {p.stats.map((s) => (
        <li><span class="pw-num" data-count={s.value} data-suffix={s.suffix}>{s.value}{s.suffix}</span><span class="pw-lbl">{s.label}</span></li>
      ))}
    </ul>
    <ul class="pw-chips">
      {p.locations.map((l) => <li class:list={[l.hq && 'is-hq']}>{l.city}{l.hq && <em>HQ</em>}</li>)}
    </ul>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLElement>('.pw').forEach((el) => {
    if (!('IntersectionObserver' in window)) return el.classList.add('is-in');
    const io = new IntersectionObserver((e) => {
      if (!e[0].isIntersecting) return;
      io.disconnect();
      el.classList.add('is-in');
      if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
      el.querySelectorAll<HTMLElement>('[data-count]').forEach((n) => {
        const end = +n.dataset.count!, sfx = n.dataset.suffix ?? '', t0 = performance.now();
        const tick = (t: number) => {
          const k = Math.min((t - t0) / 1400, 1);
          n.textContent = Math.round(end * (1 - Math.pow(1 - k, 3))) + sfx;
          if (k < 1) requestAnimationFrame(tick);
        };
        requestAnimationFrame(tick);
      });
    }, { threshold: 0.3 });
    io.observe(el);
  });
</script>

<style>
  .pw-map { position: relative; aspect-ratio: 1200 / 460; margin: 0 auto; }
  .pw-dots { position: absolute; inset: 0; width: 100%; height: 100%; }
  .pw-arcs { position: absolute; inset: 0; width: 100%; height: 100%; overflow: visible; }
  .pw-arcs path {
    fill: none; stroke: var(--g-orange); stroke-width: 1.6; stroke-linecap: round;
    stroke-dasharray: 1; stroke-dashoffset: 1;
    transition: stroke-dashoffset 1.2s cubic-bezier(.4,0,.2,1) calc(0.4s + var(--i) * 0.15s);
  }
  .pw.is-in .pw-arcs path { stroke-dashoffset: 0; }
  .pw-pin { position: absolute; transform: translate(-50%, -50%); }
  .pw-dot {
    display: block; width: 9px; height: 9px; border-radius: 50%;
    background: var(--g-orange); border: 2px solid #fff;
    box-shadow: 0 0 0 0 rgba(235,158,46,.55);
    animation: pw-ping 2.4s calc(var(--i) * .3s) infinite;
  }
  .pw-pin.is-hq .pw-dot { width: 14px; height: 14px; background: var(--g-blue); }
  @keyframes pw-ping { 70% { box-shadow: 0 0 0 12px rgba(235,158,46,0); } 100% { box-shadow: 0 0 0 0 rgba(235,158,46,0); } }
  .pw-callout {
    position: absolute; display: flex; flex-direction: column; gap: 2px;
    background: #fff; border-radius: 10px; padding: 8px 14px;
    box-shadow: 0 8px 24px rgba(6,97,169,.16); font-size: 12px; color: var(--g-text); white-space: nowrap;
    opacity: 0; transition: opacity .5s 1.4s, transform .5s 1.4s;
  }
  .pw-callout strong { color: var(--g-blue); font-size: 14px; }
  .pw-callout--in { transform: translate(24px, 10px); }
  .pw-callout--me { transform: translate(calc(-100% - 22px), -110%); }
  .pw.is-in .pw-callout { opacity: 1; }
  .pw-stats {
    list-style: none; margin: 40px auto 0; padding: 0; max-width: 900px;
    display: grid; grid-template-columns: repeat(4, 1fr);
  }
  .pw-stats li { text-align: center; padding: 6px 12px; border-left: 1px solid #dbe5ef; }
  .pw-stats li:first-child { border-left: 0; }
  .pw-num { display: block; font-size: clamp(32px, 3.4vw, 52px); font-weight: 800; color: var(--g-blue); line-height: 1.1; }
  .pw-lbl { font-size: 13px; font-weight: 600; letter-spacing: .08em; text-transform: uppercase; color: var(--g-text); }
  .pw-chips { list-style: none; margin: 32px 0 0; padding: 0; display: flex; flex-wrap: wrap; justify-content: center; gap: 10px; }
  .pw-chips li {
    padding: 8px 18px; border-radius: 999px; border: 1px solid #cddcec; color: var(--g-blue);
    font-weight: 600; font-size: 14px; display: inline-flex; gap: 8px; align-items: center;
  }
  .pw-chips li.is-hq { background: var(--g-blue); color: #fff; border-color: var(--g-blue); }
  .pw-chips em { font-style: normal; font-size: 10px; background: var(--g-orange); color: #fff; padding: 2px 6px; border-radius: 4px; }
  @media (prefers-reduced-motion: reduce) { .pw-dot { animation: none; } .pw-arcs path, .pw-callout { transition: none; } }
  @media (max-width: 700px) {
    .pw-map { margin: 0 -16px; }
    .pw-callout { font-size: 10px; padding: 5px 9px; }
    .pw-callout strong { font-size: 12px; }
    .pw-callout span { display: none; }
    .pw-stats { grid-template-columns: repeat(2, 1fr); row-gap: 20px; }
    .pw-stats li:nth-child(3) { border-left: 0; }
  }
</style>
