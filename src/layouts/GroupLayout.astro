---
// Layout for Vritti Group pages (home and other group-level pages).
// It has its own header and footer; the Ekatm product pages use BaseLayout.
import GroupHeader from '../components/group/GroupHeader.astro';
import GroupFooter from '../components/group/GroupFooter.astro';
import ScrollReveal from '../components/ScrollReveal.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const { title, description = 'Vritti Group' } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/png" href="/images/favicon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />
    <ScrollReveal />
  </head>
  <body class="group-site">
    <a class="skip-link" href="#main">Skip to content</a>
    <GroupHeader />
    <main id="main">
      <slot />
    </main>
    <slot name="before-footer" />
    <GroupFooter />
  </body>
</html>

<style is:global>
  .group-site {
    --g-blue: #0661a9;
    --g-orange: #eb9e2e;
    --g-text: #5b5b5b;
    --g-ink: #111;
  }
  /* Same content width and side gutters as the Ekatm pages' .container (src/styles/global.css). */
  .g-container {
    width: 100%;
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 24px;
  }
  @media (max-width: 768px) {
    .g-container { padding: 0 16px; }
  }
  .g-head { margin-bottom: 40px; }
  .g-title {
    color: var(--g-blue);
    font-weight: 700;
    text-transform: uppercase;
    font-size: clamp(26px, 2.9vw, 48px);
    line-height: 1.1;
    letter-spacing: 0;
  }
  .g-sub {
    margin: 6px 0 0;
    color: var(--g-text);
    font-weight: 500;
    text-transform: uppercase;
    font-size: clamp(13px, 1.3vw, 22px);
    letter-spacing: 0.01em;
  }
  .g-section { padding: clamp(56px, 6vw, 96px) 0; }
</style>
