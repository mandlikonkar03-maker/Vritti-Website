---
import GroupLayout from '../layouts/GroupLayout.astro';
import { careersHero, careerBusinesses, benefits, testimonials } from '../data/careers';
---
<GroupLayout title="Careers – Vritti Group" description="Your dreams. Fulfilled at Vritti. Careers in technology, media and marketing at Vritti Group.">
  <section class="g-section c-hero">
    <div class="g-container c-hero-grid">
      <div class="c-hero-copy">
        <h1>
          <span class="c-hero-l1">{careersHero.title}</span>
          <span class="c-hero-l2">{careersHero.highlight}</span>
        </h1>
        <p>{careersHero.text}</p>
      </div>
      <div class="c-stage" data-stage>
        <div class="c-stage-inner">
          <div class="c-stage-bg" aria-hidden="true">
            <svg viewBox="0 0 600 600" preserveAspectRatio="none">
              <path class="c-swoosh-blue" d="M70 560 C 170 330, 330 150, 600 60 L 600 170 C 400 230, 260 380, 190 600 Z" />
              <path class="c-swoosh-orange" d="M330 600 C 420 520, 520 470, 600 450 L 600 600 Z" />
            </svg>
          </div>
          <img class="c-person" src={careersHero.person} alt={careersHero.personAlt} width="737" height="1016" fetchpriority="high" />
          <ul class="c-pops" aria-label="Why work at Vritti">
            {careersHero.pops.map((pop, i) => {
              const Tag = pop.href ? 'a' : 'div';
              return (
                <li class={`c-pop c-pop--${pop.pos}`} style={`--i:${i}; --depth:${pop.depth}`}>
                  <Tag class="c-pop-card" href={pop.href}>
                    <span class={`c-pop-icon c-pop-icon--${pop.tone}`} aria-hidden="true">
                      {pop.icon === 'team' && <svg viewBox="0 0 24 24"><circle cx="9" cy="8" r="3.2"/><circle cx="16.5" cy="9" r="2.6"/><path d="M3 19c0-3.3 2.7-5.5 6-5.5s6 2.2 6 5.5z"/><path d="M14.5 14.2c.6-.2 1.3-.3 2-.3 2.6 0 4.5 1.8 4.5 4.6h-5"/></svg>}
                      {pop.icon === 'bag' && <svg viewBox="0 0 24 24"><rect x="3" y="7" width="18" height="13" rx="2.5"/><path d="M9 7V5.5A1.5 1.5 0 0 1 10.5 4h3A1.5 1.5 0 0 1 15 5.5V7" fill="none" stroke="currentColor" stroke-width="1.8"/></svg>}
                      {pop.icon === 'growth' && <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M3 17l6-6 4 4 8-8"/><path d="M15 7h6v6"/></svg>}
                      {pop.icon === 'book' && <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round"><path d="M3 5.5C5.5 4.5 9 4.5 12 6.5c3-2 6.5-2 9-1V19c-2.5-1-6-1-9 1-3-2-6.5-2-9-1z"/><path d="M12 6.5V20"/></svg>}
                      {pop.icon === 'sprout' && <svg viewBox="0 0 24 24"><path d="M12 21v-8" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"/><path d="M12 13C12 8.5 8.5 6 4 6c0 4.5 3.5 7 8 7z"/><path d="M12 13c0-4.5 3.5-7 8-7 0 4.5-3.5 7-8 7z"/></svg>}
                    </span>
                    <span class="c-pop-text">
                      {pop.big && <strong>{pop.big}</strong>}
                      <span>{pop.label}</span>
                    </span>
                    {pop.href && <span class="c-pop-arrow" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg></span>}
                  </Tag>
                </li>
              );
            })}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <section class="g-section c-biz" id="openings">
    <div class="g-container">
      <h2 class="visually-hidden">Our businesses</h2>
      <div class="c-biz-grid">
        {careerBusinesses.map((b) => (
          <article class="c-biz-card">
            <a class="c-biz-img" href={`/careers/${b.slug}`} tabindex="-1" aria-hidden="true"><img src={b.image} alt="" loading="lazy" /></a>
            <div class="c-biz-foot">
              <div>
                <span class="c-biz-brand">Vritti</span>
                <h3><a class="c-biz-link" href={`/careers/${b.slug}`}>{b.label}</a></h3>
              </div>
              <a class="c-apply" href={`/careers/${b.slug}`} aria-label={`Apply Now: Vritti ${b.label} job openings`}>Apply Now</a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="g-section c-benefits" id="benefits">
    <div class="g-container">
      <div class="g-head">
        <h2 class="g-title">{benefits.title}</h2>
        <p class="g-sub">{benefits.subtitle}</p>
      </div>
      <div class="c-benefit-grid">
        {benefits.items.map((b) => (
          <div class="c-benefit">
            <div class="c-benefit-icon" aria-hidden="true">
              {b.icon === 'life' && (
                <svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M24 5l15 6v11c0 10-6.5 17.5-15 21-8.5-3.5-15-11-15-21V11z"/><path d="M17 24l5 5 9-10"/></svg>
              )}
              {b.icon === 'health' && (
                <svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M24 41S7 31 7 18.5A9.5 9.5 0 0124 13a9.5 9.5 0 0117 5.5C41 31 24 41 24 41z"/><path d="M24 20v11M18.5 25.5h11"/></svg>
              )}
              {b.icon === 'family' && (
                <svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><circle cx="17" cy="12" r="5"/><path d="M8 40V28a9 9 0 0118 0"/><circle cx="33" cy="24" r="4"/><path d="M26 40v-4a7 7 0 0114 0v4"/></svg>
              )}
            </div>
            <h3>{b.title}</h3>
            <p>{b.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="g-section c-testi" id="testimonials">
    <div class="g-container">
      <div class="g-head">
        <h2 class="g-title">{testimonials.title}</h2>
        <p class="g-sub">{testimonials.subtitle}</p>
      </div>
      <div class="c-testi-grid">
        {testimonials.items.map((t) => (
          <figure class="c-testi-card">
            <span class="c-quote" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="currentColor"><path d="M10 7H6.5A2.5 2.5 0 004 9.5V13h4v-.5A2.5 2.5 0 015.5 15v2A4.5 4.5 0 0010 12.5zM20 7h-3.5A2.5 2.5 0 0014 9.5V13h4v-.5a2.5 2.5 0 01-2.5 2.5v2a4.5 4.5 0 004.5-4.5z"/></svg>
            </span>
            <blockquote>{t.quote}</blockquote>
            <figcaption>
              <span class="c-avatar" aria-hidden="true">{t.initials}</span>
              <span>
                <strong>{t.name}</strong>
                <small>{t.role}</small>
              </span>
            </figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>
</GroupLayout>

<style>
  .visually-hidden {
    position: absolute; width: 1px; height: 1px; overflow: hidden;
    clip: rect(0 0 0 0); white-space: nowrap;
  }

  /* Hero */
  .c-hero-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(28px, 4vw, 56px);
    align-items: start;
  }
  .c-hero h1 {
    margin: 0;
    font-size: var(--fs-page-title);
    font-weight: var(--fw-heading);
    line-height: 1.12;
    text-transform: uppercase;
  }
  .c-hero h1 span { display: block; }
  .c-hero-l1 { color: var(--g-ink); }
  .c-hero-l2 { color: var(--g-blue); }
  .c-hero-copy p {
    margin: 20px 0 0;
    max-width: 480px;
    color: #222;
    font-size: var(--fs-body);
    line-height: 1.8;
  }
  /* Hero stage: cut-out photo with "pop-up" cards floating at different depths.
     The stage tilts slightly toward the pointer (JS below sets --rx/--ry); cards float gently. */
  .c-stage { perspective: 1200px; }
  .c-stage-inner {
    position: relative;
    aspect-ratio: 1 / 0.92;
    transform-style: preserve-3d;
    transform: rotateX(var(--rx, 0deg)) rotateY(var(--ry, 0deg));
    transition: transform 0.25s ease-out;
  }
  .c-stage-bg {
    position: absolute; inset: 6% 0 0;
    border-radius: 28px;
    overflow: hidden;
    background: radial-gradient(120% 90% at 30% 20%, #f4f8fc 0%, #e4eff9 55%, #d6e7f6 100%);
    box-shadow: inset 0 0 0 1px rgba(6, 97, 169, 0.06);
  }
  .c-stage-bg svg { width: 100%; height: 100%; display: block; }
  .c-swoosh-blue { fill: var(--g-blue); opacity: 0.85; }
  .c-swoosh-orange { fill: var(--g-orange); opacity: 0.9; }
  .c-person {
    position: absolute; left: 50%; bottom: 0;
    height: 100%; width: auto; max-width: none;
    transform: translateX(-50%);
    filter: drop-shadow(0 24px 30px rgba(15, 42, 61, 0.22));
    pointer-events: none;
  }
  .c-pops { list-style: none; margin: 0; padding: 0; position: absolute; inset: 0; transform-style: preserve-3d; pointer-events: none; }
  .c-pop-card { pointer-events: auto; }
  .c-pop {
    position: absolute;
    transform: translateZ(calc(var(--depth) * 1px));
    animation: c-pop-in 0.6s cubic-bezier(.2, .9, .3, 1.25) both;
    animation-delay: calc(0.25s + var(--i) * 0.12s);
  }
  .c-pop--tl { left: -4%; top: 12%; }
  .c-pop--ml { left: -8%; top: 40%; }
  .c-pop--bl { left: -2%; top: 68%; }
  .c-pop--tr { right: -4%; top: 10%; }
  .c-pop--mr { right: -7%; top: 39%; }
  .c-pop--br { right: -3%; top: 66%; }
  .c-pop-card {
    display: flex; align-items: center; gap: 10px;
    padding: 10px 14px 10px 10px;
    border-radius: 16px;
    background: rgba(255, 255, 255, 0.82);
    -webkit-backdrop-filter: blur(10px);
    backdrop-filter: blur(10px);
    border: 1px solid rgba(255, 255, 255, 0.9);
    box-shadow: 0 18px 36px rgba(15, 42, 61, 0.16), 0 3px 8px rgba(15, 42, 61, 0.08);
    color: var(--g-ink);
    text-decoration: none;
    white-space: nowrap;
    animation: c-float 6s ease-in-out infinite;
    animation-delay: calc(var(--i) * -1.1s);
    transition: box-shadow 0.2s, transform 0.2s;
  }
  a.c-pop-card:hover, a.c-pop-card:focus-visible { box-shadow: 0 24px 44px rgba(6, 97, 169, 0.28); }
  .c-pop-icon {
    flex: none;
    width: 38px; height: 38px;
    display: grid; place-items: center;
    border-radius: 50%;
  }
  .c-pop-icon svg { width: 20px; height: 20px; fill: currentColor; }
  .c-pop-icon--blue { background: #e3eefa; color: var(--g-blue); }
  .c-pop-icon--orange { background: #fdecd6; color: #e98a10; }
  .c-pop-icon--green { background: #e3f4e6; color: #2e9b4a; }
  .c-pop-text { display: flex; flex-direction: column; line-height: 1.15; font-size: 14px; font-weight: 600; }
  .c-pop-text strong { font-size: 20px; font-weight: 700; color: var(--g-ink); }
  .c-pop-text strong + span { font-size: 12px; font-weight: 500; color: #333; }
  .c-pop-arrow {
    width: 26px; height: 26px; margin-left: 4px;
    display: grid; place-items: center;
    border-radius: 50%;
    background: var(--g-orange); color: #fff;
  }
  .c-pop-arrow svg { width: 14px; height: 14px; }

  @keyframes c-pop-in {
    from { opacity: 0; transform: translateZ(calc(var(--depth) * 1px)) translateY(18px) scale(0.85); }
    to { opacity: 1; transform: translateZ(calc(var(--depth) * 1px)); }
  }
  @keyframes c-float {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-8px); }
  }
  @media (prefers-reduced-motion: reduce) {
    .c-pop, .c-pop-card { animation: none; }
    .c-stage-inner { transform: none; }
  }

  .c-placeholder {
    display: block;
    width: 100%;
    aspect-ratio: 5 / 3;
    object-fit: cover;
    border-radius: 4px;
  }
  .c-placeholder { background: #d9d9d9; }

  /* Business cards */
  .c-biz { padding-top: 0; }
  .c-biz-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: clamp(16px, 3vw, 40px);
  }
  .c-biz-card {
    position: relative;
    aspect-ratio: 4 / 3;
    border-radius: 6px;
    overflow: hidden;
    background: #e9e9e9;
  }
  .c-biz-card img {
    position: absolute; inset: 0;
    width: 100%; height: 100%;
    object-fit: cover;
    transition: transform 0.5s ease;
  }
  .c-biz-card:hover img { transform: scale(1.04); }
  .c-biz-foot {
    position: absolute; left: 0; right: 0; bottom: 0;
    display: flex; align-items: flex-end; justify-content: space-between; gap: 12px;
    padding: 40px 18px 16px;
    background: linear-gradient(to top, rgba(255, 255, 255, 0.96) 45%, rgba(255, 255, 255, 0));
  }
  .c-biz-brand { display: block; font-size: var(--fs-small); color: var(--g-ink); line-height: 1; }
  .c-biz-foot h3 {
    margin: 2px 0 0;
    color: var(--g-blue);
    font-size: clamp(20px, 1.8vw, 26px);
    font-weight: var(--fw-heading);
    line-height: 1.1;
  }
  /* The whole card opens the business's job openings page. */
  .c-biz-link { color: inherit; text-decoration: none; }
  .c-biz-img { position: absolute; inset: 0; }
  .c-apply {
    flex: none;
    padding: 7px 14px;
    border: 1.5px solid var(--g-blue);
    border-radius: 8px;
    background: #fff;
    color: var(--g-blue);
    font-size: 14px;
    font-weight: 500;
    text-decoration: none;
    transition: background 0.2s, color 0.2s;
  }
  .c-apply:hover, .c-apply:focus-visible { background: var(--g-blue); color: #fff; }

  /* Benefits */
  .c-benefit-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: clamp(24px, 3vw, 40px);
    text-align: center;
  }
  .c-benefit-icon {
    width: 96px; height: 80px;
    margin: 0 auto 20px;
    display: grid; place-items: center;
    border-radius: 12px;
    background: var(--bg-soft);
    color: var(--g-blue);
  }
  .c-benefit-icon svg { width: 44px; height: 44px; }
  .c-benefit h3 {
    color: var(--g-orange);
    font-size: var(--fs-h3);
    font-weight: var(--fw-heading);
  }
  .c-benefit p {
    margin: 12px auto 0;
    max-width: 320px;
    color: #222;
    font-size: var(--fs-body);
    line-height: 1.6;
  }

  /* Testimonials */
  .c-testi-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 18px;
  }
  .c-testi-card {
    margin: 0;
    display: flex; flex-direction: column;
    padding: 22px 20px 18px;
    border: 1px solid var(--line);
    border-radius: 10px;
    background: #fff;
    box-shadow: 0 4px 14px rgba(15, 42, 61, 0.04);
    transition: box-shadow 0.2s, transform 0.2s;
  }
  .c-testi-card:hover { transform: translateY(-3px); box-shadow: var(--shadow-card); }
  .c-quote {
    width: 30px; height: 30px;
    display: grid; place-items: center;
    border-radius: 7px;
    background: var(--bg-soft);
    color: var(--g-blue);
  }
  .c-quote svg { width: 16px; height: 16px; }
  .c-testi-card blockquote {
    flex: 1;
    margin: 18px 0 20px;
    color: var(--text);
    font-size: 14px;
    line-height: 1.6;
  }
  .c-testi-card figcaption {
    display: flex; gap: 12px; align-items: center;
    padding-top: 16px;
    border-top: 1px solid var(--line);
  }
  .c-avatar {
    flex: none;
    width: 38px; height: 38px;
    display: grid; place-items: center;
    border-radius: 9px;
    background: var(--bg-soft);
    color: var(--g-blue);
    font-size: 12px; font-weight: 600;
  }
  .c-testi-card strong { display: block; color: var(--g-ink); font-size: 13px; font-weight: 600; }
  .c-testi-card small { display: block; margin-top: 2px; color: var(--muted); font-size: 12px; line-height: 1.4; }

  @media (max-width: 1024px) {
    .c-testi-grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 768px) {
    .c-stage { margin: 8px 12px 0; }
    .c-pop--bl, .c-pop--br { display: none; }
    .c-pop--tl { left: -3%; top: 14%; }
    .c-pop--tr { right: -3%; top: 12%; }
    .c-pop--ml { left: -3%; top: 46%; }
    .c-pop--mr { right: -3%; top: 44%; }
    .c-pop-card { padding: 7px 10px 7px 7px; gap: 7px; border-radius: 12px; }
    .c-pop-icon { width: 28px; height: 28px; }
    .c-pop-icon svg { width: 15px; height: 15px; }
    .c-pop-text { font-size: 11.5px; }
    .c-pop-text strong { font-size: 15px; }
    .c-pop-text strong + span { font-size: 10px; }
    .c-pop-arrow { width: 20px; height: 20px; }
    .c-hero-grid { grid-template-columns: 1fr; }
    .c-biz-grid, .c-benefit-grid { grid-template-columns: 1fr; }
    .c-biz-card { aspect-ratio: 16 / 10; }
    .c-benefit-grid { gap: 32px; }
  }
  @media (max-width: 560px) {
    .c-testi-grid { grid-template-columns: 1fr; }
  }
</style>

<script>
  // Gentle 3D tilt of the hero stage toward the pointer (desktop pointers only).
  const stage = document.querySelector<HTMLElement>('[data-stage]');
  const inner = stage?.querySelector<HTMLElement>('.c-stage-inner');
  const fine = window.matchMedia('(hover: hover) and (pointer: fine)').matches;
  const still = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (stage && inner && fine && !still) {
    stage.addEventListener('pointermove', (e) => {
      const r = stage.getBoundingClientRect();
      const x = (e.clientX - r.left) / r.width - 0.5;
      const y = (e.clientY - r.top) / r.height - 0.5;
      inner.style.setProperty('--ry', `${x * 10}deg`);
      inner.style.setProperty('--rx', `${-y * 8}deg`);
    });
    stage.addEventListener('pointerleave', () => {
      inner.style.setProperty('--ry', '0deg');
      inner.style.setProperty('--rx', '0deg');
    });
  }
</script>
