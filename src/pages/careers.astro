---
import GroupLayout from '../layouts/GroupLayout.astro';
import { careersHero, careerBusinesses, benefits, testimonials } from '../data/careers';
---
<GroupLayout title="Careers – Vritti Group" description="Your dreams. Fulfilled at Vritti. Careers in technology, media and marketing at Vritti Group.">
  <section class="g-section c-hero">
    <div class="g-container c-hero-grid">
      <div class="c-hero-copy">
        <h1>
          <span class="c-hero-l1">{careersHero.title}</span>
          <span class="c-hero-l2">{careersHero.highlight}</span>
        </h1>
        <p>{careersHero.text}</p>
      </div>
      <div class="c-hero-media">
        {careersHero.image
          ? <img src={careersHero.image} alt={careersHero.imageAlt} width="1448" height="1086" fetchpriority="high" />
          : <div class="c-placeholder" role="img" aria-label="Photo coming soon"></div>}
      </div>
    </div>
  </section>

  <section class="g-section c-biz" id="openings">
    <div class="g-container">
      <h2 class="visually-hidden">Our businesses</h2>
      <div class="c-biz-grid">
        {careerBusinesses.map((b) => (
          <article class="c-biz-card">
            <a class="c-biz-img" href={`/careers/${b.slug}`} tabindex="-1" aria-hidden="true"><img src={b.image} alt="" loading="lazy" /></a>
            <div class="c-biz-foot">
              <div>
                <span class="c-biz-brand">Vritti</span>
                <h3><a class="c-biz-link" href={`/careers/${b.slug}`}>{b.label}</a></h3>
              </div>
              <a class="c-apply" href={`/careers/${b.slug}`} aria-label={`Apply Now: Vritti ${b.label} job openings`}>Apply Now</a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="g-section c-benefits" id="benefits">
    <div class="g-container">
      <div class="g-head">
        <h2 class="g-title">{benefits.title}</h2>
        <p class="g-sub">{benefits.subtitle}</p>
      </div>
      <div class="c-benefit-grid">
        {benefits.items.map((b) => (
          <div class="c-benefit">
            <div class="c-benefit-icon" aria-hidden="true">
              {b.icon === 'life' && (
                <svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M24 5l15 6v11c0 10-6.5 17.5-15 21-8.5-3.5-15-11-15-21V11z"/><path d="M17 24l5 5 9-10"/></svg>
              )}
              {b.icon === 'health' && (
                <svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M24 41S7 31 7 18.5A9.5 9.5 0 0124 13a9.5 9.5 0 0117 5.5C41 31 24 41 24 41z"/><path d="M24 20v11M18.5 25.5h11"/></svg>
              )}
              {b.icon === 'family' && (
                <svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><circle cx="17" cy="12" r="5"/><path d="M8 40V28a9 9 0 0118 0"/><circle cx="33" cy="24" r="4"/><path d="M26 40v-4a7 7 0 0114 0v4"/></svg>
              )}
            </div>
            <h3>{b.title}</h3>
            <p>{b.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="g-section c-testi" id="testimonials">
    <div class="g-container">
      <div class="g-head">
        <h2 class="g-title">{testimonials.title}</h2>
        <p class="g-sub">{testimonials.subtitle}</p>
      </div>
      <div class="c-testi-grid">
        {testimonials.items.map((t) => (
          <figure class="c-testi-card">
            <span class="c-quote" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="currentColor"><path d="M10 7H6.5A2.5 2.5 0 004 9.5V13h4v-.5A2.5 2.5 0 015.5 15v2A4.5 4.5 0 0010 12.5zM20 7h-3.5A2.5 2.5 0 0014 9.5V13h4v-.5a2.5 2.5 0 01-2.5 2.5v2a4.5 4.5 0 004.5-4.5z"/></svg>
            </span>
            <blockquote>{t.quote}</blockquote>
            <figcaption>
              <span class="c-avatar" aria-hidden="true">{t.initials}</span>
              <span>
                <strong>{t.name}</strong>
                <small>{t.role}</small>
              </span>
            </figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>
</GroupLayout>

<style>
  .visually-hidden {
    position: absolute; width: 1px; height: 1px; overflow: hidden;
    clip: rect(0 0 0 0); white-space: nowrap;
  }

  /* Hero */
  .c-hero-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(28px, 4vw, 56px);
    align-items: start;
  }
  .c-hero h1 {
    margin: 0;
    font-size: var(--fs-page-title);
    font-weight: var(--fw-heading);
    line-height: 1.12;
    text-transform: uppercase;
  }
  .c-hero h1 span { display: block; }
  .c-hero-l1 { color: var(--g-ink); }
  .c-hero-l2 { color: var(--g-blue); }
  .c-hero-copy p {
    margin: 20px 0 0;
    max-width: 480px;
    color: #222;
    font-size: var(--fs-body);
    line-height: 1.8;
  }
  .c-hero-media img,
  .c-placeholder {
    display: block;
    width: 100%;
    aspect-ratio: 5 / 3;
    object-fit: cover;
    border-radius: 4px;
  }
  .c-hero-media img { object-position: center 30%; }
  .c-placeholder { background: #d9d9d9; }

  /* Business cards */
  .c-biz { padding-top: 0; }
  .c-biz-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: clamp(16px, 3vw, 40px);
  }
  .c-biz-card {
    position: relative;
    aspect-ratio: 4 / 3;
    border-radius: 6px;
    overflow: hidden;
    background: #e9e9e9;
  }
  .c-biz-card img {
    position: absolute; inset: 0;
    width: 100%; height: 100%;
    object-fit: cover;
    transition: transform 0.5s ease;
  }
  .c-biz-card:hover img { transform: scale(1.04); }
  .c-biz-foot {
    position: absolute; left: 0; right: 0; bottom: 0;
    display: flex; align-items: flex-end; justify-content: space-between; gap: 12px;
    padding: 40px 18px 16px;
    background: linear-gradient(to top, rgba(255, 255, 255, 0.96) 45%, rgba(255, 255, 255, 0));
  }
  .c-biz-brand { display: block; font-size: var(--fs-small); color: var(--g-ink); line-height: 1; }
  .c-biz-foot h3 {
    margin: 2px 0 0;
    color: var(--g-blue);
    font-size: clamp(20px, 1.8vw, 26px);
    font-weight: var(--fw-heading);
    line-height: 1.1;
  }
  /* The whole card opens the business's job openings page. */
  .c-biz-link { color: inherit; text-decoration: none; }
  .c-biz-img { position: absolute; inset: 0; }
  .c-apply {
    flex: none;
    padding: 7px 14px;
    border: 1.5px solid var(--g-blue);
    border-radius: 8px;
    background: #fff;
    color: var(--g-blue);
    font-size: 14px;
    font-weight: 500;
    text-decoration: none;
    transition: background 0.2s, color 0.2s;
  }
  .c-apply:hover, .c-apply:focus-visible { background: var(--g-blue); color: #fff; }

  /* Benefits */
  .c-benefit-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: clamp(24px, 3vw, 40px);
    text-align: center;
  }
  .c-benefit-icon {
    width: 96px; height: 80px;
    margin: 0 auto 20px;
    display: grid; place-items: center;
    border-radius: 12px;
    background: var(--bg-soft);
    color: var(--g-blue);
  }
  .c-benefit-icon svg { width: 44px; height: 44px; }
  .c-benefit h3 {
    color: var(--g-orange);
    font-size: var(--fs-h3);
    font-weight: var(--fw-heading);
  }
  .c-benefit p {
    margin: 12px auto 0;
    max-width: 320px;
    color: #222;
    font-size: var(--fs-body);
    line-height: 1.6;
  }

  /* Testimonials */
  .c-testi-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 18px;
  }
  .c-testi-card {
    margin: 0;
    display: flex; flex-direction: column;
    padding: 22px 20px 18px;
    border: 1px solid var(--line);
    border-radius: 10px;
    background: #fff;
    box-shadow: 0 4px 14px rgba(15, 42, 61, 0.04);
    transition: box-shadow 0.2s, transform 0.2s;
  }
  .c-testi-card:hover { transform: translateY(-3px); box-shadow: var(--shadow-card); }
  .c-quote {
    width: 30px; height: 30px;
    display: grid; place-items: center;
    border-radius: 7px;
    background: var(--bg-soft);
    color: var(--g-blue);
  }
  .c-quote svg { width: 16px; height: 16px; }
  .c-testi-card blockquote {
    flex: 1;
    margin: 18px 0 20px;
    color: var(--text);
    font-size: 14px;
    line-height: 1.6;
  }
  .c-testi-card figcaption {
    display: flex; gap: 12px; align-items: center;
    padding-top: 16px;
    border-top: 1px solid var(--line);
  }
  .c-avatar {
    flex: none;
    width: 38px; height: 38px;
    display: grid; place-items: center;
    border-radius: 9px;
    background: var(--bg-soft);
    color: var(--g-blue);
    font-size: 12px; font-weight: 600;
  }
  .c-testi-card strong { display: block; color: var(--g-ink); font-size: 13px; font-weight: 600; }
  .c-testi-card small { display: block; margin-top: 2px; color: var(--muted); font-size: 12px; line-height: 1.4; }

  @media (max-width: 1024px) {
    .c-testi-grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 768px) {
    .c-hero-grid { grid-template-columns: 1fr; }
    .c-biz-grid, .c-benefit-grid { grid-template-columns: 1fr; }
    .c-biz-card { aspect-ratio: 16 / 10; }
    .c-benefit-grid { gap: 32px; }
  }
  @media (max-width: 560px) {
    .c-testi-grid { grid-template-columns: 1fr; }
  }
</style>
