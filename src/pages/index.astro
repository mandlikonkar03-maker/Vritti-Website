---
// Vritti Group home page. Content lives in src/data/home.ts.
import GroupLayout from '../layouts/GroupLayout.astro';
import StoryCard from '../components/group/StoryCard.astro';
import Slideshow from '../components/group/Slideshow.astro';
import {
  hero,
  whoWeAre,
  businesses,
  legacy,
  builtOverTime,
  vrittiWay,
  coreValues,
  awards,
  presence,
  foundation,
} from '../data/home';

const placeholders = Array.from({ length: whoWeAre.placeholderCount });
// Enough copies of "The Vritti Way" to fill a wide screen twice (the strip scrolls by half its width).
const wayItems = Array.from({ length: 16 }, () => vrittiWay);
---
<GroupLayout
  title="Vritti Group – Building Businesses. Enabling Growth."
  description={hero.text}
>
  <!-- Hero -->
  <section class="hero">
    <div class="g-container hero-inner">
      <div class="hero-copy">
        <p class="hero-eyebrow">{hero.eyebrow}</p>
        <h1>{hero.title.map((line) => <span>{line}</span>)}</h1>
        <p class="hero-text">{hero.text}</p>
      </div>
    </div>
    <img class="hero-img" src={hero.image} alt={hero.imageAlt} width="938" height="795" fetchpriority="high" />
  </section>

  <!-- Who we are -->
  <section class="g-section who" id="who-we-are">
    <div class="g-container">
      <div class="who-head">
        <p class="who-eyebrow">{whoWeAre.eyebrow}</p>
        <h2 class="g-title">{whoWeAre.title}</h2>
        <p class="who-text">{whoWeAre.text}</p>
      </div>
      <ul class="tile-grid">
        {whoWeAre.tiles.length
          ? whoWeAre.tiles.map((t, i) => <li class="tile tile--photo" style={`--i:${i}`}><img src={t.src} alt={t.alt} width="480" height="480" loading="lazy" /></li>)
          : placeholders.map(() => <li class="tile tile--empty" aria-hidden="true"></li>)}
      </ul>
    </div>
  </section>

  <!-- Businesses -->
  <section class="g-section businesses" id="businesses">
    <div class="g-container">
      <div class="g-head">
        <h2 class="g-title">Businesses</h2>
        <p class="g-sub">Our diverse portfolio.</p>
      </div>
      <div class="biz-grid">
        {businesses.map((b) => {
          const Tag = b.href ? 'a' : 'div';
          return (
            <Tag class="biz-card" href={b.href} aria-label={b.href ? `${b.label}: explore ${b.lead ?? b.label}` : undefined}>
              <div class="biz-logo">
                <img src={b.logo} alt={b.logoAlt} style={`width:${b.logoWidth}px`} loading="lazy" />
              </div>
              <h3 class="biz-label">{b.label}</h3>
              <p class="biz-text">{b.lead && <span class="biz-lead">{b.lead}</span>} {b.text}</p>
              <span class={`biz-explore${b.href ? '' : ' is-soon'}`} title={b.href ? undefined : 'Page coming soon'}>
                Explore <span aria-hidden="true">→</span>
              </span>
            </Tag>
          );
        })}
      </div>
    </div>
  </section>

  <!-- Legacy & Leadership -->
  <section class="g-section" id="legacy">
    <div class="g-container">
      <div class="g-head">
        <h2 class="g-title">{legacy.title}</h2>
        <p class="g-sub">{legacy.subtitle}</p>
      </div>
      <div class="story-row">
        {legacy.stories.map((s, i) => <StoryCard story={s} wide={i === 1} />)}
      </div>
    </div>
  </section>

  <!-- Built over time -->
  <section class="bot" id="built-over-time">
    <div class="g-container">
      <h2 class="bot-title">
        <span class="visually-hidden">{builtOverTime.title}</span>
        <svg viewBox="0 0 1000 118" aria-hidden="true" focusable="false">
          <!-- Outline drawn with a filter (fill minus an eroded copy) so the font's overlapping
               glyph contours don't show as stray lines inside letters, as a text stroke would. -->
          <filter id="bot-outline" x="-2%" y="-10%" width="104%" height="120%">
            <feMorphology in="SourceAlpha" operator="erode" radius="1.4" result="thin" />
            <feComposite in="SourceGraphic" in2="thin" operator="out" />
          </filter>
          <text x="0" y="104" filter="url(#bot-outline)" textLength="1000" lengthAdjust="spacing">{builtOverTime.title.toUpperCase()}</text>
        </svg>
      </h2>
      <ul class="bot-grid">
        {Array.from({ length: builtOverTime.photoCount }).map(() => <li class="bot-photo"></li>)}
      </ul>
      <ul class="bot-stats">
        {builtOverTime.stats.map((st) => (
          <li class:list={['stat', st.big && 'stat--big']}>
            <span class="stat-value">{st.value}</span>
            <span class="stat-label">
              {st.plus && <span class="stat-plus">+</span>}
              {st.label.map((l) => <span>{l}</span>)}
            </span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <div class="way" aria-label={vrittiWay}>
    <div class="way-track" aria-hidden="true">
      {wayItems.map((t) => <span>{t}</span>)}
    </div>
  </div>

  <!-- How we think / core values -->
  <section class="values" id="core-values">
    <div class="g-container">
      <div class="values-head">
        <h2 class="values-title">{coreValues.title}</h2>
        <p class="values-sub">{coreValues.subtitle}</p>
      </div>
      <ul class="values-grid">
        {coreValues.values.map((v) => (
          <li class="value">
            <span class="value-icon" aria-hidden="true"></span>
            <h3>{v.title}</h3>
            <p>{v.text}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <div class="way" aria-label={vrittiWay}>
    <div class="way-track" aria-hidden="true">
      {wayItems.map((t) => <span>{t}</span>)}
    </div>
  </div>

  <!-- Awards & Recognition -->
  <section class="g-section awards" id="awards">
    <div class="g-container">
      <h2 class="g-title awards-title">{awards.title}</h2>
      <ul class="awards-grid">
        {Array.from({ length: awards.slotCount }).map(() => <li class="award tile--empty"></li>)}
        <li class="award award--more">{awards.more}</li>
      </ul>
    </div>
  </section>

  <!-- Global presence -->
  <section class="g-section" id="presence">
    <div class="g-container">
      <div class="g-head">
        <h2 class="g-title">{presence.title}</h2>
        <p class="g-sub">{presence.subtitle}</p>
      </div>
      <div class="map">
        <img src={presence.map} alt="World map showing where Vritti Group operates" width="1160" height="760" loading="lazy" />
        {presence.pins.map((p) => (
          <span class:list={['pin', p.side && `pin--${p.side}`]} style={`left:${p.x}%;top:${p.y}%`}>
            <span class="pin-dot" aria-hidden="true"></span>
            <span class="pin-label">{p.label}</span>
          </span>
        ))}
      </div>
    </div>
  </section>

  <!-- Vritti Foundation -->
  <section class="foundation" id="foundation">
    <div class="g-container g-head foundation-head">
      <h2 class="g-title">{foundation.title}</h2>
      <p class="g-sub">{foundation.subtitle}</p>
    </div>
    <div class="foundation-band">
      <div class="g-container foundation-inner">
        <div class="foundation-copy">
          <img src={foundation.logo} alt="Vritti Foundation" width="180" height="62" loading="lazy" />
          <h3>{foundation.heading}</h3>
          <p class="foundation-tagline">{foundation.tagline.map((l) => <span>{l}</span>)}</p>
          <p class="foundation-text">{foundation.text}</p>
        </div>
        <Slideshow slides={foundation.slides} />
      </div>
    </div>
  </section>
</GroupLayout>

<script>
  // Photo grid "developing" animation (styles in the who-we-are section above).
  const grid = document.querySelector<HTMLElement>('#who-we-are .tile-grid');
  if (
    grid &&
    grid.querySelector('.tile--photo') &&
    'IntersectionObserver' in window &&
    !window.matchMedia('(prefers-reduced-motion: reduce)').matches
  ) {
    // Jump straight to the washed-out start state (no transition), then let it develop.
    grid.classList.add('who-anim', 'who-prep');
    void grid.offsetWidth;
    grid.classList.remove('who-prep');
    const io = new IntersectionObserver(
      (entries) => {
        if (!entries.some((e) => e.isIntersecting)) return;
        io.disconnect();
        grid.classList.add('is-developed');
        // After the last photo settles, switch to the quicker hover transitions.
        const total = 1600 + grid.children.length * 110;
        window.setTimeout(() => grid.classList.add('is-done'), total);
      },
      { rootMargin: '0px 0px -15% 0px' },
    );
    io.observe(grid);
  }
</script>

<style>
  /* Hero */
  .hero {
    position: relative;
    background: linear-gradient(to right, var(--g-blue) 86.67%, var(--g-orange) 86.67%);
    color: #fff;
    overflow: hidden;
    min-height: 47.3vw;
    display: flex;
    align-items: center;
  }
  .hero-inner { position: relative; z-index: 1; }
  /* Copy starts at the page margin and stops before the photo (photo's left edge = 100vw - 55.83vw). */
  .hero-copy { max-width: calc(44.17vw - max(24px, 50vw - 576px) - 24px); padding: 48px 0; }
  .hero-eyebrow {
    margin: 0 0 14px;
    color: var(--g-orange);
    font-size: clamp(16px, 1.75vw, 30px);
    font-weight: 500;
    letter-spacing: 0.32em;
    text-transform: uppercase;
  }
  .hero h1 {
    font-size: clamp(30px, 3vw, 40px);
    font-weight: 700;
    line-height: 1.08;
  }
  .hero h1 span { display: block; }
  .hero-text {
    margin: clamp(18px, 2.4vw, 40px) 0 0;
    font-size: clamp(16px, 1.65vw, 27px);
    line-height: 1.12;
    font-weight: 500;
  }
  .hero-img {
    position: absolute;
    right: 0;
    bottom: 0;
    width: 55.83vw;
    height: auto;
    display: block;
  }

  /* Who we are */
  .who-head { text-align: center; max-width: 1140px; margin: 0 auto 48px; }
  .who-eyebrow {
    margin: 0 0 14px;
    font-size: clamp(12px, 1.1vw, 18px);
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: #444;
  }
  .who-text {
    margin: 10px 0 0;
    color: var(--g-text);
    font-size: clamp(16px, 1.6vw, 26px);
    font-weight: 600;
    line-height: 1.15;
  }
  .tile-grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(7, 1fr);
    gap: 14px;
  }
  .tile { aspect-ratio: 1; display: grid; place-items: center; background: #fff; }
  .tile img { max-width: 80%; max-height: 80%; object-fit: contain; }
  .tile--photo { overflow: hidden; background: #222; }
  .tile--photo { position: relative; transition: box-shadow 0.4s ease; }
  .tile--photo img {
    width: 100%; height: 100%; max-width: none; max-height: none; object-fit: cover;
    filter: grayscale(1);
    transition: transform 0.9s cubic-bezier(0.2, 0.7, 0.2, 1), filter 0.4s ease;
  }
  /* Soft vignette, like an old print. */
  .tile--photo::after {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    box-shadow: inset 0 0 40px rgba(0, 0, 0, 0.35);
    transition: box-shadow 0.4s ease;
  }
  .tile--photo:hover { box-shadow: 0 14px 30px rgba(0, 0, 0, 0.22); z-index: 1; }
  .tile--photo:hover img { transform: scale(1.08); filter: grayscale(1) contrast(1.08); }
  .tile--photo:hover::after { box-shadow: inset 0 0 0 rgba(0, 0, 0, 0); }

  /* "Developing" effect: each photo starts washed out and comes into focus, one after another,
     when the grid scrolls into view. Only applies once the script above adds .who-anim, so the
     photos stay visible without JavaScript, and is skipped for reduced motion. */
  :global(.who-anim) .tile--photo img {
    filter: grayscale(1) brightness(1.9) contrast(0.6) blur(6px);
    transform: scale(1.12);
    transition:
      filter 1.4s ease calc(var(--i) * 110ms),
      transform 1.6s cubic-bezier(0.2, 0.7, 0.2, 1) calc(var(--i) * 110ms);
  }
  :global(.who-prep) .tile--photo img { transition: none !important; }
  :global(.who-anim.is-developed) .tile--photo img { filter: grayscale(1); transform: none; }
  :global(.who-anim.is-developed.is-done) .tile--photo img {
    transition: transform 0.9s cubic-bezier(0.2, 0.7, 0.2, 1), filter 0.4s ease;
  }
  :global(.who-anim.is-developed) .tile--photo:hover img { transform: scale(1.08); filter: grayscale(1) contrast(1.08); }
  @media (prefers-reduced-motion: reduce) {
    .tile--photo img, .tile--photo::after { transition: none !important; }
    .tile--photo:hover img { transform: none; }
  }
  .tile--empty {
    background-color: #f6f6f6;
    background-image:
      linear-gradient(45deg, #ececec 25%, transparent 25%, transparent 75%, #ececec 75%),
      linear-gradient(45deg, #ececec 25%, transparent 25%, transparent 75%, #ececec 75%);
    background-size: 16px 16px;
    background-position: 0 0, 8px 8px;
  }

  /* Businesses */
  .biz-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: clamp(20px, 2.2vw, 36px);
  }
  .biz-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    background: #fff;
    color: var(--g-ink);
    text-decoration: none;
    padding: 40px clamp(20px, 5vw, 72px) 40px;
    box-shadow: 0 10px 40px rgba(0, 0, 0, 0.08);
    transition: transform 0.2s, box-shadow 0.2s;
  }
  /* All cards react to hover, linked or not */
  .biz-card:hover { transform: translateY(-4px); box-shadow: 0 18px 48px rgba(6, 97, 169, 0.18); }
  .biz-logo {
    width: 100%;
    height: 108px;
    display: grid;
    place-items: center;
    border-bottom: 1px solid #c8c8c8;
    margin-bottom: 30px;
  }
  .biz-logo img { max-width: 100%; height: auto; }
  .biz-label {
    color: var(--g-blue);
    font-size: clamp(20px, 1.75vw, 29px);
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
  }
  .biz-text {
    margin: 12px 0 28px;
    font-size: clamp(16px, 1.35vw, 22px);
    line-height: 1.12;
    flex: 1;
  }
  .biz-explore {
    color: var(--g-blue);
    font-weight: 700;
    font-size: clamp(17px, 1.4vw, 23px);
  }
  .biz-explore span { color: var(--g-orange); margin-left: 4px; }
  /* Light blue until the card is hovered, then full dark blue. */
  .biz-explore { opacity: 0.55; transition: opacity 0.3s ease; }
  .biz-card:hover .biz-explore,
  a.biz-card:focus-visible .biz-explore { opacity: 1; }
  /* Card lead-in (Ekatm ERP, Vritti iMedia): regular weight, bolds smoothly on hover.
     The bold is drawn with a text-shadow so the letters never get wider and the
     paragraph never re-wraps (no layout shift). */
  .biz-lead { text-shadow: 0 0 0 transparent, 0 0 0 transparent; transition: text-shadow 0.35s ease; }
  .biz-card:hover .biz-lead,
  a.biz-card:focus-visible .biz-lead {
    text-shadow: 0.65px 0 0 currentColor, -0.65px 0 0 currentColor;
  }

  /* Story rows (legacy) */
  .story-row { display: flex; box-shadow: 0 10px 40px rgba(0, 0, 0, 0.08); }

  /* Built over time (blue band) */
  .bot, .values { --band: #2a5fa4; background: var(--band); color: #fff; }
  .bot { padding: clamp(28px, 3.4vw, 48px) 0 clamp(36px, 4vw, 56px); }
  .bot-title { margin: 0 0 clamp(16px, 2vw, 28px); line-height: 0; }
  .bot-title svg { display: block; width: 100%; height: auto; overflow: visible; opacity: 0.8; }
  .bot-title text {
    font-family: var(--font, 'Montserrat', sans-serif);
    font-weight: 600;
    font-size: 112px;
    fill: #fff;
  }
  .bot-grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    gap: 2px;
  }
  .bot-photo { aspect-ratio: 1; background: #d9d9d9; }
  .bot-stats {
    list-style: none;
    margin: clamp(24px, 2.6vw, 40px) 0 0;
    padding: 0;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
  }
  .stat { display: flex; align-items: center; gap: clamp(6px, 0.7vw, 10px); }
  .stat-value { font-size: clamp(40px, 5.2vw, 74px); font-weight: 700; line-height: 1; letter-spacing: -0.01em; }
  .stat--big .stat-value { font-size: clamp(56px, 7.6vw, 108px); }
  .stat-label {
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    text-transform: uppercase;
    font-weight: 700;
    font-size: clamp(13px, 1.6vw, 23px);
    line-height: 1.02;
    align-self: stretch;
    padding-bottom: 0.3em;
  }
  .stat-plus { font-size: 1.05em; line-height: 0.8; margin-bottom: auto; padding-top: 0.15em; }
  .stat:not(.stat--big) .stat-plus { margin-bottom: 0.1em; }

  /* "The Vritti Way" strip: slow, endless scroll */
  .way {
    overflow: hidden;
    background: #fff;
    border-block: 2px solid var(--g-orange);
    padding: clamp(14px, 1.4vw, 20px) 0;
  }
  .way-track {
    display: flex;
    width: max-content;
    animation: way-scroll 40s linear infinite;
  }
  .way-track span {
    flex: none;
    padding: 0 clamp(24px, 3.4vw, 48px);
    color: var(--g-ink);
    font-size: clamp(11px, 0.95vw, 14px);
    font-weight: 700;
    letter-spacing: 0.26em;
    text-transform: uppercase;
    white-space: nowrap;
  }
  @keyframes way-scroll { to { transform: translateX(-50%); } }
  @media (prefers-reduced-motion: reduce) { .way-track { animation: none; } }

  /* How we think / core values */
  .values { padding: clamp(40px, 4.4vw, 64px) 0 clamp(48px, 5.4vw, 80px); text-align: center; }
  .values-head { margin-bottom: clamp(28px, 3vw, 44px); }
  .values-title {
    color: var(--g-orange);
    font-size: clamp(24px, 2.6vw, 38px);
    font-weight: 700;
    text-transform: uppercase;
    line-height: 1.1;
  }
  .values-sub {
    margin: 6px 0 0;
    font-size: clamp(11px, 0.95vw, 14px);
    font-weight: 500;
    letter-spacing: 0.32em;
    text-transform: uppercase;
  }
  .values-grid {
    list-style: none;
    margin: 0 auto;
    padding: 0;
    max-width: 960px;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: clamp(20px, 3vw, 48px);
  }
  .value { display: flex; flex-direction: column; align-items: center; }
  .value-icon {
    width: clamp(88px, 9.4vw, 136px);
    aspect-ratio: 1;
    border-radius: 50%;
    background: #fff;
    margin-bottom: clamp(14px, 1.4vw, 20px);
  }
  .value h3 {
    max-width: 11ch;
    font-size: clamp(14px, 1.3vw, 19px);
    font-weight: 700;
    line-height: 1.08;
    text-transform: uppercase;
  }
  .value p { margin: 4px 0 0; max-width: 18ch; font-size: clamp(13px, 1.1vw, 16px); line-height: 1.15; }

  /* Awards & Recognition */
  .awards-title { text-align: center; margin-bottom: clamp(24px, 2.6vw, 40px); }
  .awards-grid {
    list-style: none;
    margin: 0 auto;
    padding: 0;
    max-width: 1040px;
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: clamp(12px, 1.8vw, 26px);
  }
  .award { aspect-ratio: 1; }
  .award--more {
    display: grid;
    place-items: center;
    background: #fff;
    box-shadow: 0 10px 34px rgba(0, 0, 0, 0.1);
    color: #2a5fa4;
    font-size: clamp(20px, 2vw, 30px);
    font-weight: 700;
  }

  /* Map */
  .map { position: relative; max-width: 1160px; margin: 0 auto; }
  .map img { display: block; width: 100%; height: auto; }
  .pin { position: absolute; transform: translate(-50%, -100%); display: flex; flex-direction: column; align-items: center; }
  .pin-label {
    order: -1;
    margin-bottom: 6px;
    background: var(--g-blue);
    color: #fff;
    font-size: 12px;
    font-weight: 600;
    padding: 3px 10px;
    border-radius: 999px;
    white-space: nowrap;
  }
  .pin--left { flex-direction: row; transform: translate(calc(-100% + 8px), -50%); }
  .pin--left .pin-label { margin: 0 6px 0 0; }
  .pin-dot {
    width: 16px;
    height: 16px;
    border-radius: 50%;
    background: var(--g-orange);
    border: 3px solid #fff;
    box-shadow: 0 0 0 0 rgba(235, 158, 46, 0.6);
    animation: ping 2s infinite;
  }
  @keyframes ping {
    70% { box-shadow: 0 0 0 14px rgba(235, 158, 46, 0); }
    100% { box-shadow: 0 0 0 0 rgba(235, 158, 46, 0); }
  }

  /* Foundation */
  .foundation { padding-top: clamp(40px, 4vw, 64px); }
  .foundation-head { margin-bottom: 32px; }
  .foundation-band { background: var(--g-blue); color: #fff; padding: 38px 0 52px; }
  .foundation-inner {
    display: grid;
    grid-template-columns: 1fr 1.05fr;
    gap: clamp(32px, 5vw, 120px);
    align-items: start;
  }
  .foundation-copy { padding: 26px 0 0 50px; }
  .foundation-copy img { width: 180px; height: auto; display: block; }
  .foundation-copy h3 { margin-top: 14px; font-size: clamp(26px, 2.3vw, 38px); font-weight: 700; }
  .foundation-tagline { margin: 6px 0 0; font-size: clamp(16px, 1.45vw, 24px); line-height: 1.05; }
  .foundation-tagline span { display: block; }
  .foundation-text { margin: 60px 0 0; font-size: clamp(16px, 1.45vw, 24px); line-height: 1.04; max-width: 600px; }

  @media (prefers-reduced-motion: reduce) { .pin-dot { animation: none; } }

  @media (max-width: 1100px) {
    .tile-grid { grid-template-columns: repeat(5, 1fr); }
    .biz-card { padding: 32px 22px; }
    .foundation-copy { padding-left: 0; }
  }

  @media (max-width: 900px) {
