---
// Vritti Group home page. Content lives in src/data/home.ts.
import GroupLayout from '../layouts/GroupLayout.astro';
import StoryCard from '../components/group/StoryCard.astro';
import Slideshow from '../components/group/Slideshow.astro';
import GlobalPresence from '../components/group/GlobalPresence.astro';
import {
  hero,
  whoWeAre,
  businesses,
  legacy,
  builtOverTime,
  vrittiWay,
  coreValues,
  awards,
  foundation,
} from '../data/home';

const placeholders = Array.from({ length: whoWeAre.placeholderCount });
// Enough copies of "The Vritti Way" to fill a wide screen twice (the strip scrolls by half its width).
const wayItems = Array.from({ length: 16 }, () => vrittiWay);

// Line icons for the award cards (24x24, stroke-based).
const awardIcons: Record<string, string> = {
  trophy: '<path d="M8 21h8M12 17v4M7 4h10v5a5 5 0 0 1-10 0z"/><path d="M17 5h3v2a3 3 0 0 1-3 3M7 5H4v2a3 3 0 0 0 3 3"/>',
  medal: '<path d="M7.2 2 4 7l4.5 5M16.8 2 20 7l-4.5 5M7.2 2h9.6M10 2l2 5 2-5"/><circle cx="12" cy="15" r="5"/><path d="m12 13 .8 1.6 1.7.2-1.2 1.2.3 1.7-1.6-.8-1.6.8.3-1.7-1.2-1.2 1.7-.2z"/>',
  layers: '<path d="m12 3 9 5-9 5-9-5z"/><path d="m3 13 9 5 9-5"/>',
  star: '<path d="m12 3 2.8 5.7 6.2.9-4.5 4.4 1.1 6.2L12 17.3l-5.6 2.9 1.1-6.2L3 9.6l6.2-.9z"/>',
  users: '<circle cx="9" cy="8" r="4"/><path d="M2 21a7 7 0 0 1 14 0M16 4.1a4 4 0 0 1 0 7.8M22 21a7 7 0 0 0-4-6.3"/>',
  monitor: '<rect x="3" y="4" width="18" height="12" rx="2"/><path d="M8 20h8M12 16v4M9 10l2 2 4-4"/>',
};
---
<GroupLayout
  title="Vritti Group – Building Businesses. Enabling Growth."
  description={hero.text}
>
  <!-- Hero: "Vritti Group | <word>", the word and its backdrop change every few seconds -->
  <section class="hero" data-hero data-interval={hero.interval}>
    <div class="hero-bgs" aria-hidden="true">
      {hero.slides.map((s, i) => (
        <img
          class:list={['hero-bg', { 'is-active': i === 0 }]}
          src={s.image}
          alt=""
          loading={i === 0 ? 'eager' : 'lazy'}
          fetchpriority={i === 0 ? 'high' : 'auto'}
          decoding="async"
        />
      ))}
    </div>
    {hero.slides.map((s, i) =>
      s.href ? (
        <a
          class:list={['hero-link', { 'is-active': i === 0 }]}
          href={s.href}
          aria-label={s.linkLabel ?? s.word}
          data-slide={i}
          tabindex={i === 0 ? undefined : -1}
        ></a>
      ) : null,
    )}
    <div class="g-container hero-inner">
      <h1 class="hero-title">
        <span class="sr-only">{hero.brand}: {hero.slides.map((s) => s.word).join(', ')}</span>
        <span class="hero-brand" aria-hidden="true">{hero.brand}</span>
        <span class="hero-sep" aria-hidden="true"></span>
        <span class="hero-words" aria-hidden="true">
          {hero.slides.map((s, i) => (
            <span class:list={['hero-word', { 'is-active': i === 0 }]}>{s.word}</span>
          ))}
        </span>
      </h1>
      <p class="hero-text">{hero.text}</p>
      <div class="hero-dots" aria-hidden="true">
        {hero.slides.map((_, i) => <span class:list={['hero-dot', { 'is-active': i === 0 }]}></span>)}
      </div>
    </div>
  </section>

  <!-- Who we are -->
  <section class="g-section who" id="who-we-are">
    <div class="g-container">
      <div class="who-head">
        <p class="who-eyebrow">{whoWeAre.eyebrow}</p>
        <h2 class="g-title">{whoWeAre.title}</h2>
        <p class="who-text">{whoWeAre.text}</p>
      </div>
      <ul class="tile-grid">
        {whoWeAre.tiles.length
          ? whoWeAre.tiles.map((t, i) => <li class="tile tile--photo" style={`--i:${i}`}><img src={t.src} alt={t.alt} width="480" height="480" loading="lazy" /></li>)
          : placeholders.map(() => <li class="tile tile--empty" aria-hidden="true"></li>)}
      </ul>
    </div>
  </section>

  <!-- Businesses -->
  <section class="g-section businesses" id="businesses">
    <div class="g-container">
      <div class="g-head">
        <h2 class="g-title">Businesses</h2>
        <p class="g-sub">Our diverse portfolio.</p>
      </div>
      <div class="biz-grid">
        {businesses.map((b) => {
          const Tag = b.href ? 'a' : 'div';
          return (
            <Tag class="biz-card" href={b.href} aria-label={b.href ? `${b.label}: explore ${b.lead ?? b.label}` : undefined}>
              <div class="biz-logo">
                <img src={b.logo} alt={b.logoAlt} style={`width:${b.logoWidth}px`} loading="lazy" />
              </div>
              <h3 class="biz-label">{b.label}</h3>
              <p class="biz-text">{b.lead && <span class="biz-lead">{b.lead}</span>} {b.text}</p>
              <span class={`biz-explore${b.href ? '' : ' is-soon'}`} title={b.href ? undefined : 'Page coming soon'}>
                Explore <span aria-hidden="true">→</span>
              </span>
            </Tag>
          );
        })}
      </div>
    </div>
  </section>

  <!-- Legacy & Leadership -->
  <section class="g-section" id="legacy">
    <div class="g-container">
      <div class="g-head">
        <h2 class="g-title">{legacy.title}</h2>
        <p class="g-sub">{legacy.subtitle}</p>
      </div>
      <div class="story-row">
        {legacy.stories.map((s, i) => <StoryCard story={s} wide={i === 1} />)}
      </div>
    </div>
  </section>

  <!-- Built over time -->
  <section class="bot" id="built-over-time">
    <div class="g-container">
      <h2 class="bot-title">
        <span class="visually-hidden">{builtOverTime.title}</span>
        <svg viewBox="0 0 1000 118" aria-hidden="true" focusable="false">
          <!-- Outline drawn with a filter (fill minus an eroded copy) so the font's overlapping
               glyph contours don't show as stray lines inside letters, as a text stroke would. -->
          <filter id="bot-outline" x="-2%" y="-10%" width="104%" height="120%">
            <feMorphology in="SourceAlpha" operator="erode" radius="1.4" result="thin" />
            <feComposite in="SourceGraphic" in2="thin" operator="out" />
          </filter>
          <text x="0" y="104" filter="url(#bot-outline)" textLength="1000" lengthAdjust="spacing">{builtOverTime.title.toUpperCase()}</text>
        </svg>
      </h2>
      <ul class="bot-grid">
        {builtOverTime.photos.map((ph) => (
          <li class="bot-photo"><img src={ph.src} alt={ph.alt} width="480" height="480" loading="lazy" /></li>
        ))}
      </ul>
      <ul class="bot-stats">
        {builtOverTime.stats.map((st) => (
          <li class:list={['stat', st.big && 'stat--big']}>
            <span class="stat-value" data-count>{st.value}</span>
            <span class="stat-label">
              {st.plus && <span class="stat-plus">+</span>}
              {st.label.map((l) => <span>{l}</span>)}
            </span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <div class="way" aria-label={vrittiWay}>
    <div class="way-track" aria-hidden="true">
      {wayItems.map((t) => <span>{t}</span>)}
    </div>
  </div>

  <!-- How we think / core values -->
  <section class="values" id="core-values">
    <div class="g-container">
      <div class="values-head">
        <h2 class="values-title">{coreValues.title}</h2>
        <p class="values-sub">{coreValues.subtitle}</p>
      </div>
      <ul class="values-grid">
        {coreValues.values.map((v) => (
          <li class="value">
            <span class="value-icon" aria-hidden="true"></span>
            <h3>{v.title}</h3>
            <p>{v.text}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <div class="way" aria-label={vrittiWay}>
    <div class="way-track" aria-hidden="true">
      {wayItems.map((t) => <span>{t}</span>)}
    </div>
  </div>

  <!-- Awards & Recognition -->
  <section class="g-section awards" id="awards">
    <div class="g-container">
      <h2 class="g-title awards-title">{awards.title}</h2>
      <ul class="awards-grid">
        {awards.items.map((a) =>
          a.kind === 'photo' ? (
            <li class="award award--photo" style={`--aw-bg: url('${a.src}')`}>
              <img src={a.src} alt={a.alt} loading="lazy" decoding="async" />
            </li>
          ) : (
            <li class="award award--icon">
              <span class="award-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                  <Fragment set:html={awardIcons[a.icon]} />
                </svg>
              </span>
              <h3 class="award-title">{a.title}</h3>
              <span class="award-label">{awards.label}</span>
            </li>
          )
        )}
        <li class="award award--more">
          {(() => {
            const Tag = awards.more.href ? 'a' : 'div';
            return (
              <Tag class="award-more-inner" href={awards.more.href}>
                <strong>{awards.more.count}</strong>
                <span>{awards.more.label}</span>
                <em>{awards.more.cta} <span aria-hidden="true">&rarr;</span></em>
              </Tag>
            );
          })()}
        </li>
      </ul>
    </div>
  </section>

  <!-- Global presence (office cards + map, content in src/data/presence.ts) -->
  <GlobalPresence />

  <!-- Vritti Foundation -->
  <section class="foundation" id="foundation">
    <div class="g-container g-head foundation-head">
      <h2 class="g-title">{foundation.title}</h2>
      <p class="g-sub">{foundation.subtitle}</p>
    </div>
    <div class="foundation-band">
      <div class="g-container foundation-inner">
        <div class="foundation-copy">
          <img src={foundation.logo} alt="Vritti Foundation" width="180" height="62" loading="lazy" />
          <h3>{foundation.heading}</h3>
          <p class="foundation-tagline">{foundation.tagline.map((l) => <span>{l}</span>)}</p>
          <p class="foundation-text">{foundation.text}</p>
        </div>
        <Slideshow slides={foundation.slides} />
      </div>
    </div>
  </section>
</GroupLayout>

<script>
  // "Built over time." stats: count up from 0 to each number the first time they scroll into view.
  // The real numbers are in the HTML, so they show as-is without JavaScript or with reduced motion.
  const counters = [...document.querySelectorAll<HTMLElement>('[data-count]')];
  if (counters.length && 'IntersectionObserver' in window && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const run = (el: HTMLElement) => {
      const text = el.textContent ?? '';
      const m = text.match(/^(\D*)([\d,]+)(.*)$/);
      if (!m) return;
      const [, pre, num, post] = m;
      const target = Number(num.replace(/,/g, ''));
      const comma = num.includes(',');
      el.style.minWidth = `${el.getBoundingClientRect().width}px`; // keep the layout still while counting
      const start = performance.now();
      const dur = 1800;
      const tick = (now: number) => {
        const t = Math.min(1, (now - start) / dur);
        const v = Math.round(target * (1 - Math.pow(1 - t, 3)));
        el.textContent = pre + (comma ? v.toLocaleString('en-US') : String(v)) + post;
        if (t < 1) requestAnimationFrame(tick);
      };
      el.textContent = pre + '0' + post;
      requestAnimationFrame(tick);
    };
    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((e) => {
          if (!e.isIntersecting) return;
          io.unobserve(e.target);
          run(e.target as HTMLElement);
        });
      },
      { threshold: 0.6 },
    );
    counters.forEach((el) => io.observe(el));
  }

  // Hero: every `data-interval` ms, swap to the next word and crossfade its backdrop (loops).
  const heroEl = document.querySelector<HTMLElement>('[data-hero]');
  if (heroEl) {
    const words = [...heroEl.querySelectorAll<HTMLElement>('.hero-word')];
    const bgs = [...heroEl.querySelectorAll<HTMLImageElement>('.hero-bg')];
    const dots = [...heroEl.querySelectorAll<HTMLElement>('.hero-dot')];
    const links = [...heroEl.querySelectorAll<HTMLAnchorElement>('.hero-link')];
    const delay = Number(heroEl.dataset.interval) || 5000;
    let current = 0;
    // Start loading the other backdrops once the page has loaded, so each is ready before its turn.
    window.addEventListener('load', () => bgs.forEach((img) => (img.loading = 'eager')));
    const show = (next: number) => {
      words[current].classList.remove('is-active');
      words[current].classList.add('is-leaving');
      const leaving = words[current];
      setTimeout(() => leaving.classList.remove('is-leaving'), 700);
      bgs[current]?.classList.remove('is-active');
      dots[current]?.classList.remove('is-active');
      current = next;
      words[current].classList.add('is-active');
      bgs[current]?.classList.add('is-active');
      dots[current]?.classList.add('is-active');
      // Only the link of the word on screen is clickable (e.g. Technology → Ekatm ERP).
      links.forEach((a) => {
        const on = Number(a.dataset.slide) === current;
        a.classList.toggle('is-active', on);
        a.tabIndex = on ? 0 : -1;
      });
    };
    if (words.length > 1) setInterval(() => show((current + 1) % words.length), delay);
  }

  // Photo grid "developing" animation (styles in the who-we-are section above).
  const grid = document.querySelector<HTMLElement>('#who-we-are .tile-grid');
  if (
    grid &&
    grid.querySelector('.tile--photo') &&
    'IntersectionObserver' in window &&
    !window.matchMedia('(prefers-reduced-motion: reduce)').matches
  ) {
    // Jump straight to the washed-out start state (no transition), then let it develop.
    grid.classList.add('who-anim', 'who-prep');
    void grid.offsetWidth;
    grid.classList.remove('who-prep');
    const io = new IntersectionObserver(
      (entries) => {
        if (!entries.some((e) => e.isIntersecting)) return;
        io.disconnect();
        grid.classList.add('is-developed');
        // After the last photo settles, switch to the quicker hover transitions.
        const total = 1600 + grid.children.length * 110;
        window.setTimeout(() => grid.classList.add('is-done'), total);
      },
      { rootMargin: '0px 0px -15% 0px' },
    );
    io.observe(grid);
  }
</script>

<style>
  /* Hero: full-bleed rotating backdrop with "Vritti Group | <word>" */
  .hero {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    color: #fff;
    background: #0a2540;
    min-height: clamp(440px, 47.3vw, min(720px, calc(100vh - 84px)));
    display: flex;
    align-items: center;
  }
  .hero-bgs { position: absolute; inset: 0; z-index: -1; }
  .hero-bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0;
    transform: scale(1.08);
    transition: opacity 1.2s ease, transform 6.5s ease-out;
  }
  .hero-bg.is-active { opacity: 1; transform: scale(1); }
  /* Darken the photos (more on the left, behind the text) so the white copy stays readable. */
  .hero-bgs::after {
    content: '';
    position: absolute;
    inset: 0;
    background:
      linear-gradient(90deg, rgba(4, 30, 58, 0.88) 0%, rgba(4, 30, 58, 0.62) 45%, rgba(4, 30, 58, 0.25) 100%),
      linear-gradient(0deg, rgba(4, 30, 58, 0.45), transparent 40%);
  }
  .hero-inner { position: relative; width: 100%; padding-block: 56px; pointer-events: none; }
  /* Full-banner link, shown only while its word is on screen. */
  .hero-link { position: absolute; inset: 0; z-index: 2; display: none; }
  .hero-link.is-active { display: block; }
  .hero-link:focus-visible { outline: 3px solid var(--g-orange); outline-offset: -6px; }
  .hero:has(.hero-link.is-active:hover) .hero-word.is-active { text-decoration: underline; text-underline-offset: 0.18em; text-decoration-thickness: 2px; }
  .hero-title {
    margin: 0;
    font-size: clamp(30px, 3vw, 40px);
    font-weight: 700;
    line-height: 1.15;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    column-gap: 0.45em;
    row-gap: 4px;
  }
  .hero-brand { white-space: nowrap; }
  .hero-sep { width: 3px; height: 1.05em; background: var(--g-orange); border-radius: 2px; }
  /* All words share one grid cell, so the line is as wide as the longest word and never jumps. */
  .hero-words { display: inline-grid; white-space: nowrap; color: var(--g-orange); }
  .hero-word {
    grid-area: 1 / 1;
    opacity: 0;
    transform: translateY(0.55em);
    filter: blur(4px);
    transition: opacity 0.6s ease, transform 0.6s cubic-bezier(0.22, 1, 0.36, 1), filter 0.6s ease;
  }
  .hero-word.is-active { opacity: 1; transform: none; filter: none; transition-delay: 0.15s; }
  .hero-word.is-leaving { opacity: 0; transform: translateY(-0.55em); filter: blur(4px); transition-delay: 0s; }
  .hero-text {
    max-width: 560px;
    margin: clamp(16px, 1.6vw, 24px) 0 0;
    font-size: clamp(16px, 1.3vw, 20px);
    line-height: 1.45;
    font-weight: 500;
    color: rgba(255, 255, 255, 0.9);
  }
  .hero-dots { display: flex; gap: 8px; margin-top: clamp(24px, 2.6vw, 40px); }
  .hero-dot {
    width: 28px;
    height: 3px;
    border-radius: 2px;
    background: rgba(255, 255, 255, 0.35);
    transition: background 0.4s ease, width 0.4s ease;
  }
  .hero-dot.is-active { width: 44px; background: var(--g-orange); }
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }
  @media (prefers-reduced-motion: reduce) {
    .hero-bg, .hero-bg.is-active { transform: none; transition: opacity 0.6s ease; }
    .hero-word, .hero-word.is-leaving { transform: none; filter: none; }
  }

  /* Who we are */
  .who-head { text-align: center; max-width: 1140px; margin: 0 auto 48px; }
  .who-eyebrow {
    margin: 0 0 14px;
    font-size: clamp(11px, 0.85vw, 14px);
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: #444;
  }
  .who-text {
    margin: 10px 0 0;
    color: var(--g-text);
    font-size: clamp(15px, 1.2vw, 19px);
    font-weight: 500;
    line-height: 1.4;
  }
  .tile-grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(7, 1fr);
    gap: 14px;
  }
  .tile { aspect-ratio: 1; display: grid; place-items: center; background: #fff; }
  .tile img { max-width: 80%; max-height: 80%; object-fit: contain; }
  .tile--photo { overflow: hidden; background: #222; }
  .tile--photo { position: relative; transition: box-shadow 0.4s ease; }
  .tile--photo img {
    width: 100%; height: 100%; max-width: none; max-height: none; object-fit: cover;
    filter: grayscale(1);
    transition: transform 0.9s cubic-bezier(0.2, 0.7, 0.2, 1), filter 0.4s ease;
  }
  /* Soft vignette, like an old print. */
  .tile--photo::after {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    box-shadow: inset 0 0 40px rgba(0, 0, 0, 0.35);
    transition: box-shadow 0.4s ease;
  }
  /* White tint so the photos sit back behind the heading; it lifts on hover. */
  .tile--photo::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    background: rgba(255, 255, 255, 0.45);
    transition: background-color 0.4s ease;
  }
  .tile--photo:hover::before { background: rgba(255, 255, 255, 0.1); }
  .tile--photo:hover { box-shadow: 0 14px 30px rgba(0, 0, 0, 0.22); z-index: 1; }
  .tile--photo:hover img { transform: scale(1.08); filter: grayscale(1) contrast(1.08); }
  .tile--photo:hover::after { box-shadow: inset 0 0 0 rgba(0, 0, 0, 0); }

  /* "Developing" effect: each photo starts washed out and comes into focus, one after another,
     when the grid scrolls into view. Only applies once the script above adds .who-anim, so the
     photos stay visible without JavaScript, and is skipped for reduced motion. */
  :global(.who-anim) .tile--photo img {
    filter: grayscale(1) brightness(1.9) contrast(0.6) blur(6px);
    transform: scale(1.12);
    transition:
      filter 1.4s ease calc(var(--i) * 110ms),
      transform 1.6s cubic-bezier(0.2, 0.7, 0.2, 1) calc(var(--i) * 110ms);
  }
  :global(.who-prep) .tile--photo img { transition: none !important; }
  :global(.who-anim.is-developed) .tile--photo img { filter: grayscale(1); transform: none; }
  :global(.who-anim.is-developed.is-done) .tile--photo img {
    transition: transform 0.9s cubic-bezier(0.2, 0.7, 0.2, 1), filter 0.4s ease;
  }
  :global(.who-anim.is-developed) .tile--photo:hover img { transform: scale(1.08); filter: grayscale(1) contrast(1.08); }
  @media (prefers-reduced-motion: reduce) {
    .tile--photo img, .tile--photo::after { transition: none !important; }
    .tile--photo:hover img { transform: none; }
  }
  .tile--empty {
    background-color: #f6f6f6;
    background-image:
      linear-gradient(45deg, #ececec 25%, transparent 25%, transparent 75%, #ececec 75%),
      linear-gradient(45deg, #ececec 25%, transparent 25%, transparent 75%, #ececec 75%);
    background-size: 16px 16px;
    background-position: 0 0, 8px 8px;
  }

  /* Businesses */
  .biz-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: clamp(20px, 2.2vw, 36px);
  }
  .biz-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    background: #fff;
    color: var(--g-ink);
    text-decoration: none;
    padding: 40px clamp(20px, 5vw, 72px) 40px;
    box-shadow: 0 10px 40px rgba(0, 0, 0, 0.08);
    transition: transform 0.2s, box-shadow 0.2s;
  }
  /* All cards react to hover, linked or not */
  .biz-card:hover { transform: translateY(-4px); box-shadow: 0 18px 48px rgba(6, 97, 169, 0.18); }
  .biz-logo {
    width: 100%;
    height: 108px;
    display: grid;
    place-items: center;
    border-bottom: 1px solid #c8c8c8;
    margin-bottom: 30px;
  }
