---
import GroupLayout from '../layouts/GroupLayout.astro';
import { hero, ceo, leaders } from '../data/management';
import LeaderCard from '../components/group/LeaderCard.astro';
// Split the quote so words wrapped in **...** render bold.
// The first sentence ("Celebrating 21 years ...") types itself in when the section scrolls into view.
// Only the opening words (bold) type in; the rest of the quote shows normally.
const typePhrase = 'Celebrating 21 years of Vritti';
const firstStop = ceo.quote.startsWith(typePhrase) ? typePhrase.length : 0;
const typeLine = ceo.quote.slice(0, firstStop);
const quoteParts = ceo.quote.slice(firstStop).split(/\*\*(.+?)\*\*/);
---
<GroupLayout title="Meet our Management – Vritti Group" description={hero.text}>
  <!-- Hero (placeholder banner until the carousel image is ready) -->
  <section class="m-hero" style={`background-image: url('${hero.image}')`}>
    <div class="g-container">
      <h1>{hero.title}</h1>
      <p>{hero.text}</p>
    </div>
  </section>

  <!-- CEO words -->
  <section class="ceo" aria-labelledby="ceo-heading">
    <div class="ceo-photo">
      <img src={ceo.photo} alt={`${ceo.name}, ${ceo.title}`} width="786" height="817" loading="lazy" />
    </div>
    <div class="ceo-copy">
      <p class="ceo-eyebrow" id="ceo-heading">{ceo.eyebrow}</p>
      <blockquote><span class="q-mark q-open" aria-hidden="true">“</span>{typeLine && <strong class="ceo-type" data-type={typeLine}><span class="ceo-typed">{typeLine}</span><span class="ceo-ghost" aria-hidden="true"></span></strong>}<span class="ceo-rest">{quoteParts.map((part, i) => (i % 2 ? <strong>{part}</strong> : part))}</span><span class="q-mark q-close" aria-hidden="true">”</span></blockquote>
      <div class="ceo-foot">
        <div>
          <p class="ceo-name">{ceo.name}</p>
          <p class="ceo-title">{ceo.title}</p>
        </div>
        {ceo.readMoreHref && <a class="ceo-more" href={ceo.readMoreHref}>Know him</a>}
      </div>
    </div>
  </section>

  <!-- Leaders -->
  <section class="g-section leaders" aria-label="Management team">
    <div class="g-container">
      <ul class="leader-grid">
        {leaders.map((l) => (
          <li class="leader">
            <LeaderCard {...l} heading="h2" size="lg" />
          </li>
        ))}
      </ul>
    </div>
  </section>
</GroupLayout>

<style>
  .m-hero {
    background-color: #0a3f78;
    background-size: cover;
    background-position: center;
    color: #fff;
    min-height: clamp(260px, 32vw, 560px);
    display: flex;
    align-items: center;
    text-align: center;
  }
  .m-hero h1 {
    margin: 0;
    font-size: var(--fs-page-title);
    font-weight: var(--fw-heading);
    line-height: 1.1;
    text-shadow: 0 2px 18px rgba(0, 0, 0, 0.25);
  }
  .m-hero p {
    margin: 14px 0 0;
    font-size: clamp(14px, 1.1vw, 17px);
    font-weight: var(--fw-text);
    opacity: 0.9;
  }

  .ceo {
    display: grid;
    grid-template-columns: 45.5% 1fr;
    background: var(--g-blue);
    color: #fff;
  }
  .ceo-photo img { display: block; width: 100%; height: 100%; object-fit: cover; }
  .ceo-copy {
    padding: clamp(40px, 6.5vw, 112px) clamp(24px, 5vw, 92px);
    display: flex;
    flex-direction: column;
    justify-content: center;
  }
  .ceo-eyebrow {
    margin: 0 0 clamp(16px, 2vw, 32px);
    color: var(--g-orange);
    font-size: clamp(13px, 1.2vw, 18px);
    font-weight: 500;
    letter-spacing: 0.22em;
    text-transform: uppercase;
  }
  .ceo blockquote {
    margin: 0;
    font-size: clamp(17px, 1.5vw, 24px);
    font-weight: 400;
    line-height: 1.35;
  }
  .ceo blockquote strong { font-weight: 600; }
  /* Typing effect on the first line. The untyped part stays in place (invisible) so nothing jumps. */
  .ceo-ghost { visibility: hidden; }
  .ceo.is-typing .ceo-typed::after { content: ''; display: inline-block; width: 2px; height: 1em; margin: 0 -2px 0 0; vertical-align: -0.12em; background: var(--g-orange); animation: ceo-caret 0.7s steps(1) infinite; }
  @keyframes ceo-caret { 50% { opacity: 0; } }
  .q-mark {
    font-size: 2.6em;
    font-weight: 600;
    line-height: 0;
    vertical-align: -0.38em;
  }
  .q-open { margin-right: 0.06em; }
  .q-close { margin-left: 0.04em; }
  .ceo-foot {
    margin-top: clamp(28px, 3.2vw, 56px);
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 24px;
  }
  .ceo-name {
    margin: 0;
    font-size: clamp(15px, 1.2vw, 19px);
    font-weight: 600;
    text-transform: uppercase;
  }
  .ceo-name::after {
    content: '';
    display: block;
    width: 50px;
    height: 2px;
    margin: 10px 0;
    background: #e8747c;
  }
  .ceo-title { margin: 0; font-size: clamp(13px, 1vw, 16px); }
  .ceo-more {
    flex: none;
    color: #fff;
    border: 1px solid rgba(255, 255, 255, 0.7);
    border-radius: 999px;
    padding: 9px 26px;
    font-size: 14px;
    text-decoration: none;
  }
  .ceo-more:hover { background: #fff; color: var(--g-blue); }

  .leader-grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: clamp(20px, 3vw, 56px);
  }
  .leader { display: flex; }

  @media (max-width: 1100px) {
    .leader-grid { grid-template-columns: repeat(2, 1fr); max-width: 760px; margin: 0 auto; }
  }
  @media (max-width: 760px) {
    .ceo { grid-template-columns: 1fr; }
    .ceo-photo img { aspect-ratio: 4 / 3; height: auto; object-position: 40% 30%; }
    .ceo-intro {
    margin: clamp(20px, 2.2vw, 36px) 0 0;
    font-size: clamp(14px, 1.1vw, 18px);
    line-height: 1.6;
    opacity: 0.9;
  }
  .ceo-foot { flex-wrap: wrap; }
  }
  @media (max-width: 520px) {
    .leader-grid { grid-template-columns: 1fr; max-width: 360px; }
  }
</style>

<script>
  const section = document.querySelector<HTMLElement>('.ceo');
  const wrap = section?.querySelector<HTMLElement>('.ceo-type');
  if (section && wrap && !window.matchMedia('(prefers-reduced-motion: reduce)').matches && 'IntersectionObserver' in window) {
    const line = wrap.dataset.type || '';
    const typed = wrap.querySelector<HTMLElement>('.ceo-typed')!;
    const ghost = wrap.querySelector<HTMLElement>('.ceo-ghost')!;
    typed.textContent = '';
    ghost.textContent = line;
    const io = new IntersectionObserver((entries) => {
      if (!entries.some((e) => e.isIntersecting)) return;
      io.disconnect();
      section.classList.add('is-typing');
      let k = 0;
      const t = window.setInterval(() => {
        k += 1;
        typed.textContent = line.slice(0, k);
        ghost.textContent = line.slice(k);
        if (k >= line.length) {
          window.clearInterval(t);
          window.setTimeout(() => section.classList.remove('is-typing'), 1200);
        }
      }, 90);
    }, { threshold: 0.4 });
    io.observe(section);
  }
</script>
