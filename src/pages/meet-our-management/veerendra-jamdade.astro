---
import GroupLayout from '../../layouts/GroupLayout.astro';
import { ceoProfile as p } from '../../data/management';
---
<GroupLayout
  title={`${p.name} – ${p.title} – Vritti Group`}
  description={p.bio[0]}
  footerStrip={false}
>
  <section class="g-section profile" aria-labelledby="profile-name">
    <div class="g-container">
      <div class="profile-top">
        <div class="profile-photo">
          <img src={p.photo} alt={`${p.name}, ${p.title}`} width="786" height="817" />
          <ul class="profile-socials" aria-label={`${p.name} on social media`}>
            {p.socials.map((s) => (
              <li>
                <a href={s.href} target="_blank" rel="noopener" aria-label={s.label} title={s.label}>
                  {s.icon === 'linkedin' ? (
                    <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path fill="currentColor" d="M4.98 3.5a2.5 2.5 0 1 1 0 5 2.5 2.5 0 0 1 0-5zM3 9.75h4V21H3zM9.5 9.75h3.8v1.6h.05c.53-1 1.83-2.05 3.77-2.05 4.03 0 4.78 2.65 4.78 6.1V21h-4v-4.9c0-1.17-.02-2.68-1.63-2.68-1.64 0-1.89 1.28-1.89 2.6V21h-4z" /></svg>
                  ) : (
                    <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path fill="currentColor" d="M18.24 2.25h3.31l-7.23 8.26 8.5 11.24h-6.66l-5.21-6.82-5.97 6.82H1.67l7.73-8.84L1.25 2.25h6.83l4.71 6.23zm-1.16 17.52h1.83L7.08 4.13H5.12z" /></svg>
                  )}
                </a>
              </li>
            ))}
          </ul>
        </div>
        <div class="profile-copy">
          <h1 id="profile-name">{p.name}</h1>
          <p class="profile-title">{p.title}</p>
          <div class="profile-bio">
            {p.bio.map((para) => <p>{para}</p>)}
          </div>
        </div>
      </div>


      <div class="headlines">
        <h2 class="headlines-title">Making Headlines.</h2>
        <ul class="headline-grid">
          {p.headlines.map((h) => (
            <li class="headline">
              <a href={h.href}>
                <div class="headline-thumb">
                  {h.thumbnail ? (
                    <img src={h.thumbnail} alt="" loading="lazy" />
                  ) : (
                    <div class="thumb-placeholder" aria-hidden="true">
                      <div class="thumb-text">
                        <strong>Veerendra<br />Jamdade</strong>
                        <span>Founder &amp; CEO<br />Vritti Solutions</span>
                      </div>
                      <img src={p.photo} alt="" loading="lazy" />
                    </div>
                  )}
                  <span class="play" aria-hidden="true">
                    <svg viewBox="0 0 24 24" width="22" height="22"><path fill="currentColor" d="M8 5v14l11-7z" /></svg>
                  </span>
                </div>
                <p>{h.caption}</p>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>
</GroupLayout>

<style>
  .profile-top {
    display: grid;
    grid-template-columns: minmax(0, 46%) 1fr;
    gap: clamp(24px, 3.5vw, 48px);
    align-items: start;
  }
  .profile-photo img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 786 / 817;
    object-fit: cover;
  }
  .profile-copy h1 {
    margin: 0;
    color: var(--g-ink);
    font-size: clamp(22px, 2.4vw, 36px);
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    line-height: 1.15;
  }
  .profile-title {
    margin: 6px 0 0;
    color: var(--g-ink);
    font-size: clamp(14px, 1.2vw, 18px);
    font-weight: 500;
  }
  .profile-bio {
    margin-top: clamp(20px, 2.4vw, 32px);
    color: #111;
    font-size: clamp(16px, 1.2vw, 18px);
    font-weight: 500;
    line-height: 1.7;
  }
  .profile-bio p { margin: 0 0 1.1em; }
  .profile-socials {
    list-style: none;
    margin: 16px 0 0;
    padding: 0;
    display: flex;
    gap: 12px;
  }
  .profile-socials a {
    display: grid;
    place-items: center;
    width: 42px;
    height: 42px;
    border-radius: 50%;
    background: var(--g-blue);
    color: #fff;
    transition: background 0.2s;
  }
  .profile-socials a:hover,
  .profile-socials a:focus-visible { background: var(--g-orange); }

  .headlines { margin-top: clamp(56px, 6vw, 96px); }
  .headlines-title {
    margin: 0 0 24px;
    color: var(--g-blue);
    font-size: clamp(22px, 2vw, 32px);
    font-weight: 700;
    text-transform: uppercase;
  }
  .headline-grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 32px;
    max-width: 1000px;
  }
  .headline a { color: var(--g-ink); text-decoration: none; display: block; }
  .headline p { margin: 10px 0 0; font-size: 13px; line-height: 1.5; color: var(--g-text); }
  .headline a:hover p { color: var(--g-blue); }
  .headline-thumb {
    position: relative;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: #0b1440;
  }
  .headline-thumb > img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .thumb-placeholder {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: stretch;
    background:
      radial-gradient(circle at 20% 30%, rgba(255, 255, 255, 0.08) 0 1px, transparent 2px) 0 0 / 22px 22px,
      linear-gradient(135deg, #0b1440, #1b2a6b 60%, #0b1440);
  }
  .thumb-text {
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding-left: 12%;
    color: #fff;
    font-size: clamp(10px, 1vw, 13px);
    line-height: 1.3;
  }
  .thumb-text strong { color: #f5d63d; font-size: 1.45em; line-height: 1.1; margin-bottom: 4px; }
  .thumb-placeholder img {
    width: 48%;
    object-fit: cover;
    object-position: 45% 25%;
    -webkit-mask-image: linear-gradient(to right, transparent, #000 30%);
    mask-image: linear-gradient(to right, transparent, #000 30%);
  }
  .play {
    position: absolute;
    left: 50%;
    top: 50%;
    transform: translate(-50%, -50%);
    width: 52px;
    height: 52px;
    border-radius: 50%;
    display: grid;
    place-items: center;
    background: rgba(0, 0, 0, 0.55);
    color: #fff;
    opacity: 0;
    transition: opacity 0.2s;
  }
  .headline a:hover .play,
  .headline a:focus-visible .play { opacity: 1; }

  @media (max-width: 760px) {
    .profile-top { grid-template-columns: 1fr; }
    .profile-photo { max-width: 460px; }
  }
</style>
