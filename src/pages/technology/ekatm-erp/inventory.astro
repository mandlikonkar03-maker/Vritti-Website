---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import Faq from '../../../components/Faq.astro';
import DemoForm from '../../../components/DemoForm.astro';
import ScreenCarousel from '../../../components/ScreenCarousel.astro';
import Icon from '../../../components/Icon.astro';
import {
  inventorySlides, hero, capabilities, connected, receiving, putAway, stockIdentity,
  allocation, picking, packing, loading, physical, hhd, why, faqGroups, faqVisible,
} from '../../../data/ekatm-inventory';

const moreCount = faqGroups.length - faqVisible;
---
<BaseLayout
  title="Ekatm Inventory Management | Vritti"
  description="Ekatm Inventory connects receiving, quality, put-away, stock allocation, picking, packing, loading and physical inventory with HHD-enabled scanning and transaction-level validation."
  footerLinks={[{ label: 'Back to Technology', href: '/technology' }]}
  footerTagline="Ekatm ERP. Simple enough to start. Powerful enough to scale."
>
  <!-- HERO -->
  <section class="hero">
    <div class="container hero-grid">
      <div class="hero-copy">
        <Breadcrumbs items={[
          { label: 'Vritti', href: '/' },
          { label: 'Technology', href: '/technology' },
          { label: 'Ekatm ERP', href: '/technology/ekatm-erp' },
          { label: 'Inventory Management' },
        ]} />
        <p class="eyebrow eyebrow--dash hero-eyebrow">Inventory Management</p>
        <h1>{hero.title}<br /><span>{hero.titleAccent}</span></h1>
        <p class="hero-text">{hero.text}</p>
        <div class="hero-actions">
          <a href="#demo" class="btn btn-primary">Get Your Free Ekatm ERP Demo</a>
          <a href="#capabilities" class="btn btn-outline">Explore Features</a>
        </div>
      </div>
      <div class="hero-card">
        <ScreenCarousel slides={inventorySlides} label="Ekatm Inventory screens" eager />
      </div>
    </div>
  </section>

  <!-- CAPABILITIES -->
  <section id="capabilities" class="section section--soft">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">{capabilities.eyebrow}</p>
        <h2 class="section-title section-title--lg">{capabilities.title}{' '}<br />{capabilities.titleBreak}</h2>
        <p class="lead lead--strong">{capabilities.text}</p>
      </div>
      <ul class="grid-3">
        {capabilities.items.map((c) => (
          <li class="card row-card">
            <div class="card-head">
              <span class="icon-tile"><Icon name={c.icon} /></span>
              <h3>{c.title}</h3>
            </div>
            <p class="card-text">{c.text}</p>
            <ul class="tags">{c.tags.map((t) => <li>{t}</li>)}</ul>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- CONNECTED INVENTORY -->
  <section class="section">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">{connected.eyebrow}</p>
        <h2 class="section-title section-title--lg head-narrow">{connected.title}</h2>
        <p class="lead lead--strong">{connected.text}</p>
      </div>
      <ol class="flow flow--8">
        {connected.steps.map((s) => <li>{s}</li>)}
      </ol>
      <div class="note">
        <h3>{connected.note.title}</h3>
        <p>{connected.note.text}</p>
      </div>
    </div>
  </section>

  <!-- AI-ENABLED RECEIVING -->
  <section class="section section--soft">
    <div class="container split">
      <div>
        <div class="section-head">
          <p class="eyebrow">{receiving.eyebrow}</p>
          <h2 class="section-title section-title--lg">{receiving.title}</h2>
          <p class="lead lead--strong">{receiving.text}</p>
        </div>
        <div class="note">
          <h3>{receiving.note.title}</h3>
          <p>{receiving.note.text}</p>
        </div>
      </div>
      <div class="panel">
        <h3>{receiving.panel.title}</h3>
        <ul class="panel-list">{receiving.panel.points.map((p) => <li>{p}</li>)}</ul>
        <p class="panel-foot"><strong>{receiving.panel.footLabel}</strong> {receiving.panel.foot}</p>
      </div>
    </div>
  </section>

  <!-- WAREHOUSE & PUT-AWAY -->
  <section class="section">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">{putAway.eyebrow}</p>
        <h2 class="section-title section-title--lg head-narrow">{putAway.title}</h2>
        <p class="lead lead--strong lead-narrow">{putAway.text}</p>
      </div>
      <ul class="grid-3">
        {putAway.items.map((c) => (
          <li class="card tile-card">
            <span class="icon-tile"><Icon name={c.icon} /></span>
            <h3>{c.title}</h3>
            <p class="card-text">{c.text}</p>
          </li>
        ))}
      </ul>
      <div class="note">
        <h3>{putAway.note.title}</h3>
        <p>{putAway.note.text}</p>
      </div>
    </div>
  </section>

  <!-- STOCK IDENTITY & QUALITY -->
  <section class="section section--soft">
    <div class="container split">
      <div class="section-head">
        <p class="eyebrow">{stockIdentity.eyebrow}</p>
        <h2 class="section-title section-title--lg">{stockIdentity.title}</h2>
        {stockIdentity.paragraphs.map((p) => <p class="body-text">{p}</p>)}
      </div>
      <div class="panel">
        <h3>{stockIdentity.panel.title}</h3>
        <ul class="panel-list">{stockIdentity.panel.points.map((p) => <li>{p}</li>)}</ul>
      </div>
    </div>
  </section>

  <!-- STOCK ALLOCATION -->
  <section class="section">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">{allocation.eyebrow}</p>
        <h2 class="section-title section-title--lg head-wide">{allocation.title}</h2>
        <p class="lead lead--strong lead-narrow">{allocation.text}</p>
      </div>
      <ul class="grid-3">
        {allocation.items.map((c) => (
          <li class="card tile-card">
            <span class="icon-tile"><Icon name={c.icon} /></span>
            <h3>{c.title}</h3>
            <p class="card-text">{c.text}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- PICKING -->
  <section class="section section--soft">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">{picking.eyebrow}</p>
        <h2 class="section-title section-title--lg">{picking.title}{' '}<br />{picking.titleBreak}</h2>
        <p class="lead lead--strong">{picking.text}</p>
      </div>
      <ol class="flow flow--6 flow--solid">
        {picking.steps.map((s) => <li>{s}</li>)}
      </ol>
      <ul class="grid-3">
        {picking.items.map((c) => (
          <li class="card tile-card">
            <span class="icon-tile"><Icon name={c.icon} /></span>
            <h3>{c.title}</h3>
            <p class="card-text">{c.text}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- PACKING & PACKAGING -->
  <section class="section">
    <div class="container split split--panel-first">
      <div class="panel">
        <h3>{packing.panel.title}</h3>
        <ul class="panel-list">{packing.panel.points.map((p) => <li>{p}</li>)}</ul>
      </div>
      <div>
        <div class="section-head">
          <p class="eyebrow">{packing.eyebrow}</p>
          <h2 class="section-title section-title--lg">{packing.title}</h2>
          <p class="lead lead--strong">{packing.text}</p>
        </div>
        <div class="note">
          <h3>{packing.note.title}</h3>
          <p>{packing.note.text}</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ROUTE-AWARE LOADING -->
  <section class="section section--soft">
    <div class="container split">
      <div class="section-head">
        <p class="eyebrow">{loading.eyebrow}</p>
        <h2 class="section-title section-title--lg">{loading.title}</h2>
        {loading.paragraphs.map((p) => <p class="lead lead--strong">{p}</p>)}
      </div>
      <div class="panel">
        <h3>{loading.panel.title}</h3>
        <ul class="panel-list">{loading.panel.points.map((p) => <li>{p}</li>)}</ul>
        <p class="panel-foot"><strong>{loading.panel.footLabel}</strong> {loading.panel.foot}</p>
      </div>
    </div>
  </section>

  <!-- PHYSICAL INVENTORY & BIN ACCURACY -->
  <section class="section">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">{physical.eyebrow}</p>
        <h2 class="section-title section-title--lg head-narrow">{physical.title}</h2>
        <p class="lead lead--strong">{physical.text}</p>
      </div>
      <ul class="grid-4">
        {physical.items.map((c) => (
          <li class="card tile-card">
            <span class="icon-tile"><Icon name={c.icon} /></span>
            <h3>{c.title}</h3>
            <p class="card-text">{c.text}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- CONNECTED HHD OPERATIONS -->
  <section class="section section--soft">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">{hhd.eyebrow}</p>
        <h2 class="section-title section-title--lg head-narrow">{hhd.title}</h2>
        <p class="lead lead--strong lead-narrow">{hhd.text}</p>
      </div>
      <ul class="grid-3 grid-3--tight">
        {hhd.items.map((c) => (
          <li class="card plain-card">
            <h3>{c.title}</h3>
            <p class="card-text">{c.text}</p>
          </li>
        ))}
      </ul>
      <div class="note">
        <h3>{hhd.note.title}</h3>
        <p>{hhd.note.text}</p>
      </div>
    </div>
  </section>

  <!-- WHY EKATM INVENTORY -->
  <section class="section">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">{why.eyebrow}</p>
        <h2 class="section-title section-title--lg head-narrow">{why.title}</h2>
        <p class="lead lead--strong">{why.text}</p>
      </div>
      <ul class="grid-3">
        {why.items.map((c) => (
          <li class="card row-card">
            <div class="card-head">
              <span class="icon-tile"><Icon name={c.icon} /></span>
              <h3>{c.title}</h3>
            </div>
            <p class="card-text">{c.text}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- FAQ -->
  <section class="section section--soft">
    <div class="container faq-grid">
      <div class="faq-intro">
        <h2 class="section-title">Frequently<br />asked questions.</h2>
        <p class="eyebrow eyebrow--muted">About Ekatm ERP</p>
        <p class="faq-text">Want to see how Ekatm fits your business processes? Ask for a demo and we will walk you through it.</p>
        <a href="#demo" class="btn btn-primary">Get Your Free Ekatm ERP Demo</a>
      </div>
      <div class="faq-groups" data-faq>
        <p class="eyebrow faq-label">The Platform</p>
        {faqGroups.map((g, i) => (
          <details class="faq-group" name="faq-group" open={i === 0} hidden={i >= faqVisible} data-more={i >= faqVisible ? '' : undefined}>
            <summary>
              <span>{i + 1}. {g.title}</span>
              <span class="group-icon" aria-hidden="true">
                <svg width="12" height="12" viewBox="0 0 12 12"><path d="m3 4.5 3 3 3-3" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </span>
            </summary>
            <div class="faq-group-body">
              <Faq items={g.items} name={`faq-${i}`} />
            </div>
          </details>
        ))}
        {moreCount > 0 && (
          <div class="faq-more">
            <button type="button" class="btn btn-outline faq-more-btn" aria-expanded="false" data-more-label={`Read more (${moreCount} more)`}>
              <span>Read more ({moreCount} more)</span>
              <svg width="12" height="12" viewBox="0 0 12 12" aria-hidden="true"><path d="m3 4.5 3 3 3-3" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </button>
          </div>
        )}
      </div>
    </div>
  </section>

  <!-- DEMO -->
  <section id="demo" class="section demo">
    <div class="container demo-grid">
      <div class="demo-intro">
        <p class="eyebrow">See Ekatm in action</p>
        <h2 class="section-title">Get Your Free<br />Ekatm ERP Demo</h2>
        <p class="demo-text">Discover how Ekatm ERP can connect your business processes and support your operational needs.</p>
        <div class="demo-illustration">
          <img src="/images/demo-illustration.png" width="348" height="238" loading="lazy" alt="Illustration of a team working around an ERP dashboard" />
        </div>
      </div>
      <div class="demo-card">
        <DemoForm product="Ekatm ERP – Inventory" />
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  // "Read more" shows the FAQ groups past the first few; pressing again hides them.
  document.querySelectorAll<HTMLElement>('[data-faq]').forEach((root) => {
    const btn = root.querySelector<HTMLButtonElement>('.faq-more-btn');
    const extra = root.querySelectorAll<HTMLElement>('[data-more]');
    if (!btn) return;
    btn.addEventListener('click', () => {
      const open = btn.getAttribute('aria-expanded') !== 'true';
      extra.forEach((el) => { el.hidden = !open; });
      btn.setAttribute('aria-expanded', String(open));
      btn.querySelector('span')!.textContent = open ? 'Show less' : btn.dataset.moreLabel ?? 'Read more';
    });
  });
</script>

<style>
  /* HERO */
  .hero { padding: 36px 0 var(--section-y); }
  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 520px);
    gap: 40px;
    align-items: start;
  }
  .hero-eyebrow { margin: 34px 0 14px; }
  .hero h1 { font-size: clamp(28px, 2.7vw, 38px); line-height: 1.18; }
  .hero h1 span { color: var(--blue); }
  .hero-text { color: var(--text); font-size: 15.5px; line-height: 1.8; max-width: 470px; margin: 22px 0 28px; }
  .hero-actions { display: flex; flex-wrap: wrap; gap: 12px; }
  .hero-card { margin-top: 30px; }

  /* SHARED */
  .section-head { margin-bottom: 36px; }
  .section-head .lead { max-width: 820px; }
  .section-head p.lead--strong { font-weight: 500; color: #3d5466; line-height: 1.7; }
  .head-narrow { max-width: 620px; }
  .head-wide { max-width: 720px; }
  .section-head .lead-narrow { max-width: 580px; }
  .body-text { color: var(--text); font-size: 14px; line-height: 1.85; margin: 18px 0 0; max-width: 470px; }
  .icon-tile {
    flex: none;
    width: 36px; height: 36px; border-radius: 8px;
    background: #e8f2fa; color: var(--blue);
    display: grid; place-items: center;
  }
  .grid-3, .grid-4 {
    list-style: none; padding: 0; margin: 0;
    display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 16px;
  }
  .grid-4 { grid-template-columns: repeat(4, minmax(0, 1fr)); }
  .card {
    background: #fff;
    border: 1px solid var(--line);
    border-radius: 12px;
    padding: 16px 16px 20px;
  }
  .card h3 { font-size: 14.5px; font-weight: 600; line-height: 1.4; margin: 0; }
  .card-head { display: flex; align-items: center; gap: 12px; }
  .card-text { margin: 0; color: var(--text); font-size: 13px; line-height: 1.6; }
  .row-card .card-head { margin-bottom: 18px; }
  .tile-card h3 { margin: 16px 0 8px; }
  .plain-card h3 { margin: 0 0 10px; }
  .tags { list-style: none; padding: 0; margin: 18px 0 0; display: flex; flex-wrap: wrap; gap: 8px; }
  .tags li {
    background: #e3f0fa; color: var(--blue);
    border-radius: 6px; padding: 4px 9px;
    font-size: 12px; font-weight: 500;
  }

  /* NOTE (left blue border) */
  .note {
    margin-top: 24px;
    background: #fff;
    border: 1px solid var(--line);
    border-left: 4px solid var(--blue);
    border-radius: 12px;
    padding: 16px 18px 18px;
  }
  .note h3 { font-size: 14.5px; font-weight: 600; margin: 0 0 6px; }
  .note p { margin: 0; color: var(--text); font-size: 13px; line-height: 1.6; max-width: 740px; }

  /* FLOW CHIPS */
  .flow {
    list-style: none; padding: 0; margin: 0 0 32px;
    display: grid; gap: 30px;
  }
  .flow--8 { grid-template-columns: repeat(8, minmax(0, 1fr)); }
  .flow--6 { grid-template-columns: repeat(6, minmax(0, 1fr)); gap: 44px; }
  .flow li {
    position: relative;
    background: #e8f1f8; color: var(--navy);
    border: 1px solid #d6e5f1; border-radius: 6px;
    padding: 9px 6px; text-align: center;
    font-size: 13px; font-weight: 600;
  }
  .flow li + li::before {
    content: '→'; position: absolute; left: -24px; top: 50%; transform: translateY(-50%);
    color: var(--blue); font-size: 18px; font-weight: 400; line-height: 1;
  }
  .flow--6 li + li::before { left: -31px; }
  .flow--solid li { background: var(--blue); border-color: var(--blue); color: #fff; font-weight: 500; }

  /* TWO-COLUMN WITH GRADIENT PANEL */
  .split { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 390px); gap: 64px; align-items: start; }
  .split .section-head { margin-bottom: 0; }
  .split .note { max-width: 432px; }
  .split--panel-first { grid-template-columns: minmax(0, 390px) minmax(0, 1fr); gap: 28px; }
  .panel {
    border-radius: 14px;
    background: linear-gradient(135deg, #0b3d63 0%, #1f78b4 55%, #3aa7ec 100%);
    color: #fff;
    padding: 22px 18px 22px;
  }
  .panel h3 { color: #fff; font-size: clamp(19px, 1.7vw, 22px); font-weight: 500; margin: 0 0 18px; }
  .panel-list { list-style: none; padding: 0; margin: 0; display: grid; gap: 8px; }
  .panel-list li { position: relative; padding-left: 12px; font-size: 13px; line-height: 1.4; }
  .panel-list li::before {
    content: ''; position: absolute; left: 0; top: 0.5em;
    width: 5px; height: 5px; border-radius: 50%; background: #fff;
  }
  .panel-foot { margin: 16px 0 0; font-size: 13px; line-height: 1.45; }
  .panel-foot strong { font-weight: 600; }

  /* FAQ */
  .faq-grid { display: grid; grid-template-columns: 300px minmax(0, 1fr); gap: 72px; align-items: start; }
  .faq-intro { padding-top: 10px; }
  .faq-intro .eyebrow { margin: 14px 0 0; }
  .faq-text { color: var(--text); font-size: 14px; line-height: 1.75; margin: 18px 0 22px; max-width: 300px; }
  .faq-label { margin: 0 0 6px 4px; font-weight: 600; }
  .faq-group { border-bottom: 1px solid #d6e2ec; }
  .faq-group[hidden] { display: none; }
  .faq-group > summary {
    list-style: none;
    display: flex; justify-content: space-between; align-items: center; gap: 20px;
    padding: 16px 4px 16px 8px;
    font-size: 15px; font-weight: 500; color: var(--blue);
    cursor: pointer;
  }
  .faq-group > summary::-webkit-details-marker { display: none; }
  .group-icon {
    flex: none; width: 26px; height: 26px; border-radius: 50%;
    background: var(--blue); color: #fff;
    display: grid; place-items: center;
    transition: transform 0.2s;
  }
  .faq-group[open] .group-icon { transform: rotate(180deg); }
  .faq-group-body { padding: 0 0 8px; }
  .faq-group-body :global(.faq-item:last-child) { border-bottom: 0; }
  .faq-group-body :global(.faq-item summary) { font-size: 15px; }
  .faq-group-body :global(.faq-item[open] summary) { color: var(--navy); }
  .faq-more { display: flex; justify-content: center; margin-top: 28px; }
  .faq-more-btn { display: inline-flex; align-items: center; gap: 10px; }
  .faq-more-btn svg { transition: transform 0.2s; }
  .faq-more-btn[aria-expanded='true'] svg { transform: rotate(180deg); }

  /* DEMO */
  .demo-grid { display: grid; grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.4fr); gap: 60px; align-items: start; }
  .demo-intro { padding-left: 16px; }
  .demo-intro .eyebrow { margin: 0 0 14px; font-weight: 600; }
  .demo-text { color: var(--text); font-size: 15px; font-weight: var(--fw-text); line-height: 1.75; margin: 24px 0 26px; max-width: 390px; }
  .demo-illustration {
    width: 100%; max-width: 306px;
    border: 1px solid var(--line); border-radius: 10px;
    padding: 10px; background: #fff;
  }
  .demo-illustration img { display: block; width: 100%; }
  .demo-card {
    border: 1px solid var(--line);
    border-radius: 16px;
    background: #fff;
    box-shadow: var(--shadow-card);
    padding: 34px 28px 30px;
  }


  /* RESPONSIVE */
  @media (max-width: 1100px) {
    .flow--8 { grid-template-columns: repeat(4, minmax(0, 1fr)); row-gap: 14px; }
    .flow--8 li:nth-child(5)::before { display: none; }
    .grid-4 { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 1024px) {
    .hero-grid, .faq-grid, .demo-grid, .split, .split--panel-first { grid-template-columns: 1fr; }
    .split { gap: 32px; }
    .split .note { max-width: none; }
    .hero-card { max-width: 640px; margin-top: 8px; }
    .grid-3 { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .flow--6 { grid-template-columns: repeat(3, minmax(0, 1fr)); row-gap: 14px; }
    .flow--6 li:nth-child(4)::before { display: none; }
    .demo-intro { padding-left: 0; }
    .faq-text { max-width: 520px; }
    .faq-grid, .demo-grid { gap: 40px; }
    .panel { max-width: 560px; }
  }
  @media (max-width: 640px) {
    .hero { padding: 24px 0 var(--section-y); }
    .hero-eyebrow { margin-top: 24px; }
    .hero-text { font-size: 16px; }
    .hero-actions .btn { flex: 1 1 100%; }
    .grid-3, .grid-4 { grid-template-columns: 1fr; gap: 12px; }
    .section-head { margin-bottom: 26px; }
    .flow, .flow--6 { grid-template-columns: 1fr 1fr; gap: 12px 28px; }
    .flow--8 li:nth-child(5)::before, .flow--6 li:nth-child(4)::before { display: block; }
    .flow li:nth-child(odd)::before { display: none !important; }
