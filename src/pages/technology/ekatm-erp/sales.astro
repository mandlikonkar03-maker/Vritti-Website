---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import Faq from '../../../components/Faq.astro';
import DemoForm from '../../../components/DemoForm.astro';
import ScreenCarousel from '../../../components/ScreenCarousel.astro';
import Icon from '../../../components/Icon.astro';
import {
  salesSlides, hero, intro, capabilities, journey, customerControl, quotation,
  orderControl, continuity, beyond, konnect, faqGroups, faqVisible,
} from '../../../data/ekatm-sales';

const num = (i: number) => String(i + 1).padStart(2, '0');
const moreCount = faqGroups.length - faqVisible;
---
<BaseLayout
  title="Ekatm Sales Management | Vritti"
  description="Ekatm Sales connects customers, quotations, controlled pricing, Sales Orders, fulfilment, invoicing and revenue in one connected Sales process."
  footerLinks={[{ label: 'Back to Technology', href: '/technology' }]}
  footerTagline="Ekatm ERP. Simple enough to start. Powerful enough to scale."
>
  <!-- HERO -->
  <section class="hero">
    <div class="container hero-grid">
      <div class="hero-copy">
        <Breadcrumbs items={[
          { label: 'Vritti', href: '/' },
          { label: 'Technology', href: '/technology' },
          { label: 'Ekatm ERP', href: '/technology/ekatm-erp' },
          { label: 'Sales Management' },
        ]} />
        <p class="eyebrow eyebrow--dash hero-eyebrow">Sales Management</p>
        <h1>{hero.title}<br /><span>{hero.titleAccent}</span></h1>
        <p class="hero-text">{hero.text}</p>
        <div class="hero-actions">
          <a href="#demo" class="btn btn-primary">Get Your Free Ekatm ERP Demo</a>
          <a href="#capabilities" class="btn btn-outline">Explore Features</a>
        </div>
      </div>
      <div class="hero-card">
        <ScreenCarousel slides={salesSlides} label="Ekatm Sales screens" eager />
      </div>
    </div>
  </section>

  <!-- INTRO -->
  <section class="intro">
    <div class="container">
      <p class="intro-text"><strong>{intro.lead}</strong> {intro.text}</p>
    </div>
  </section>

  <!-- CAPABILITIES -->
  <section id="capabilities" class="section section--soft">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">{capabilities.eyebrow}</p>
        <h2 class="section-title section-title--lg">{capabilities.title}<br />{capabilities.titleBreak}</h2>
        <p class="lead lead--strong">{capabilities.text}</p>
      </div>
      <ul class="grid-3">
        {capabilities.items.map((c) => (
          <li class="card tile-card">
            <span class="icon-tile icon-tile--lg"><Icon name={c.icon} /></span>
            <h3>{c.title}</h3>
            <p class="card-text">{c.text}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- ORDER TO CASH JOURNEY -->
  <section class="section journey">
    <div class="container">
      <div class="section-head section-head--center">
        <p class="journey-badge"><span>{journey.badge}</span></p>
        <h2 class="section-title section-title--lg">{journey.title}</h2>
        <p class="lead">{journey.text}</p>
      </div>
      <ol class="journey-steps">
        {journey.steps.map((s, i) => (
          <li class="journey-step">
            <span class="journey-num">{num(i)}</span>
            <img src={`/images/ekatm-sales/${s.image}.png`} width="128" height="128" loading="lazy" alt="" />
            <h3>{s.title}</h3>
            <p>{s.text}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- CUSTOMER & COMMERCIAL CONTROL -->
  <section class="section section--soft">
    <div class="container">
      <div class="section-head">
        <h2 class="section-title section-title--lg">{customerControl.title}</h2>
      </div>
      <ul class="grid-2">
        {customerControl.items.map((c) => (
          <li class="card list-card">
            <div class="card-head">
              <span class="icon-tile icon-tile--lg"><Icon name={c.icon} /></span>
              <h3>{c.title}</h3>
            </div>
            <ul class="points">{c.points.map((p) => <li>{p}</li>)}</ul>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- QUOTATION MANAGEMENT -->
  <section class="section">
    <div class="container">
      <div class="section-head">
        <h2 class="section-title section-title--lg">{quotation.title}</h2>
        <p class="lead lead--strong quote-lead">{quotation.text}</p>
      </div>
      <ul class="grid-2 quote-grid">
        {quotation.items.map((c) => (
          <li class="quote-card">
            <h3>{c.title}</h3>
            <p>{c.text}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- SALES ORDER CONTROL -->
  <section class="section section--soft">
    <div class="container">
      <div class="section-head">
        <h2 class="section-title section-title--lg">{orderControl.title}</h2>
      </div>
      <ul class="grid-3">
        {orderControl.items.map((c) => (
          <li class="card tile-card">
            <span class="icon-tile icon-tile--lg"><Icon name={c.icon} /></span>
            <h3>{c.title}</h3>
            <p class="card-text">{c.text}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- CONTRACTS & RETURNS -->
  <section class="section">
    <div class="container">
      <div class="section-head">
        <h2 class="section-title section-title--lg">{continuity.title}</h2>
      </div>
      <ul class="grid-2">
        {continuity.items.map((c) => (
          <li class="card list-card">
            <div class="card-head">
              <span class="icon-tile icon-tile--lg"><Icon name={c.icon} /></span>
              <h3>{c.title}</h3>
            </div>
            <p class="card-text">{c.text}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- BEYOND THE SALES ORDER -->
  <section class="section section--soft">
    <div class="container">
      <div class="section-head">
        <h2 class="section-title section-title--lg">{beyond.title}</h2>
      </div>
      <ul class="grid-3">
        {beyond.items.map((c) => (
          <li class="card tile-card">
            <span class="icon-tile icon-tile--lg"><Icon name={c.icon} /></span>
            <h3>{c.title}</h3>
            <p class="card-text">{c.text}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- EKATMKONNECT -->
  <section class="section">
    <div class="container">
      <div class="section-head section-head--center">
        <h2 class="section-title section-title--lg">{konnect.title}</h2>
        <p class="lead konnect-lead">{konnect.text}</p>
      </div>
      <div class="card konnect-box">
        <h3>{konnect.boxTitle}</h3>
        <ul class="dots">{konnect.points.map((p) => <li>{p}</li>)}</ul>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="section section--soft">
    <div class="container faq-grid">
      <div class="faq-intro">
        <h2 class="section-title">Frequently<br />asked questions.</h2>
        <p class="eyebrow eyebrow--muted">About Ekatm ERP</p>
        <p class="faq-text">Want to see how Ekatm fits your business processes? Ask for a demo and we will walk you through it.</p>
        <a href="#demo" class="btn btn-primary">Get Your Free Ekatm ERP Demo</a>
      </div>
      <div class="faq-groups" data-faq>
        <p class="eyebrow faq-label">The Platform</p>
        {faqGroups.map((g, i) => (
          <details class="faq-group" name="faq-group" open={i === 0} hidden={i >= faqVisible} data-more={i >= faqVisible ? '' : undefined}>
            <summary>
              <span>{i + 1}. {g.title}</span>
              <span class="group-icon" aria-hidden="true">
                <svg width="12" height="12" viewBox="0 0 12 12"><path d="m3 4.5 3 3 3-3" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </span>
            </summary>
            <div class="faq-group-body">
              <Faq items={g.items} name={`faq-${i}`} />
            </div>
          </details>
        ))}
        {moreCount > 0 && (
          <div class="faq-more">
            <button type="button" class="btn btn-outline faq-more-btn" aria-expanded="false" data-more-label={`Read more (${moreCount} more)`}>
              <span>Read more ({moreCount} more)</span>
              <svg width="12" height="12" viewBox="0 0 12 12" aria-hidden="true"><path d="m3 4.5 3 3 3-3" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </button>
          </div>
        )}
      </div>
    </div>
  </section>

  <!-- DEMO -->
  <section id="demo" class="section demo">
    <div class="container demo-grid">
      <div class="demo-intro">
        <p class="eyebrow">See Ekatm in action</p>
        <h2 class="section-title">Get Your Free<br />Ekatm ERP Demo</h2>
        <p class="demo-text">Discover how Ekatm ERP can connect your business processes and support your operational needs.</p>
        <div class="demo-illustration">
          <img src="/images/demo-illustration.png" width="348" height="238" loading="lazy" alt="Illustration of a team working around an ERP dashboard" />
        </div>
      </div>
      <div class="demo-card">
        <DemoForm product="Ekatm ERP – Sales" />
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  // "Read more" shows the FAQ groups past the first few; pressing again hides them.
  document.querySelectorAll<HTMLElement>('[data-faq]').forEach((root) => {
    const btn = root.querySelector<HTMLButtonElement>('.faq-more-btn');
    const extra = root.querySelectorAll<HTMLElement>('[data-more]');
    if (!btn) return;
    btn.addEventListener('click', () => {
      const open = btn.getAttribute('aria-expanded') !== 'true';
      extra.forEach((el) => { el.hidden = !open; });
      btn.setAttribute('aria-expanded', String(open));
      btn.querySelector('span')!.textContent = open ? 'Show less' : btn.dataset.moreLabel ?? 'Read more';
    });
  });
</script>

<style>
  /* HERO */
  .hero { padding: 36px 0 var(--section-y); }
  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 520px);
    gap: 40px;
    align-items: start;
  }
  .hero-eyebrow { margin: 34px 0 14px; }
  .hero h1 { font-size: clamp(28px, 2.7vw, 38px); line-height: 1.18; }
  .hero h1 span { color: var(--blue); }
  .hero-text { color: var(--text); font-size: 15.5px; line-height: 1.8; max-width: 470px; margin: 22px 0 28px; }
  .hero-actions { display: flex; flex-wrap: wrap; gap: 12px; }
  .hero-card { margin-top: 30px; }

  /* INTRO */
  .intro { padding: 0 0 var(--section-y); }
  .intro-text {
    max-width: 1020px; margin: 0 auto; text-align: center;
    color: var(--text); font-size: var(--fs-lead); font-weight: var(--fw-text); line-height: 1.7;
  }
  .intro-text strong { color: var(--navy); font-weight: 600; }

  /* SHARED */
  .icon-tile {
    flex: none;
    width: 40px; height: 40px; border-radius: 8px;
    background: #e8f2fa; color: var(--blue);
    display: grid; place-items: center;
  }
  .icon-tile--lg { width: 46px; height: 46px; }
  .section-head .lead { max-width: 960px; }
  .section-head p.lead--strong { font-weight: 500; color: #3d5466; }
  .grid-3, .grid-2 {
    list-style: none; padding: 0; margin: 0;
    display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 20px;
  }
  .grid-2 { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .card {
    background: #fff;
    border: 1px solid var(--line);
    border-radius: 12px;
    padding: 20px 20px 24px;
  }
  .card h3 { font-size: 15px; font-weight: 600; line-height: 1.4; margin: 0; }
  .card-head { display: flex; align-items: center; gap: 12px; }
  .card-text { margin: 0; color: var(--text); font-size: 13.5px; line-height: 1.6; }
  .tile-card h3 { margin: 18px 0 10px; }

  /* ORDER TO CASH JOURNEY */
  .journey {
    position: relative; overflow: hidden;
    background: linear-gradient(180deg, #f7fbfe 0%, #fff 100%);
  }
  .journey::before {
    content: ''; position: absolute; left: -140px; top: -160px;
    width: 380px; height: 380px; border-radius: 50%;
    background: #eaf3fb; pointer-events: none;
  }
  .journey .container { position: relative; }
  .journey .lead { margin-left: auto !important; margin-right: auto !important; max-width: 760px; }
  .journey-badge {
    display: flex; align-items: center; gap: 14px;
    max-width: 820px; margin: 0 auto 18px;
  }
  .journey-badge::before, .journey-badge::after { content: ''; flex: 1; height: 1px; background: #cfe1ef; }
  .journey-badge span {
    background: #dcecf9; color: var(--blue);
    border-radius: 999px; padding: 7px 18px;
    font-size: 15px; font-weight: 500;
  }
  .journey-steps {
    list-style: none; padding: 0; margin: 0;
    display: grid; grid-template-columns: repeat(6, minmax(0, 1fr)); gap: 40px;
  }
  .journey-step {
    position: relative;
    background: #fff;
    border: 1px solid #e3eef7;
    border-radius: 16px;
    box-shadow: 0 8px 22px rgba(31, 120, 180, 0.08);
    padding: 26px 10px 20px;
    text-align: center;
  }
  .journey-step + .journey-step::before {
    content: '→'; position: absolute; left: -31px; top: 92px;
    color: var(--blue); font-size: 20px; line-height: 1;
  }
  .journey-num {
    position: absolute; top: -13px; left: 50%; transform: translateX(-50%);
    width: 28px; height: 28px; border-radius: 50%;
    background: var(--blue); color: #fff;
    display: grid; place-items: center;
    font-size: 12px; font-weight: 600;
  }
  .journey-step img { display: block; width: 100%; max-width: 112px; height: auto; margin: 0 auto 12px; }
  .journey-step h3 { font-size: 14.5px; font-weight: 600; line-height: 1.3; margin: 0 0 8px; }
  .journey-step p { margin: 0; color: var(--text); font-size: 13px; line-height: 1.5; }

  /* LIST CARDS */
  .list-card .card-head { margin-bottom: 22px; }
  .points { list-style: none; padding: 0; margin: 0; display: grid; gap: 10px; }
  .points li { position: relative; padding-left: 20px; font-size: 13.5px; color: var(--text); line-height: 1.55; }
  .points li::before { content: '·'; position: absolute; left: 6px; top: 0; font-weight: 700; }

  /* QUOTATION */
  .quote-lead { max-width: 720px !important; line-height: 1.7; }
  .quote-card {
    background: #fff;
    border: 1px solid var(--line);
    border-left: 4px solid var(--blue);
    border-radius: 12px;
    padding: 20px 20px 22px;
  }
  .quote-card h3 { font-size: 15px; font-weight: 600; margin: 0 0 8px; }
  .quote-card p { margin: 0; color: var(--text); font-size: 13.5px; line-height: 1.6; }

  /* DOT LIST */
  .dots { list-style: none; padding: 0; margin: 0; display: grid; gap: 10px; }
  .dots li { position: relative; padding-left: 22px; font-size: 13.5px; color: var(--text); line-height: 1.5; }
  .dots li::before {
    content: ''; position: absolute; left: 6px; top: 0.55em;
    width: 6px; height: 6px; border-radius: 50%; background: var(--blue);
  }

  /* EKATMKONNECT */
  .konnect-lead { max-width: 980px !important; margin-left: auto !important; margin-right: auto !important; }
  .konnect-box { padding: 24px 20px 26px; }
  .konnect-box h3 { font-size: clamp(17px, 1.5vw, 20px); margin: 0 0 22px; }

  /* FAQ */
  .faq-grid { display: grid; grid-template-columns: 300px minmax(0, 1fr); gap: 72px; align-items: start; }
  .faq-intro { padding-top: 10px; }
  .faq-intro .eyebrow { margin: 14px 0 0; }
  .faq-text { color: var(--text); font-size: 14px; line-height: 1.75; margin: 18px 0 22px; max-width: 300px; }
  .faq-label { margin: 0 0 6px 4px; font-weight: 600; }
  .faq-group { border-bottom: 1px solid #d6e2ec; }
  .faq-group[hidden] { display: none; }
  .faq-group > summary {
    list-style: none;
    display: flex; justify-content: space-between; align-items: center; gap: 20px;
    padding: 16px 4px 16px 8px;
    font-size: 15px; font-weight: 500; color: var(--blue);
    cursor: pointer;
  }
  .faq-group > summary::-webkit-details-marker { display: none; }
  .group-icon {
    flex: none; width: 26px; height: 26px; border-radius: 50%;
    background: var(--blue); color: #fff;
    display: grid; place-items: center;
    transition: transform 0.2s;
  }
  .faq-group[open] .group-icon { transform: rotate(180deg); }
  .faq-group-body { padding: 0 0 8px; }
  .faq-group-body :global(.faq-item:last-child) { border-bottom: 0; }
  .faq-group-body :global(.faq-item summary) { font-size: 15px; }
  .faq-group-body :global(.faq-item[open] summary) { color: var(--navy); }
  .faq-more { display: flex; justify-content: center; margin-top: 28px; }
  .faq-more-btn { display: inline-flex; align-items: center; gap: 10px; }
  .faq-more-btn svg { transition: transform 0.2s; }
  .faq-more-btn[aria-expanded='true'] svg { transform: rotate(180deg); }

  /* DEMO */
  .demo-grid { display: grid; grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.4fr); gap: 60px; align-items: start; }
  .demo-intro { padding-left: 16px; }
  .demo-intro .eyebrow { margin: 0 0 14px; font-weight: 600; }
  .demo-text { color: var(--text); font-size: 15px; font-weight: var(--fw-text); line-height: 1.75; margin: 24px 0 26px; max-width: 390px; }
  .demo-illustration {
    width: 100%; max-width: 306px;
    border: 1px solid var(--line); border-radius: 10px;
    padding: 10px; background: #fff;
  }
  .demo-illustration img { display: block; width: 100%; }
  .demo-card {
    border: 1px solid var(--line);
    border-radius: 16px;
    background: #fff;
    box-shadow: var(--shadow-card);
    padding: 34px 28px 30px;
  }

  /* RESPONSIVE */
  @media (max-width: 1100px) {
    .journey-steps { grid-template-columns: repeat(3, minmax(0, 1fr)); row-gap: 36px; }
    .journey-step:nth-child(4)::before { display: none; }
  }
  @media (max-width: 1024px) {
    .hero-grid, .faq-grid, .demo-grid { grid-template-columns: 1fr; }
    .hero-card { max-width: 640px; margin-top: 8px; }
    .grid-3 { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .demo-intro { padding-left: 0; }
    .faq-text { max-width: 520px; }
    .faq-grid, .demo-grid { gap: 40px; }
  }
  @media (max-width: 760px) {
    .grid-2 { grid-template-columns: 1fr; gap: 14px; }
  }
  @media (max-width: 640px) {
    .hero { padding: 24px 0 var(--section-y); }
    .hero-eyebrow { margin-top: 24px; }
    .hero-text { font-size: 16px; }
    .hero-actions .btn { flex: 1 1 100%; }
    .intro-text { text-align: left; }
    .grid-3 { grid-template-columns: 1fr; gap: 14px; }
    .journey-badge::before, .journey-badge::after { display: none; }
    .journey-badge { justify-content: center; }
    .journey-steps { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 30px 14px; }
    .journey-step + .journey-step::before { display: none; }
    .journey-step { padding: 22px 8px 16px; }
    .journey-step img { max-width: 92px; }
    .journey-step h3 { font-size: 14px; }
    .journey-step p { font-size: 12.5px; }
    .demo-card { padding: 24px 16px; }
    .section-title--lg br { display: none; }
    .faq-more-btn { width: 100%; justify-content: center; }
  }
</style>
